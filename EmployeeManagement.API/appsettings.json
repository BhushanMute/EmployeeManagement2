{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=EmployeeDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "SecretKey": "ThisIsAVerySecretKeyWithAtLeast32CharactersForJWTTokenGeneration123456789",
    "Issuer": "EmployeeAPI",
    "Audience": "EmployeeUI",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "FileUpload": {
    "MaxFileSizeMB": 10,
    "AllowedImageExtensions": [ ".jpg", ".jpeg", ".png", ".gif" ],
    "AllowedExcelExtensions": [ ".xlsx", ".xls" ],
    "StudentPhotosPath": "wwwroot/uploads/students",
    "AttendancePhotosPath": "wwwroot/uploads/attendance",
    "TempPath": "wwwroot/uploads/temp"
  }
}
