{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "EmployeeManagement.API.ExceptionMiddleware": "Information",
      "EmployeeManagement.API.Services.ErrorLogService": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=EmployeeDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "SecretKey": "ThisIsAVerySecretKeyWithAtLeast32CharactersForJWTTokenGeneration123456789",
    "Issuer": "EmployeeAPI",
    "Audience": "EmployeeUI",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "FileUpload": {
    "MaxFileSizeMB": 10,
    "AllowedImageExtensions": [ ".jpg", ".jpeg", ".png", ".gif" ],
    "AllowedExcelExtensions": [ ".xlsx", ".xls" ],
    "StudentPhotosPath": "wwwroot/uploads/students",
    "AttendancePhotosPath": "wwwroot/uploads/attendance",
    "TempPath": "wwwroot/uploads/temp"
  },
  "EmailSettings": {
    "SmtpServer": "localhost",
    "SmtpPort": 1025,
    "SenderEmail": "noreply@demo.com",
    "SenderName": "Employee Management System",
    "Username": "",
    "Password": "",
    "EnableSsl": false
  },
  "AppSettings": {
    "FrontendUrl": "https://localhost:44354"
  },
  "CompanyDetails": {
    "CompanyName": "Your Company Pvt. Ltd.",
    "Address": "123 Business Street, Mumbai, Maharashtra - 400001",
    "Email": "info@yourcompany.com",
    "Phone": "+91-22-1234-5678",
    "Website": "www.yourcompany.com",
    "PAN": "ABCDE1234F",
    "CIN": "U72200MH2020PTC123456",
    "GSTIN": "27ABCDE1234F1Z5",
    "LogoPath": "/images/company-logo.png",
    "LogoUrl": "https://yourcompany.com/logo.png"
  },
  "SSRS": {
    "ReportServerUrl": "http://localhost/reportserver",
    "ReportPath": "/PayrollReports",
    "Username": "your_report_server_user",
    "Password": "your_password",
    "TimeoutSeconds": 30
  }

}
