@model EmployeeManagement.API.Models.Payroll.PayrollSummaryResponse
@{
    ViewData["Title"] = "Process Payroll | वेतन प्रक्रिया";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-warning">
                <div class="card-header bg-warning text-dark fw-bold">
                    <h4><i class="fas fa-cogs"></i> Process Payroll</h4>
                </div>
                <div class="card-body p-4 text-center">
                    <h5 class="mb-4">Cycle: @Model.CycleName</h5>

                    <div class="alert alert-info text-start">
                        <p><strong><i class="fas fa-info-circle"></i> Note / टीप:</strong></p>
                        <ul>
                            <li>This action will calculate attendance, deductions, and final net pay for all active employees.</li>
                            <li>सर्व सक्रिय कर्मचाऱ्यांची उपस्थिती, कपात आणि अंतिम वेतन मोजले जाईल.</li>
                        </ul>
                    </div>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }

                    <form asp-action="ProcessPayroll" method="post">
                        <input type="hidden" name="cycleId" value="@Model.PayrollCycleId" />

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-lg btn-warning" onclick="return confirm('Start processing?');">
                                <i class="fas fa-play-circle"></i> Start Processing / प्रक्रिया सुरू करा
                            </button>

                            <a asp-action="CycleSummary" asp-route-cycleId="@Model.PayrollCycleId" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>