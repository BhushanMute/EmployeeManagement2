@model IEnumerable<EmployeeManagement.API.Models.Payroll.EmployeePayrollDetailResponse>
@{
    ViewData["Title"] = "Payroll Register | वेतन नोंदणी";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Payroll Register <small class="text-muted fs-5">| वेतन नोंदणी</small></h2>
        <a asp-action="CycleSummary" asp-route-cycleId="@Context.Request.RouteValues["cycleId"]" class="btn btn-secondary">Back to Summary</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body table-responsive">
            <table class="table table-striped table-hover table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Emp Code</th>
                        <th>Employee Name</th>
                        <th>Gross Pay (₹)</th>
                        <th>Deductions (₹)</th>
                        <th>Net Pay (₹)</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in Model)
                    {
                        <tr>
                            <td>@emp.EmployeeCode</td>
                            <td class="fw-bold">@emp.EmployeeName</td>

                            <td class="text-success">@emp.GrossSalary.ToString("N2")</td>

                            <td class="text-danger">@emp.TotalDeductions.ToString("N2")</td>

                            <td class="text-primary fw-bold">@emp.NetSalary.ToString("N2")</td>
                            <td>
                                @if (emp.Status == "Hold")
                                {
                                    <span class="badge bg-danger">Hold</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td>
                                <a asp-action="EmployeePayrollDetails" asp-route-cycleId="@Context.Request.RouteValues["cycleId"]" asp-route-employeeId="@emp.EmployeeId" class="btn btn-sm btn-info text-white" title="Details">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (emp.Status != "Hold")
                                {
                                    <button class="btn btn-sm btn-warning" onclick="holdSalary(@emp.PayrollProcessingId, '@emp.EmployeeName')" title="Hold Salary">
                                        <i class="fas fa-hand-paper"></i> Hold
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="holdModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title">Hold Salary / वेतन होल्ड करा</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Employee: <strong id="holdEmpName"></strong></p>
                <input type="hidden" id="holdProcessingId" />
                <div class="mb-3">
                    <label>Reason / कारण <span class="text-danger">*</span></label>
                    <textarea id="holdReason" class="form-control" rows="3" required></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-danger" onclick="submitHold()">Confirm Hold</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function holdSalary(processingId, name) {
            $('#holdProcessingId').val(processingId);
            $('#holdEmpName').text(name);
            $('#holdReason').val('');
            new bootstrap.Modal(document.getElementById('holdModal')).show();
        }

        function submitHold() {
            let pId = $('#holdProcessingId').val();
            let reason = $('#holdReason').val();

            if(!reason) { alert('Reason is required!'); return; }

            $.post('@Url.Action("HoldPayroll")', { processingId: pId, reason: reason }, function(res) {
                alert(res.message);
                if(res.success) location.reload();
            });
        }
    </script>
}