@model EmployeeManagement.API.Models.Payroll.SalarySlipResponse
@{
    ViewData["Title"] = $"Salary Slip - {Model.MonthName} {Model.Year}";

    // Compute Absent Days (not in model, so derive it)
    var absentDays = Model.TotalWorkingDays - Model.PresentDays - Model.PaidLeaveDays - Model.LOPDays;
    if (absentDays < 0) absentDays = 0;
}

<div class="container-fluid mt-4 pb-5">

    <!-- Action Bar (Hidden on Print) -->
    <div class="d-flex justify-content-between align-items-center mb-4 no-print">
        <div>
            <a asp-action="MySalarySlips" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left me-1"></i>Back to List
            </a>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="DownloadSalarySlip"
               asp-route-slipId="@Model.SlipId"
               class="btn btn-danger btn-sm">
                <i class="fas fa-file-pdf me-1"></i>Download PDF
            </a>
            <a asp-action="DownloadSalarySlipExcel"
               asp-route-slipId="@Model.SlipId"
               class="btn btn-success btn-sm">
                <i class="fas fa-file-excel me-1"></i>Download Excel
            </a>
            <a asp-action="ViewSSRSSalarySlip"
               asp-route-slipId="@Model.SlipId"
               class="btn btn-info btn-sm text-white">
                <i class="fas fa-chart-bar me-1"></i>Official Report
            </a>
            <button onclick="window.print()" class="btn btn-dark btn-sm">
                <i class="fas fa-print me-1"></i>Print
            </button>
        </div>
    </div>

    <!-- Payslip Document -->
    <div class="card shadow border-0 mx-auto" id="payslipDoc" style="max-width:900px;">
        <div class="card-body p-0">

            <!-- Header -->
            <div class="p-4 text-center border-bottom"
                 style="background: linear-gradient(135deg,#1a1a2e,#16213e);">
                <div class="row align-items-center">
                    <div class="col-2 text-start">
                        <div class="bg-white rounded p-2 d-inline-block">
                            <i class="fas fa-building fa-2x text-primary"></i>
                        </div>
                    </div>
                    <div class="col-8">
                        <h3 class="fw-bold text-white mb-1">
                            @(Model.CompanyDetails?.CompanyName ?? "Company Name Ltd.")
                        </h3>
                        <p class="text-white-50 small mb-0">
                            @(Model.CompanyDetails?.Address ?? "Address Line 1, City, State - 400001")
                        </p>
                        <p class="text-white-50 small mb-0">
                            CIN: @(Model.CompanyDetails?.CIN ?? "LXXXXXXXXXXXXXXX")
                            | PAN: @(Model.CompanyDetails?.PAN ?? "XXXXXXXXXX")
                        </p>
                    </div>
                    <div class="col-2 text-end">
                        <div class="text-white-50 small">
                            <i class="fas fa-shield-alt fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <span class="badge px-4 py-2 fs-6"
                          style="background:rgba(255,255,255,0.2); color:white; border:1px solid rgba(255,255,255,0.3);">
                        SALARY SLIP - @Model.MonthName.ToUpper() @Model.Year
                    </span>
                </div>
            </div>

            <!-- Employee Info -->
            <div class="p-4 border-bottom bg-light">
                <div class="row g-3">
                    <div class="col-md-6">
                        <table class="table table-sm table-borderless mb-0">
                            <tr>
                                <td class="text-muted small fw-semibold" style="width:45%">
                                    Employee Name:
                                </td>
                                <td class="fw-bold">@Model.EmployeeName</td>
                            </tr>
                            <tr>
                                <td class="text-muted small fw-semibold">Employee Code:</td>
                                <td>@Model.EmployeeCode</td>
                            </tr>
                            <tr>
                                <td class="text-muted small fw-semibold">Department:</td>
                                <td>@Model.Department</td>
                            </tr>
                            <tr>
                                <td class="text-muted small fw-semibold">Designation:</td>
                                <td>@Model.Designation</td>
                            </tr>
                            <tr>
                                <td class="text-muted small fw-semibold">Date of Joining:</td>
                                <td>@Model.JoiningDate?.ToString("dd MMM yyyy")</td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <table class="table table-sm table-borderless mb-0">
                            <tr>
                                <td class="text-muted small fw-semibold" style="width:45%">
                                    Slip Number:
                                </td>
                                <td>
                                    <span class="badge bg-primary">@Model.SlipNumber</span>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-muted small fw-semibold">Pay Period:</td>
                                <td>
                                    @Model.PayPeriodStart.ToString("dd MMM") -
                                    @Model.PayPeriodEnd.ToString("dd MMM yyyy")
                                </td>
                            </tr>
                            <tr>
                                <td class="text-muted small fw-semibold">Bank Account:</td>
                                <td>
                                    @(Model.AccountNumber ?? "N/A")
                                    @if (!string.IsNullOrEmpty(Model.BankName))
                                    {
                                        <span class="text-muted small">(@Model.BankName)</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td class="text-muted small fw-semibold">PAN Number:</td>
                                <td>@(Model.PANNumber ?? "N/A")</td>
                            </tr>
                            <tr>
                                <td class="text-muted small fw-semibold">UAN:</td>
                                <td>@(Model.UAN ?? "N/A")</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Attendance Summary -->
            <div class="px-4 py-3 border-bottom bg-white">
                <div class="row g-3 text-center">
                    <div class="col">
                        <div class="border rounded p-2">
                            <div class="small text-muted">Working Days</div>
                            <div class="fw-bold fs-5">@Model.TotalWorkingDays</div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="border rounded p-2 bg-success bg-opacity-10">
                            <div class="small text-muted">Present Days</div>
                            <div class="fw-bold fs-5 text-success">@Model.PresentDays</div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="border rounded p-2 bg-danger bg-opacity-10">
                            <div class="small text-muted">Absent Days</div>
                            <div class="fw-bold fs-5 text-danger">@absentDays</div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="border rounded p-2 bg-info bg-opacity-10">
                            <div class="small text-muted">Paid Leave</div>
                            <div class="fw-bold fs-5 text-info">@Model.PaidLeaveDays</div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="border rounded p-2 bg-warning bg-opacity-10">
                            <div class="small text-muted">LOP Days</div>
                            <div class="fw-bold fs-5 text-warning">@Model.LOPDays</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Earnings & Deductions -->
            <div class="p-4">
                <div class="row">

                    <!-- Earnings -->
                    <div class="col-md-6 pe-md-2">
                        <div class="border rounded overflow-hidden">
                            <div class="bg-success text-white px-3 py-2 fw-bold small">
                                <i class="fas fa-plus-circle me-1"></i>
                                EARNINGS / मिळकत
                            </div>
                            <table class="table table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="small">Component</th>
                                        <th class="text-end small">Amount (₹)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Earnings != null && Model.Earnings.Any())
                                    {
                                        foreach (var item in Model.Earnings)
                                        {
                                            <tr>
                                                <td class="small">@item.ComponentName</td>
                                                <td class="text-end small">
                                                    @item.Amount.ToString("N2")
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="2" class="text-center text-muted small">
                                                No earnings data
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-success">
                                    <tr>
                                        <td class="fw-bold small">Total Earnings</td>
                                        <td class="text-end fw-bold">
                                            ₹ @Model.TotalEarnings?.ToString("N2")
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <!-- Deductions -->
                    <div class="col-md-6 ps-md-2 mt-3 mt-md-0">
                        <div class="border rounded overflow-hidden">
                            <div class="bg-danger text-white px-3 py-2 fw-bold small">
                                <i class="fas fa-minus-circle me-1"></i>
                                DEDUCTIONS / कपात
                            </div>
                            <table class="table table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="small">Component</th>
                                        <th class="text-end small">Amount (₹)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Deductions != null && Model.Deductions.Any())
                                    {
                                        foreach (var item in Model.Deductions)
                                        {
                                            <tr>
                                                <td class="small">@item.ComponentName</td>
                                                <td class="text-end small">
                                                    @item.Amount.ToString("N2")
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="2" class="text-center text-muted small">
                                                No deductions
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-danger">
                                    <tr>
                                        <td class="fw-bold small">Total Deductions</td>
                                        <td class="text-end fw-bold">
                                            ₹ @Model.TotalDeductions?.ToString("N2")
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Net Pay Banner -->
            <div class="mx-4 mb-4 rounded overflow-hidden"
                 style="background:linear-gradient(135deg,#1a1a2e,#16213e);">
                <div class="p-4">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <p class="text-white-50 small mb-1">Net Salary in Words / शब्दात</p>
                            <p class="text-white fw-semibold mb-0 fst-italic">
                                @if (!string.IsNullOrEmpty(Model.NetSalaryInWords))
                                {
                                    @:Rupees @Model.NetSalaryInWords Only.
                                }
                                else
                                {
                                    @:N/A
                                }
                            </p>
                        </div>
                        <div class="col-md-4 text-end">
                            <p class="text-white-50 small mb-1">NET PAY / निव्वळ वेतन</p>
                            <h2 class="text-white fw-bold mb-0">
                                ₹ @Model.NetSalary?.ToString("N2")
                            </h2>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="px-4 pb-4">
                <div class="border-top pt-3 text-center">
                    <p class="text-muted small mb-1">
                        <i class="fas fa-info-circle me-1"></i>
                        This is a computer-generated payslip. No signature is required.
                    </p>
                    <p class="text-muted small mb-0">
                        ही संगणकाद्वारे तयार केलेली वेतन पावती आहे. सहीची आवश्यकता नाही.
                    </p>
                    <p class="text-muted small mt-2">
                        Generated on: @Model.GeneratedDate.ToString("dd MMM yyyy HH:mm")
                        | Slip ID: @Model.SlipId
                        | Status: <span class="badge bg-secondary">@Model.Status</span>
                    </p>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Print Styles -->
<style>
    @@media print {
        body * {
            visibility: hidden !important;
        }

        #payslipDoc, #payslipDoc * {
            visibility: visible !important;
        }

        #payslipDoc {
            position: fixed;
            left: 0;
            top: 0;
            width: 100%;
            max-width: 100% !important;
            margin: 0 !important;
            box-shadow: none !important;
        }

        .no-print {
            display: none !important;
        }

        .card {
            border: none !important;
        }
    }
</style>