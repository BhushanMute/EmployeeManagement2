@model IEnumerable<EmployeeManagement.UI.Models.EmployeePayrollDetailResponse>
@{
    ViewData["Title"] = "Salary Slip Management";
    int cycleId = ViewBag.CycleId;
    string cycleName = ViewBag.CycleName ?? "Cycle #" + cycleId;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>📑 Salary Slip List: @cycleName</h3>
        <div>
            <a asp-action="EmailStatus" asp-route-cycleId="@cycleId" class="btn btn-warning">📧 Check Email Status</a>
            <a asp-action="GenerateSalarySlips" asp-route-cycleId="@cycleId" class="btn btn-primary">✨ Generate Slips</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <!-- Toolbar -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="btn-group">
                        <button id="btnSelectAll" class="btn btn-outline-secondary">Select All</button>
                        <button id="btnSendSelected" class="btn btn-success" disabled onclick="sendSelectedEmails()">📧 Send Selected</button>
                        <button id="btnSendAll" class="btn btn-danger" onclick="sendAllEmails()">📤 Send To All</button>
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <span id="selectedCount" class="badge bg-info text-dark">0 Selected</span>
                </div>
            </div>

            <!-- Grid -->
            <table class="table table-striped table-hover" id="slipTable">
                <thead>
                    <tr>
                        <th><input type="checkbox" id="masterCheckbox"></th>
                        <th>Emp Code</th>
                        <th>Name</th>
                        <th>Department</th>
                        <th>Net Salary</th>
                        <th>Slip Status</th>
                        <th>Email Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><input type="checkbox" class="row-check" value="@item.PayrollProcessingId"></td>
                                <td>@item.EmployeeCode</td>
                                <td>@item.EmployeeName</td>
                                <td>@item.DepartmentName</td>
                                <td class="fw-bold">₹ @((item.NetSalary ?? 0m).ToString("N2", System.Globalization.CultureInfo.InvariantCulture))</td>
                                <td><span class="badge bg-primary">Generated</span></td>
                                <td><span class="badge bg-secondary">Pending</span></td>
                                <td>
                                    <a href="#" class="btn btn-sm btn-outline-info" onclick="viewSlip(@item.PayrollProcessingId)">👁️</a>
                                    <a href="#" class="btn btn-sm btn-outline-danger" onclick="downloadSlip(@item.PayrollProcessingId)">📥</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="8" class="text-center">No records found for this cycle.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- JavaScript for Bulk Logic -->
@section Scripts {
    <script>
        // 1. Checkbox Logic
        $('#masterCheckbox').on('change', function() {
            $('.row-check').prop('checked', this.checked);
            updateSelection();
        });
        $('.row-check').on('change', updateSelection);

        function updateSelection() {
            var count = $('.row-check:checked').length;
            $('#selectedCount').text(count + ' Selected');
            $('#btnSendSelected').prop('disabled', count === 0);
            $('#masterCheckbox').prop('checked', count === $('.row-check').length && count > 0);
        }

        // 2. Send Selected
        function sendSelectedEmails() {
            var ids = [];
            $('.row-check:checked').each(function() { ids.push($(this).val()); });
            sendEmailRequest(ids);
        }

        // 3. Send All
        function sendAllEmails() {
            if(!confirm("Are you sure you want to send emails to ALL employees in this cycle?")) return;
            sendEmailRequest([]); // Empty array triggers backend logic for "All"
        }

        // 4. AJAX Call
        function sendEmailRequest(slipIds) {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            $.ajax({
                url: '@Url.Action("SendSalarySlipsEmail")',
                type: 'POST',
                data: {
                    cycleId: @cycleId,
                    slipIds: slipIds,
                    __RequestVerificationToken: token
                },
                success: function(res) {
                    if(res.success) {
                        alert(res.message);
                        window.location.href = res.redirectUrl || window.location.href;
                    } else {
                        alert("Error: " + res.message);
                    }
                },
                error: function() { alert("Server Error!"); }
            });
        }

        // Helpers
        function viewSlip(id) { window.open('/SalarySlip/ViewSalarySlip?slipId=' + id, '_blank'); }
        function downloadSlip(id) { window.location.href = '/SalarySlip/DownloadSalarySlip?slipId=' + id; }
    </script>
}
