@model EmployeeManagement.UI.Models.PayrollSummaryResponse
@{
    ViewData["Title"] = "Generate Salary Slips | वेतन पावत्या तयार करा";
    int cycleId = ViewBag.CycleId;
}

@section Styles {
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --success-gradient: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            --warning-gradient: linear-gradient(135deg, #f7971e 0%, #ffd200 100%);
        }

        body {
            background: #f4f6f9;
        }

        .page-hero {
            background: var(--primary-gradient);
            color: white;
            padding: 2rem;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
            margin-bottom: 1.5rem;
            position: relative;
            overflow: hidden;
        }

            .page-hero::before {
                content: '';
                position: absolute;
                top: -50%;
                right: -10%;
                width: 300px;
                height: 300px;
                background: rgba(255,255,255,0.1);
                border-radius: 50%;
            }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        /* === Stepper === */
        .stepper {
            display: flex;
            justify-content: space-between;
            margin-bottom: 2rem;
            padding: 1.5rem;
            background: white;
            border-radius: 14px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            position: relative;
        }

        .step {
            flex: 1;
            text-align: center;
            position: relative;
        }

            .step:not(:last-child)::after {
                content: '';
                position: absolute;
                top: 22px;
                left: calc(50% + 25px);
                right: calc(-50% + 25px);
                height: 3px;
                background: #e2e8f0;
                z-index: 1;
            }

            .step.completed:not(:last-child)::after {
                background: linear-gradient(90deg, #10b981 0%, #38ef7d 100%);
            }

        .step-icon {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: #e2e8f0;
            color: #94a3b8;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            position: relative;
            z-index: 2;
            transition: all 0.3s;
        }

        .step.active .step-icon {
            background: var(--primary-gradient);
            color: white;
            transform: scale(1.1);
            box-shadow: 0 6px 15px rgba(102, 126, 234, 0.4);
        }

        .step.completed .step-icon {
            background: var(--success-gradient);
            color: white;
        }

        .step-label {
            margin-top: 0.5rem;
            font-size: 0.85rem;
            font-weight: 600;
            color: #64748b;
        }

        .step.active .step-label {
            color: #667eea;
        }

        .step.completed .step-label {
            color: #10b981;
        }

        /* === Main Card === */
        .main-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            border: none;
            overflow: hidden;
        }

        .card-section-header {
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            padding: 1.25rem 1.5rem;
            border-bottom: 2px solid #e2e8f0;
        }

        /* === Cycle Info Card === */
        .cycle-info-card {
            background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
            border-radius: 14px;
            padding: 1.5rem;
            border-left: 5px solid #6366f1;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            padding: 0.5rem 0;
            border-bottom: 1px dashed #c7d2fe;
        }

            .info-row:last-child {
                border-bottom: none;
            }

        .info-label {
            color: #4f46e5;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .info-value {
            color: #1e1b4b;
            font-weight: 700;
        }

        /* === Stat Tiles === */
        .stat-tile {
            background: white;
            border-radius: 12px;
            padding: 1.25rem;
            text-align: center;
            border: 2px solid #f1f5f9;
            transition: all 0.3s;
        }

            .stat-tile:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 20px rgba(0,0,0,0.08);
            }

            .stat-tile .icon {
                width: 50px;
                height: 50px;
                border-radius: 12px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 1.3rem;
                color: white;
                margin-bottom: 0.75rem;
            }

                .stat-tile .icon.primary {
                    background: var(--primary-gradient);
                }

                .stat-tile .icon.success {
                    background: var(--success-gradient);
                }

                .stat-tile .icon.warning {
                    background: var(--warning-gradient);
                }

            .stat-tile h4 {
                font-weight: 800;
                margin: 0;
                color: #1e293b;
            }

            .stat-tile small {
                color: #64748b;
                font-size: 0.78rem;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                font-weight: 600;
            }

        /* === Checklist === */
        .checklist {
            background: #f8fafc;
            border-radius: 12px;
            padding: 1.25rem;
            border-left: 4px solid #f59e0b;
        }

        .check-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.5rem 0;
            font-size: 0.9rem;
            color: #475569;
        }

            .check-item i {
                color: #10b981;
                font-size: 1rem;
            }

        /* === Confirm Box === */
        .confirm-box {
            background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
            border: 2px solid #f59e0b;
            border-radius: 12px;
            padding: 1.25rem;
        }

        .form-check-input-lg {
            width: 1.5em !important;
            height: 1.5em !important;
            cursor: pointer;
        }

            .form-check-input-lg:checked {
                background-color: #10b981;
                border-color: #10b981;
            }

        /* === Action Buttons === */
        .btn-generate {
            background: var(--success-gradient);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 1rem 2rem;
            font-size: 1.05rem;
            font-weight: 700;
            box-shadow: 0 8px 20px rgba(17, 153, 142, 0.3);
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

            .btn-generate:hover:not(:disabled) {
                transform: translateY(-3px);
                box-shadow: 0 12px 25px rgba(17, 153, 142, 0.4);
                color: white;
            }

            .btn-generate:disabled {
                background: #cbd5e0;
                cursor: not-allowed;
                box-shadow: none;
            }

        .btn-cancel {
            background: white;
            color: #64748b;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 1rem 2rem;
            font-weight: 600;
            transition: all 0.3s;
        }

            .btn-cancel:hover {
                border-color: #94a3b8;
                color: #1e293b;
            }

        /* === Status Badge === */
        .status-badge {
            display: inline-block;
            padding: 0.4rem 1rem;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

            .status-badge.processed {
                background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
                color: #1e40af;
            }

            .status-badge.approved {
                background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%);
                color: #065f46;
            }

        /* === Loading === */
        .loader-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.6);
            display: none;
            z-index: 9999;
            justify-content: center;
            align-items: center;
            backdrop-filter: blur(5px);
        }

            .loader-overlay.show {
                display: flex;
            }

        .loader-box {
            background: white;
            padding: 2.5rem;
            border-radius: 16px;
            text-align: center;
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
            min-width: 300px;
        }
    </style>
}

<div class="container py-4 pb-5">

    <!-- ===== HERO ===== -->
    <div class="page-hero">
        <div class="hero-content">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 70px; height: 70px;">
                        <i class="fas fa-magic fa-2x"></i>
                    </div>
                    <div>
                        <h2 class="fw-bold mb-1">Generate Salary Slips</h2>
                        <p class="mb-0 opacity-90">
                            <i class="fas fa-info-circle me-1"></i>
                            Create salary slips for all employees in this cycle
                            <br>
                            <small>सर्व कर्मचाऱ्यांसाठी वेतन पावत्या तयार करा</small>
                        </p>
                    </div>
                </div>
                <a asp-controller="Payroll" asp-action="Cycles"
                   class="btn btn-light fw-semibold">
                    <i class="fas fa-arrow-left me-1"></i>Back to Cycles
                </a>
            </div>
        </div>
    </div>

    <!-- ===== STEPPER ===== -->
    <div class="stepper">
        <div class="step completed">
            <div class="step-icon"><i class="fas fa-check"></i></div>
            <div class="step-label">Cycle Created</div>
        </div>
        <div class="step completed">
            <div class="step-icon"><i class="fas fa-check"></i></div>
            <div class="step-label">Payroll Processed</div>
        </div>
        <div class="step active">
            <div class="step-icon"><i class="fas fa-file-invoice"></i></div>
            <div class="step-label">Generate Slips</div>
        </div>
        <div class="step">
            <div class="step-icon"><i class="fas fa-paper-plane"></i></div>
            <div class="step-label">Send Emails</div>
        </div>
    </div>

    <!-- ===== MAIN CARD ===== -->
    <div class="main-card">
        <div class="card-section-header">
            <h5 class="fw-bold mb-0">
                <i class="fas fa-cogs text-primary me-2"></i>
                Cycle Information & Confirmation
            </h5>
        </div>

        <div class="card-body p-4">
            <form method="post" asp-action="GenerateSalarySlips" id="generateForm">
                <input type="hidden" name="PayrollCycleId" value="@cycleId" />
                @Html.AntiForgeryToken()

                <!-- ===== Cycle Info ===== -->
                <div class="cycle-info-card mb-4">
                    <h6 class="fw-bold mb-3 text-primary">
                        <i class="fas fa-calendar-check me-2"></i>Cycle Details
                    </h6>
                    <div class="info-row">
                        <span class="info-label"><i class="fas fa-tag me-1"></i>Cycle Name</span>
                        <span class="info-value">@Model?.CycleName</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label"><i class="fas fa-calendar me-1"></i>Period</span>
                        <span class="info-value">
                            @Model?.StartDate.ToString("dd MMM yyyy")
                            -
                            @Model?.EndDate.ToString("dd MMM yyyy")
                        </span>
                    </div>
                    <div class="info-row">
                        <span class="info-label"><i class="fas fa-circle-info me-1"></i>Status</span>
                        <span class="info-value">
                            @{
                                var statusClass = Model?.Status?.ToLower() == "approved" ? "approved" : "processed";
                            }
                            <span class="status-badge @statusClass">
                                <i class="fas fa-check-circle me-1"></i>@Model?.Status
                            </span>
                        </span>
                    </div>
                </div>

                <!-- ===== Stat Tiles ===== -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="stat-tile">
                            <div class="icon primary">
                                <i class="fas fa-users"></i>
                            </div>
                            <small>Total Employees</small>
                            <h4>@Model?.TotalEmployees</h4>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="stat-tile">
                            <div class="icon success">
                                <i class="fas fa-rupee-sign"></i>
                            </div>
                            <small>Total Net Pay</small>
                            <h4>₹@(Model?.TotalNetSalary.ToString("N0") ?? "0")</h4>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="stat-tile">
                            <div class="icon warning">
                                <i class="fas fa-file-invoice"></i>
                            </div>
                            <small>Slips to Generate</small>
                            <h4>@Model?.TotalEmployees</h4>
                        </div>
                    </div>
                </div>

                <!-- ===== Pre-Generation Checklist ===== -->
                <div class="checklist mb-4">
                    <h6 class="fw-bold mb-3 text-warning">
                        <i class="fas fa-clipboard-check me-2"></i>Pre-Generation Checklist
                    </h6>
                    <div class="check-item">
                        <i class="fas fa-check-circle"></i>
                        Payroll cycle is in <strong>@Model?.Status</strong> status
                    </div>
                    <div class="check-item">
                        <i class="fas fa-check-circle"></i>
                        All @Model?.TotalEmployees employees have valid records
                    </div>
                    <div class="check-item">
                        <i class="fas fa-check-circle"></i>
                        Salary structures are properly configured
                    </div>
                    <div class="check-item">
                        <i class="fas fa-check-circle"></i>
                        Existing slips (if any) will be regenerated
                    </div>
                </div>

                <!-- ===== Options ===== -->
                <div class="mb-4">
                    <h6 class="fw-bold mb-3">
                        <i class="fas fa-sliders-h text-primary me-2"></i>Generation Options
                    </h6>
                    <div class="form-check mb-2">
                        <input type="checkbox" class="form-check-input" id="regenerateExisting"
                               name="RegenerateExisting" value="true" />
                        <label class="form-check-label" for="regenerateExisting">
                            <strong>Regenerate Existing Slips</strong>
                            <br>
                            <small class="text-muted">
                                If checked, existing slips will be overwritten
                            </small>
                        </label>
                    </div>
                </div>

                <!-- ===== Confirmation ===== -->
                <div class="confirm-box mb-4">
                    <div class="form-check">
                        <input class="form-check-input form-check-input-lg" type="checkbox"
                               id="confirmCheck" required />
                        <label class="form-check-label ms-2" for="confirmCheck">
                            <strong>I confirm that:</strong>
                            <ul class="mt-2 mb-0 small">
                                <li>Payroll has been reviewed and approved</li>
                                <li>All employee data is accurate</li>
                                <li>I have authority to generate these slips</li>
                            </ul>
                        </label>
                    </div>
                </div>

                <!-- ===== Action Buttons ===== -->
                <div class="d-flex gap-3 justify-content-end flex-wrap">
                    <a asp-controller="Payroll" asp-action="CycleSummary"
                       asp-route-cycleId="@cycleId"
                       class="btn btn-cancel">
                        <i class="fas fa-times me-1"></i>Cancel
                    </a>
                    <button type="submit" class="btn btn-generate" id="btnGenerate" disabled>
                        <i class="fas fa-magic me-2"></i>
                        Generate All Slips
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ===== Help Text ===== -->
    <div class="mt-3 text-center text-muted small">
        <i class="fas fa-info-circle me-1"></i>
        This process may take a few minutes depending on the number of employees.
        <br>
        <span>ही प्रक्रिया कर्मचाऱ्यांच्या संख्येनुसार काही मिनिटे घेऊ शकते.</span>
    </div>
</div>

<!-- ===== Loader ===== -->
<div class="loader-overlay" id="loader">
    <div class="loader-box">
        <div class="spinner-border text-primary mb-3" style="width: 3.5rem; height: 3.5rem;"></div>
        <h5 class="fw-bold mb-2">Generating Salary Slips</h5>
        <p class="text-muted mb-0">Please wait, this may take a moment...</p>
        <small class="text-secondary">कृपया थांबा...</small>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // ===== Enable/Disable Submit Button =====
            $('#confirmCheck').change(function () {
                $('#btnGenerate').prop('disabled', !this.checked);

                if (this.checked) {
                    $('#btnGenerate').addClass('pulse-effect');
                } else {
                    $('#btnGenerate').removeClass('pulse-effect');
                }
            });

            // ===== Form Submit =====
            $('#generateForm').on('submit', function (e) {
                if (!$('#confirmCheck').is(':checked')) {
                    e.preventDefault();
                    alert('Please confirm the checklist before proceeding.');
                    return false;
                }

                // Final confirmation
                if (!confirm(
                    "🚀 Final Confirmation\n\n" +
                    "Generate salary slips for @Model?.TotalEmployees employees?\n\n" +
                    "This action cannot be easily undone."
                )) {
                    e.preventDefault();
                    return false;
                }

                // Show loader
                $('#loader').addClass('show');
                $('#btnGenerate').prop('disabled', true)
                    .html('<i class="fas fa-spinner fa-spin me-2"></i>Generating...');
            });
        });
    </script>
}