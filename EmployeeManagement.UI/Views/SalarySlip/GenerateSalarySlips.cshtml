@model EmployeeManagement.API.Models.Payroll.PayrollSummaryResponse
@{
    ViewData["Title"] = "Generate Salary Slips | वेतन पावत्या तयार करा";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm">
                    <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Cycle Info Card -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header border-0 py-3"
                     style="background:linear-gradient(135deg,#667eea,#764ba2);">
                    <h5 class="text-white mb-0">
                        <i class="fas fa-cogs me-2"></i>
                        Generate Salary Slips / वेतन पावत्या तयार करा
                    </h5>
                </div>
                <div class="card-body p-4">

                    <!-- Cycle Summary -->
                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <div class="d-flex align-items-center p-3 bg-light rounded">
                                <i class="fas fa-calendar-alt fa-2x text-primary me-3"></i>
                                <div>
                                    <h5 class="mb-0 fw-bold">@Model.CycleName</h5>
                                    <span class="badge bg-info">@Model.Status</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-center p-3 border rounded">
                                <i class="fas fa-users text-primary fa-2x mb-2"></i>
                                <div class="text-muted small">Total Employees</div>
                                <h4 class="fw-bold mb-0">@Model.TotalEmployees</h4>
                            </div>
                        </div>
                       @*  <div class="col-md-4">
                            <div class="text-center p-3 border rounded">
                                <i class="fas fa-money-bill-wave text-success fa-2x mb-2"></i>
                                <div class="text-muted small">Total Net Payout</div>
                                <h5 class="fw-bold mb-0 text-success">
                                    ₹ @Model.TotalNetPay?.ToString("N2")
                                </h5>
                            </div>
                        </div> *@
                        <div class="col-md-4">
                            <div class="text-center p-3 border rounded">
                                <i class="fas fa-check-circle text-info fa-2x mb-2"></i>
                                <div class="text-muted small">Cycle Status</div>
                                <h5 class="fw-bold mb-0 text-info">@Model.Status</h5>
                            </div>
                        </div>
                    </div>

                    <!-- Warning Alert -->
                    <div class="alert alert-warning border-0 shadow-sm mb-4">
                        <h6 class="alert-heading fw-bold">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Please Read Before Proceeding / पुढे जाण्यापूर्वी वाचा
                        </h6>
                        <ul class="mb-0 small">
                            <li>Salary slips will be generated for all <strong>@Model.TotalEmployees</strong> employees in this cycle.</li>
                            <li>Once generated, slips will be available in employee ESS portals.</li>
                            <li>You can send email notifications to all employees after generation.</li>
                            <li>एकदा तयार केलेल्या पावत्या कर्मचाऱ्यांना दिसतील.</li>
                        </ul>
                    </div>

                    <!-- Generate Form -->
                    <form asp-action="GenerateSalarySlips" method="post" id="generateForm">
                        <input type="hidden" name="PayrollCycleId" value="@ViewBag.CycleId" />

                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="sendEmailCheck"
                                       name="SendEmailAfterGeneration"
                                       value="true" />
                                <label class="form-check-label" for="sendEmailCheck">
                                    Send email notification to all employees after generation
                                    / तयार झाल्यानंतर सर्व कर्मचाऱ्यांना ईमेल पाठवा
                                </label>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="confirmCheck"
                                       required />
                                <label class="form-check-label fw-semibold" for="confirmCheck">
                                    I confirm that I want to generate salary slips for this cycle.
                                    / मी या सायकलसाठी वेतन पावत्या तयार करण्याची पुष्टी करतो.
                                </label>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-primary btn-lg"
                                    id="generateBtn"
                                    disabled>
                                <i class="fas fa-magic me-2"></i>
                                Generate Slips / पावत्या तयार करा
                            </button>
                            <a asp-controller="Payroll"
                               asp-action="CycleSummary"
                               asp-route-cycleId="@ViewBag.CycleId"
                               class="btn btn-outline-secondary btn-lg">
                                Cancel / रद्द करा
                            </a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Enable Generate button only when confirmed
            $('#confirmCheck').change(function () {
                $('#generateBtn').prop('disabled', !$(this).is(':checked'));
            });

            // Show loading on submit
            $('#generateForm').submit(function () {
                $('#generateBtn').html(
                    '<span class="spinner-border spinner-border-sm me-2"></span>Generating...'
                ).prop('disabled', true);
            });
        });
    </script>
}