@{
    ViewData["Title"] = "Access Denied";
}

@section Styles {
    <style>
        .denied-shell {
            min-height: calc(100vh - 190px);
            display: grid;
            place-items: center;
            padding: 2rem 0;
        }

        .denied-panel {
            width: min(920px, 100%);
            background: #ffffff;
            border: 1px solid #dbe3ef;
            border-radius: 8px;
            box-shadow: 0 24px 60px rgba(15, 23, 42, 0.10);
            overflow: hidden;
        }

        .denied-header {
            background:
                radial-gradient(circle at 18% 20%, rgba(220, 38, 38, 0.14), transparent 32%),
                linear-gradient(135deg, #fff7ed 0%, #ffffff 65%);
            border-bottom: 1px solid #fed7aa;
            padding: 2rem;
        }

        .denied-icon {
            width: 64px;
            height: 64px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: #fee2e2;
            color: #b91c1c;
            font-size: 1.65rem;
            margin-bottom: 1rem;
        }

        .denied-title {
            font-size: 1.85rem;
            font-weight: 800;
            margin-bottom: 0.45rem;
            color: #172033;
        }

        .denied-copy {
            color: #64748b;
            max-width: 720px;
            margin: 0;
        }

        .denied-body {
            padding: 1.5rem 2rem 2rem;
        }

        .denied-step {
            display: flex;
            gap: 0.8rem;
            padding: 0.9rem 0;
            border-bottom: 1px solid #edf2f7;
        }

        .denied-step:last-child {
            border-bottom: none;
        }

        .denied-step i {
            width: 34px;
            height: 34px;
            flex: 0 0 34px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: #eff6ff;
            color: #2563eb;
        }

        .denied-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            margin-top: 1.25rem;
        }

        @@media (max-width: 575.98px) {
            .denied-header,
            .denied-body {
                padding: 1.2rem;
            }

            .denied-title {
                font-size: 1.45rem;
            }
        }
    </style>
}

<div class="denied-shell">
    <section class="denied-panel">
        <div class="denied-header">
            <div class="denied-icon">
                <i class="fas fa-shield-halved"></i>
            </div>
            <h1 class="denied-title">Access denied</h1>
            <p class="denied-copy">
                Your account is active, but this page requires a role or permission that is not assigned to you.
                Contact an admin if you need access for your job responsibility.
            </p>
        </div>
        <div class="denied-body">
            <div class="denied-step">
                <i class="fas fa-id-badge"></i>
                <div>
                    <div class="fw-bold">Role check failed</div>
                    <small class="text-muted">The page is protected by role or permission policy.</small>
                </div>
            </div>
            <div class="denied-step">
                <i class="fas fa-user-shield"></i>
                <div>
                    <div class="fw-bold">Admin can update access</div>
                    <small class="text-muted">Admin should assign the correct role and department scope from User Management.</small>
                </div>
            </div>
            <div class="denied-step">
                <i class="fas fa-clock"></i>
                <div>
                    <div class="fw-bold">Try again after approval</div>
                    <small class="text-muted">Log out and sign in again after your access is updated.</small>
                </div>
            </div>

            <div class="denied-actions">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="fas fa-arrow-left me-1"></i>Back to Dashboard
                </a>
                <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary">
                    <i class="fas fa-user me-1"></i>My Profile
                </a>
            </div>
        </div>
    </section>
</div>
