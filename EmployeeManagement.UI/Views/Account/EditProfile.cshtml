@* Views/Account/EditProfile.cshtml *@
@model EmployeeManagement.UI.Models.ProfileViewModel
@inject IConfiguration Configuration
@{
    var username = Context.Session.GetString("Username");
    var UserId = Context.Session.GetString("UserId");
    var email = Context.Session.GetString("Email");
    var fullName = Context.Session.GetString("FullName");
    var profilePic = Context.Session.GetString("ProfilePicture");
    var roles = Context.Session.GetString("Roles")?.Split(',') ?? Array.Empty<string>();
    var permissions = Context.Session.GetString("Permissions")?.Split(',') ?? Array.Empty<string>();
    var isAdmin = roles.Contains("Admin");
    var isHR = roles.Contains("HR") || isAdmin;
    var isManager = roles.Contains("Manager") || isHR;

    // Get initials for fallback
    var initials = "";
    if (!string.IsNullOrEmpty(fullName))
    {
        var names = fullName.Split(' ');
        initials = names.Length >= 2
            ? $"{names[0].FirstOrDefault()}{names[1].FirstOrDefault()}".ToUpper()
            : $"{names[0].FirstOrDefault()}".ToUpper();
    }
}
@{
    ViewData["Title"] = "Edit Profile";
}

<style>
    .card-custom {
        border: none;
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }

    .card-header-custom {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 1.5rem;
    }

    .form-control-custom {
        border-radius: 10px;
        border: 2px solid #e9ecef;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
    }

        .form-control-custom:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.15);
        }

    .form-label-custom {
        font-weight: 600;
        color: #495057;
        margin-bottom: 0.5rem;
    }

    .btn-save {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        border-radius: 10px;
        padding: 0.75rem 2rem;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

    .btn-cancel {
        border-radius: 10px;
        padding: 0.75rem 2rem;
        font-weight: 600;
    }

    .info-card {
        background: linear-gradient(135deg, #f5f7fa 0%, #e4e8ec 100%);
        border-radius: 10px;
        padding: 1rem;
    }

    .required-star {
        color: #dc3545;
        font-weight: bold;
    }

    .section-divider {
        border: none;
        height: 2px;
        background: linear-gradient(to right, transparent, #e9ecef, transparent);
        margin: 2rem 0;
    }
</style>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- Back Button -->
            <div class="mb-4">
                <a asp-action="Profile" class="btn btn-outline-secondary btn-cancel">
                    <i class="fas fa-arrow-left me-2"></i>Back to Profile
                </a>
            </div>

            <!-- Success/Error Messages -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Edit Profile Card -->
            <div class="card card-custom">
                <div class="card-header card-header-custom text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-user-edit me-2"></i>Edit Profile
                    </h4>
                    <small class="opacity-75">Update your personal information</small>
                </div>

                <div class="card-body p-4">

                    <!-- Profile Picture Section (Same as Profile Page) -->
                    <div class="text-center mb-4">
                        <h6 class="text-muted mb-3">
                            <i class="fas fa-camera me-2"></i>Profile Picture
                        </h6>

                        <div class="position-relative d-inline-block">
                            @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                            {
                                <img src="@Model.ProfilePictureDisplay"
                                     alt="Profile"
                                     id="profilePreview"
                                     class="rounded-circle border border-3 border-primary shadow"
                                     style="width: 150px; height: 150px; object-fit: cover; cursor: pointer;"
                                     onclick="document.getElementById('profilePictureInput').click()"
                                     title="Click to change profile picture">
                            }
                            else
                            {
                                <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center shadow"
                                     id="profileInitial"
                                     style="width: 150px; height: 150px; font-size: 3rem; cursor: pointer;"
                                     onclick="document.getElementById('profilePictureInput').click()"
                                     title="Click to add profile picture">
                                    @Model.Initials
                                </div>
                                <img src=""
                                     alt="Profile"
                                     id="profilePreview"
                                     class="rounded-circle border border-3 border-primary shadow d-none"
                                     style="width: 150px; height: 150px; object-fit: cover; cursor: pointer;"
                                     onclick="document.getElementById('profilePictureInput').click()">
                            }

                            <!-- Camera Icon -->
                            <div class="position-absolute bottom-0 end-0 bg-primary rounded-circle p-2 shadow"
                                 style="cursor: pointer; border: 2px solid white;"
                                 onclick="document.getElementById('profilePictureInput').click()"
                                 title="Change profile picture">
                                <i class="fas fa-camera text-white"></i>
                            </div>
                        </div>

                        <!-- Hidden File Input -->
                        <input type="file"
                               id="profilePictureInput"
                               accept="image/jpeg,image/png,image/gif"
                               class="d-none"
                               onchange="handleProfilePictureSelect(this)">

                        <!-- Upload Link -->
                        <div class="mt-2">
                            <a href="javascript:void(0)"
                               onclick="document.getElementById('profilePictureInput').click()"
                               class="text-primary text-decoration-none small">
                                <i class="fas fa-camera me-1"></i>
                                @(string.IsNullOrEmpty(Model.ProfilePicture) ? "Add Photo" : "Change Photo")
                            </a>
                            @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                            {
                                <span class="mx-2 text-muted">|</span>
                                <a href="javascript:void(0)"
                                   onclick="removeProfilePicture()"
                                   class="text-danger text-decoration-none small">
                                    <i class="fas fa-trash me-1"></i>Remove Photo
                                </a>
                            }
                        </div>

                        <!-- Upload Progress -->
                        <div id="uploadProgress" class="mt-2 d-none">
                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            <small class="text-muted ms-2">Uploading...</small>
                        </div>

                        <!-- Upload Message -->
                        <div id="uploadMessage" class="mt-2"></div>

                        <!-- File Info -->
                        <div class="mt-2">
                            <small class="text-muted d-block">
                                <i class="fas fa-info-circle me-1"></i>
                                Supported formats: JPG, PNG, GIF (Max 5MB)
                            </small>
                        </div>
                    </div>

                    <hr class="section-divider">

                    <!-- Profile Form -->
                    <form id="editProfileForm" asp-action="EditProfile" method="post">
                        <input type="hidden" name="UserId" value="@Model.Id" />
                        <input type="hidden" asp-for="Id" />

                        <!-- Personal Information Section -->
                        <div class="mb-4">
                            <h6 class="text-primary mb-3">
                                <i class="fas fa-user me-2"></i>Personal Information
                            </h6>

                            <div class="row g-3">
                                <!-- First Name -->
                                <div class="col-md-6">
                                    <label asp-for="FirstName" class="form-label form-label-custom">
                                        First Name <span class="required-star">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="fas fa-user text-muted"></i>
                                        </span>
                                        <input asp-for="FirstName" class="form-control form-control-custom"
                                               placeholder="Enter first name" required />
                                    </div>
                                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                                </div>

                                <!-- Last Name -->
                                <div class="col-md-6">
                                    <label asp-for="LastName" class="form-label form-label-custom">
                                        Last Name <span class="required-star">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="fas fa-user text-muted"></i>
                                        </span>
                                        <input asp-for="LastName" class="form-control form-control-custom"
                                               placeholder="Enter last name" required />
                                    </div>
                                    <span asp-validation-for="LastName" class="text-danger small"></span>
                                </div>

                                <!-- Username (Read-only) -->
                                <div class="col-md-6">
                                    <label asp-for="Username" class="form-label form-label-custom">
                                        Username
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="fas fa-at text-muted"></i>
                                        </span>
                                        <input asp-for="Username" class="form-control form-control-custom bg-light"
                                               readonly />
                                    </div>
                                    <small class="text-muted">
                                        <i class="fas fa-lock me-1"></i>Username cannot be changed
                                    </small>
                                </div>

                                <!-- Date of Birth -->
                                <div class="col-md-6">
                                    <label asp-for="DateOfBirth" class="form-label form-label-custom">
                                        Date of Birth
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="fas fa-calendar text-muted"></i>
                                        </span>
                                        <input asp-for="DateOfBirth" class="form-control form-control-custom"
                                               type="date" value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd"))" />
                                    </div>
                                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <hr class="section-divider">

                        <!-- Contact Information Section -->
                        <div class="mb-4">
                            <h6 class="text-primary mb-3">
                                <i class="fas fa-address-card me-2"></i>Contact Information
                            </h6>

                            <div class="row g-3">
                                <!-- Email -->
                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label form-label-custom">
                                        Email Address <span class="required-star">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="fas fa-envelope text-muted"></i>
                                        </span>
                                        <input asp-for="Email" class="form-control form-control-custom"
                                               type="email" placeholder="Enter email address" required />
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <!-- Phone Number -->
                                <div class="col-md-6">
                                    <label asp-for="PhoneNumber" class="form-label form-label-custom">
                                        Phone Number
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="fas fa-phone text-muted"></i>
                                        </span>
                                        <input asp-for="PhoneNumber" class="form-control form-control-custom"
                                               placeholder="Enter phone number" />
                                    </div>
                                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                </div>

                                <!-- Address -->
                                <div class="col-12">
                                    <label asp-for="Address" class="form-label form-label-custom">
                                        Address
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="fas fa-map-marker-alt text-muted"></i>
                                        </span>
                                        <textarea asp-for="Address" class="form-control form-control-custom"
                                                  rows="3" placeholder="Enter your address"></textarea>
                                    </div>
                                    <span asp-validation-for="Address" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <hr class="section-divider">

                        <!-- Account Info (Read-only) -->
                        <div class="info-card mb-4">
                            <h6 class="text-muted mb-3">
                                <i class="fas fa-info-circle me-2"></i>Account Information
                            </h6>
                            <div class="row">
                                <div class="col-md-4">
                                    <small class="text-muted">Account Status</small>
                                    <p class="mb-0">
                                        @if (Model.IsActive)
                                        {
                                            <span class="badge bg-success"><i class="fas fa-check me-1"></i>Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger"><i class="fas fa-times me-1"></i>Inactive</span>
                                        }
                                    </p>
                                </div>
                                <div class="col-md-4">
                                    <small class="text-muted">Member Since</small>
                                    <p class="mb-0 fw-semibold">@Model.CreatedDate.ToString("MMM dd, yyyy")</p>
                                </div>
                                <div class="col-md-4">
                                    <small class="text-muted">Last Login</small>
                                    <p class="mb-0 fw-semibold">
                                        @(Model.LastLoginDate?.ToString("MMM dd, yyyy hh:mm tt") ?? "Never")
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <a asp-action="Profile" class="btn btn-outline-secondary btn-cancel">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                            <div>
                                <button type="reset" class="btn btn-outline-warning me-2">
                                    <i class="fas fa-undo me-2"></i>Reset
                                </button>
                                <button type="submit" class="btn btn-primary btn-save">
                                    <i class="fas fa-save me-2"></i>Save Changes
                                </button>
                                
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Handle file selection (Same as Profile page)
        function handleProfilePictureSelect(input) {
            if (input.files && input.files[0]) {
                var file = input.files[0];

                // Validate file
                if (!validateFile(file)) {
                    input.value = '';
                    return;
                }

                // Preview image
                previewImage(file);

                // Upload via AJAX
                uploadProfilePicture(file);
            }
        }

        // Validate file
        function validateFile(file) {
            var maxSize = 5 * 1024 * 1024; // 5MB
            if (file.size > maxSize) {
                showMessage('File size must be less than 5MB', 'danger');
                return false;
            }

            var allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
            if (!allowedTypes.includes(file.type)) {
                showMessage('Only JPG, PNG, and GIF files are allowed', 'danger');
                return false;
            }

            return true;
        }

        // Preview image
        function previewImage(file) {
            var reader = new FileReader();

            reader.onload = function (e) {
                var preview = document.getElementById('profilePreview');
                var initial = document.getElementById('profileInitial');

                preview.src = e.target.result;
                preview.classList.remove('d-none');

                if (initial) {
                    initial.classList.add('d-none');
                }
            };

            reader.readAsDataURL(file);
        }

        // Upload profile picture via AJAX
        function uploadProfilePicture(file) {
            var formData = new FormData();
            formData.append('file', file);

            // Show progress
            document.getElementById('uploadProgress').classList.remove('d-none');
            document.getElementById('uploadMessage').innerHTML = '';

            $.ajax({
                url: '@Url.Action("UploadProfilePicture", "Account")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    document.getElementById('uploadProgress').classList.add('d-none');

                    if (response.success) {
                        showMessage('Profile picture updated successfully!', 'success');

                        // Update profile image
                        if (response.imageUrl) {
                            var timestamp = new Date().getTime();
                            var newImageUrl = response.imageUrl + '?t=' + timestamp;

                            // Update edit page preview
                            var preview = document.getElementById('profilePreview');
                            if (preview) {
                                preview.src = newImageUrl;
                                preview.classList.remove('d-none');
                            }

                            // Hide initials
                            var initial = document.getElementById('profileInitial');
                            if (initial) {
                                initial.classList.add('d-none');
                            }

                            // Update navbar profile picture
                            updateNavbarProfilePicture(newImageUrl);
                        }
                    } else {
                        showMessage(response.message || 'Failed to upload', 'danger');
                    }
                },
                error: function (xhr, status, error) {
                    document.getElementById('uploadProgress').classList.add('d-none');
                    showMessage('Error uploading profile picture', 'danger');
                    console.error('Upload error:', error);
                }
            });
        }

        // Remove profile picture
        function removeProfilePicture() {
            if (!confirm('Are you sure you want to remove your profile picture?')) {
                return;
            }

            // Show progress
            document.getElementById('uploadProgress').classList.remove('d-none');
            document.getElementById('uploadMessage').innerHTML = '';

            $.ajax({
                url: '@Url.Action("RemoveProfilePicture", "Account")',
                type: 'POST',
                success: function (response) {
                    document.getElementById('uploadProgress').classList.add('d-none');

                    if (response.success) {
                        showMessage('Profile picture removed successfully!', 'success');

                        // Hide profile image
                        var preview = document.getElementById('profilePreview');
                        if (preview) {
                            preview.classList.add('d-none');
                            preview.src = '';
                        }

                        // Show initials
                        var initial = document.getElementById('profileInitial');
                        if (initial) {
                            initial.classList.remove('d-none');
                        }

                        // Update navbar - show initials
                        showNavbarInitials();

                    } else {
                        showMessage(response.message || 'Failed to remove profile picture.', 'danger');
                    }
                },
                error: function (xhr, status, error) {
                    document.getElementById('uploadProgress').classList.add('d-none');
                    showMessage('Error removing profile picture', 'danger');
                    console.error('Remove error:', error);
                }
            });
        }

        // Update navbar profile picture
        function updateNavbarProfilePicture(imageUrl) {
            // Update navbar small image
            var navbarImg = document.getElementById('navbarProfileImg');
            if (navbarImg) {
                navbarImg.src = imageUrl;
                navbarImg.style.display = 'block';
                navbarImg.classList.remove('d-none');
            }

            // Hide navbar initials
            var navbarInitials = document.getElementById('navbarProfileInitials');
            if (navbarInitials) {
                navbarInitials.classList.add('d-none');
                navbarInitials.style.display = 'none';
            }

            // Update dropdown header image
            var dropdownImg = document.getElementById('dropdownProfileImg');
            if (dropdownImg) {
                dropdownImg.src = imageUrl;
                dropdownImg.style.display = 'block';
                dropdownImg.classList.remove('d-none');
            }

            // Hide dropdown initials
            var dropdownInitials = document.getElementById('dropdownProfileInitials');
            if (dropdownInitials) {
                dropdownInitials.classList.add('d-none');
                dropdownInitials.style.display = 'none';
            }

            console.log('Navbar profile picture updated:', imageUrl);
        }

        // Show navbar initials (for remove functionality)
        function showNavbarInitials() {
            // Hide navbar image
            var navbarImg = document.getElementById('navbarProfileImg');
            if (navbarImg) {
                navbarImg.classList.add('d-none');
                navbarImg.style.display = 'none';
            }

            // Show navbar initials
            var navbarInitials = document.getElementById('navbarProfileInitials');
            if (navbarInitials) {
                navbarInitials.classList.remove('d-none');
                navbarInitials.style.display = 'flex';
            }

            // Hide dropdown image
            var dropdownImg = document.getElementById('dropdownProfileImg');
            if (dropdownImg) {
                dropdownImg.classList.add('d-none');
                dropdownImg.style.display = 'none';
            }

            // Show dropdown initials
            var dropdownInitials = document.getElementById('dropdownProfileInitials');
            if (dropdownInitials) {
                dropdownInitials.classList.remove('d-none');
                dropdownInitials.style.display = 'flex';
            }

            console.log('Navbar initials shown');
        }

        // Show message
        function showMessage(message, type) {
            var alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            var icon = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle';

            var html = '<div class="alert ' + alertClass + ' alert-dismissible fade show py-2 mb-0" role="alert">' +
                '<i class="fas ' + icon + ' me-1"></i>' +
                '<small>' + message + '</small>' +
                '<button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>' +
                '</div>';

            document.getElementById('uploadMessage').innerHTML = html;

            setTimeout(function () {
                var alert = document.querySelector('#uploadMessage .alert');
                if (alert) {
                    alert.remove();
                }
            }, 5000);
        }

        // Form validation
        $(document).ready(function () {
            $('#editProfileForm').on('submit', function (e) {
                const form = this;
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                $(form).addClass('was-validated');
            });

            // Phone number formatting
            $('#PhoneNumber').on('input', function () {
                let value = $(this).val().replace(/\D/g, '');
                if (value.length > 10) {
                    value = value.substring(0, 10);
                }
                $(this).val(value);
            });
        });
    </script>
}