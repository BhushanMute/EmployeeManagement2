@{
    ViewData["Title"] = "Employee Report";
    var reportJson = ViewBag.ReportData as string ?? "{}";
    var apiSuccess = ViewBag.ApiSuccess ?? false;
}

@section Styles {
    <style>
        .report-hero {
            background: linear-gradient(135deg, #667eea, #764ba2);
            border-radius: 16px;
            padding: 30px;
            color: white;
        }

        .stat-glass {
            background: rgba(255,255,255,0.15);
            border-radius: 12px;
            padding: 15px;
            text-align: center;
        }

            .stat-glass .stat-value {
                font-size: 1.8rem;
                font-weight: 800;
            }

            .stat-glass .stat-label {
                font-size: 0.7rem;
                text-transform: uppercase;
                opacity: 0.8;
            }
    </style>
}

<div class="container-fluid">
    <div class="report-hero shadow-lg mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="fw-bold mb-0"><i class="fas fa-users me-2"></i>Employee Report</h2>
                <p class="opacity-75 mb-0">Comprehensive employee analytics</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-light btn-sm" style="border-radius: 20px;" onclick="window.print()">
                    <i class="fas fa-print me-1"></i>Print
                </button>
            </div>
        </div>

        <div class="row g-2" id="summaryStats"></div>
    </div>

    <!-- Department Distribution -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm" style="border-radius: 16px;">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="fw-bold mb-0"><i class="fas fa-building me-2 text-primary"></i>Department Distribution</h6>
                </div>
                <div class="card-body" id="deptDistribution"></div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm" style="border-radius: 16px;">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="fw-bold mb-0"><i class="fas fa-user-tag me-2 text-info"></i>Role Distribution</h6>
                </div>
                <div class="card-body" id="roleDistribution"></div>
            </div>
        </div>
    </div>

    <!-- Employee Table -->
    <div class="card border-0 shadow-sm" style="border-radius: 16px;">
        <div class="card-header bg-white border-0 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="fas fa-table me-2 text-primary"></i>Employee Details</h6>
                <input type="text" class="form-control form-control-sm" style="width: 200px; border-radius: 20px;"
                       placeholder="🔍 Search..." oninput="filterEmployeeTable(this.value)">
            </div>
        </div>
        <div class="card-body p-0" id="employeeTable"></div>
    </div>
</div>

@section Scripts {
    <script>
        var reportData = @Html.Raw(reportJson);

        document.addEventListener('DOMContentLoaded', function() {
            if (!reportData || !reportData.data) {
                document.getElementById('summaryStats').innerHTML = '<p class="text-white opacity-75">No data available</p>';
                return;
            }

            var data = reportData.data;
            var summary = data.summary || {};
            var employees = data.employees || [];
            var depts = data.departmentDistribution || [];
            var roles = data.roleDistribution || [];

            // Summary Stats
            var statsHtml = `
                <div class="col-6 col-md-3"><div class="stat-glass"><div class="stat-value">${summary.totalEmployees || 0}</div><div class="stat-label">Total Employees</div></div></div>
                <div class="col-6 col-md-3"><div class="stat-glass" style="border-left:3px solid #51cf66"><div class="stat-value" style="color:#51cf66">${summary.activeEmployees || 0}</div><div class="stat-label">Active</div></div></div>
                <div class="col-6 col-md-3"><div class="stat-glass"><div class="stat-value">₹${(summary.averageSalary || 0).toLocaleString('en-IN', {maximumFractionDigits: 0})}</div><div class="stat-label">Avg Salary</div></div></div>
                <div class="col-6 col-md-3"><div class="stat-glass"><div class="stat-value">${summary.newJoinersThisMonth || 0}</div><div class="stat-label">New This Month</div></div></div>
            `;
            document.getElementById('summaryStats').innerHTML = statsHtml;

            // Department Distribution
            var deptHtml = '';
            var maxEmp = Math.max(...depts.map(d => d.employeeCount || 0), 1);
            depts.forEach(function(dept) {
                var pct = Math.round((dept.employeeCount / maxEmp) * 100);
                deptHtml += `
                    <div class="d-flex align-items-center mb-3">
                        <div style="width:120px"><strong style="font-size:0.85rem">${dept.departmentName}</strong></div>
                        <div class="flex-grow-1 mx-2">
                            <div class="progress" style="height:8px;border-radius:10px">
                                <div class="progress-bar bg-primary" style="width:${pct}%;border-radius:10px"></div>
                            </div>
                        </div>
                        <div style="width:80px" class="text-end">
                            <strong>${dept.employeeCount}</strong>
                            <small class="text-muted">emp</small>
                        </div>
                    </div>`;
            });
            document.getElementById('deptDistribution').innerHTML = deptHtml || '<p class="text-muted">No data</p>';

            // Role Distribution
            var roleHtml = '';
            var roleColors = ['#4facfe', '#f5576c', '#43e97b', '#fa709a', '#667eea', '#ffd93d'];
            roles.forEach(function(role, idx) {
                var color = roleColors[idx % roleColors.length];
                roleHtml += `
                    <div class="d-flex justify-content-between align-items-center mb-2 p-2 rounded" style="background:#f8f9fc">
                        <div class="d-flex align-items-center">
                            <span style="width:10px;height:10px;border-radius:50%;background:${color}" class="me-2"></span>
                            <span style="font-size:0.85rem">${role.roleName}</span>
                        </div>
                        <strong>${role.employeeCount}</strong>
                    </div>`;
            });
            document.getElementById('roleDistribution').innerHTML = roleHtml || '<p class="text-muted">No data</p>';

            // Employee Table
            if (employees.length > 0) {
                var tableHtml = `
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="empTable">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Name</th>
                                    <th>Department</th>
                                    <th>Role</th>
                                    <th class="text-end">Salary</th>
                                    <th class="text-center">Age</th>
                                    <th class="text-center">Service</th>
                                    <th class="text-center">Leaves</th>
                                    <th class="text-center">Status</th>
                                </tr>
                            </thead>
                            <tbody>`;

                employees.forEach(function(emp) {
                    var statusBadge = emp.isActive
                        ? '<span class="badge bg-success">Active</span>'
                        : '<span class="badge bg-danger">Inactive</span>';

                    tableHtml += `
                        <tr class="emp-row-filter">
                            <td class="ps-4">
                                <strong>${emp.name}</strong><br>
                                <small class="text-muted">${emp.email || ''}</small>
                            </td>
                            <td>${emp.departmentName || '-'}</td>
                            <td><span class="badge bg-light text-dark border">${emp.role || '-'}</span></td>
                            <td class="text-end fw-bold">₹${(emp.salary || 0).toLocaleString('en-IN')}</td>
                            <td class="text-center">${emp.age || '-'}</td>
                            <td class="text-center">${emp.yearsOfService || 0} yr</td>
                            <td class="text-center">
                                <span class="text-primary fw-bold">${emp.leaveDaysThisYear || 0}</span>
                                <small class="text-muted">days</small>
                            </td>
                            <td class="text-center">${statusBadge}</td>
                        </tr>`;
                });

                tableHtml += '</tbody></table></div>';
                document.getElementById('employeeTable').innerHTML = tableHtml;
            } else {
                document.getElementById('employeeTable').innerHTML = '<div class="text-center py-5 text-muted"><i class="fas fa-inbox fa-3x mb-3"></i><h5>No employees found</h5></div>';
            }
        });

        function filterEmployeeTable(term) {
            var rows = document.querySelectorAll('.emp-row-filter');
            rows.forEach(function(row) {
                row.style.display = row.textContent.toLowerCase().includes(term.toLowerCase()) ? '' : 'none';
            });
        }
    </script>
}