@model IEnumerable<EmployeeManagement.UI.Models.SalaryTemplate>
@{
    ViewData["Title"] = "Salary Templates | वेतन टेम्पलेट्स";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Salary Templates <small class="text-muted fs-5">| वेतन टेम्पलेट्स</small></h2>
        <div>
            <a asp-action="AssignSalary" class="btn btn-outline-primary me-2">
                <i class="fas fa-user-tag"></i> Assign Salary
            </a>
            <a asp-action="BulkAssignSalary" class="btn btn-outline-info">
                <i class="fas fa-users-cog"></i> Bulk Assign
            </a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body table-responsive">
            <table class="table table-hover table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Code / कोड</th>
                        <th>Template Name / नाव</th>
                        <th>Description / वर्णन</th>
                        <th>Status / स्थिती</th>
                        <th>Actions / कृती</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int sr = 1;
                        foreach (var template in Model)
                        {
                            <tr>
                                <td>@sr</td>
                                <td><code>@template.TemplateCode</code></td>
                                <td class="fw-bold">@template.TemplateName</td>
                                <td>@(template.Description ?? "-")</td>
                                <td>
                                    @if (template.IsActive)
                                    {
                                        <span class="badge bg-success">Active / सक्रिय</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive / निष्क्रिय</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="TemplateDetails"
                                       asp-route-templateId="@template.Id"
                                       class="btn btn-sm btn-info text-white">
                                        <i class="fas fa-eye"></i> View Details
                                    </a>
                                </td>
                            </tr>
                            sr++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="fas fa-folder-open fa-2x mb-2 d-block"></i>
                                No templates found. / कोणतेही टेम्पलेट आढळले नाही.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>