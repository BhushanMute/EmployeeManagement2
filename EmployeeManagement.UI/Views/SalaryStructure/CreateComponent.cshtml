@model EmployeeManagement.API.Models.Payroll.SalaryComponent
@{
    ViewData["Title"] = "Create Salary Component | नवीन वेतन घटक";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Create Salary Component / नवीन वेतन घटक</h4>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }

                    <form asp-action="CreateComponent" method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Component Name / घटकाचे नाव <span class="text-danger">*</span></label>
                                <input asp-for="ComponentName" class="form-control" required />
                                <span asp-validation-for="ComponentName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Component Type / प्रकार <span class="text-danger">*</span></label>
                                <select asp-for="ComponentType" class="form-select" required>
                                    <option value="">-- Select Type --</option>
                                    <option value="Earning">Earning / मिळकत</option>
                                    <option value="Deduction">Deduction / कपात</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Calculation Type / गणना प्रकार</label>
                                <select asp-for="CalculationType" class="form-select" id="calcType">
                                    <option value="Flat">Flat Amount / निश्चित रक्कम</option>
                                    <option value="Percentage">Percentage (Basic) / टक्केवारी</option>
                                </select>
                            </div>
                            <div class="col-md-6" id="percentageDiv" style="display:none;">
                                <label class="form-label fw-bold">Percentage Value (%) / टक्केवारी मूल्य</label>
                                <input asp-for="DefaultPercentage" type="number" step="0.01" class="form-control" />
                            </div>

                            <div class="col-md-6 mt-4">
                                <div class="form-check form-switch">
                                    <input asp-for="IsTaxable" class="form-check-input" type="checkbox" role="switch" checked>
                                    <label class="form-check-label fw-bold">Is Taxable? / करपात्र आहे का?</label>
                                </div>
                            </div>
                            <div class="col-md-6 mt-4">
                                <div class="form-check form-switch">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" checked>
                                    <label class="form-check-label fw-bold">Is Active? / सक्रिय आहे का?</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Components" class="btn btn-secondary">Cancel / रद्द करा</a>
                            <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> Save / जतन करा</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#calcType').change(function() {
                if($(this).val() === 'Percentage') {
                    $('#percentageDiv').show();
                } else {
                    $('#percentageDiv').hide();
                }
            }).trigger('change');
        });
    </script>
}