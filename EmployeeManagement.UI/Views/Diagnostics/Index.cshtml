</div>

@section Scripts {
    <script>
        var diagnosticsData = null;

        $(document).ready(function () {
            loadDiagnostics();
        });

        function loadDiagnostics() {
            $('#loadingSpinner').removeClass('d-none');
            $('#diagnosticsContent').addClass('d-none');
            $('#errorAlert').addClass('d-none');
            $('#refreshIcon').addClass('refresh-spin');

            $.ajax({
                url: '@Url.Action("GetDiagnostics", "Diagnostics")',
                type: 'GET',
                success: function (data) {
                    diagnosticsData = data;
                    displayDiagnostics(data);
                    $('#loadingSpinner').addClass('d-none');
                    $('#diagnosticsContent').removeClass('d-none');
                    $('#refreshIcon').removeClass('refresh-spin');
                    $('#lastUpdated').text(new Date().toLocaleString());
                },
                error: function (xhr, status, error) {
                    $('#loadingSpinner').addClass('d-none');
                    $('#errorAlert').removeClass('d-none');
                    $('#errorMessage').text(error || 'Failed to load diagnostics data. Check if the GetDiagnostics action exists.');
                    $('#refreshIcon').removeClass('refresh-spin');
                }
            });
        }

        function displayDiagnostics(data) {
            // Raw JSON
            $('#rawJsonData').text(JSON.stringify(data, null, 2));

            // 1. System Information
            if (data.system) {
                $('#machineName').text(data.system.machineName || 'N/A');
                $('#osVersion').text(data.system.osVersion || 'N/A');
                $('#processorCount').text(data.system.processorCount || 'N/A');
                $('#dotnetVersion').text(data.system.dotnetVersion || 'N/A');
                $('#uptime').text(data.system.uptime || 'N/A');
                $('#workingSet').text(data.system.workingSet || 'N/A');
                $('#currentDirectory').text(data.system.currentDirectory || 'N/A');
            }

            // 2. Environment
            if (data.environment) {
                let envBadge = data.environment.isDevelopment
                    ? '<span class="badge bg-warning text-dark">Development</span>'
                    : '<span class="badge bg-success">Production</span>';
                $('#environmentName').html(envBadge + ' <small>(' + (data.environment.environmentName || '') + ')</small>');
                $('#isDevelopment').html(data.environment.isDevelopment
                    ? '<span class="badge bg-success">Yes</span>'
                    : '<span class="badge bg-secondary">No</span>');
                $('#contentRootPath').text(data.environment.contentRootPath || 'N/A');
                $('#webRootPath').text(data.environment.webRootPath || 'N/A');
            }

            // 3. Authentication
            if (data.authentication) {
                $('#isAuthenticated').html(data.authentication.isAuthenticated
                    ? '<span class="badge bg-success"><i class="bi bi-check-lg"></i> Yes</span>'
                    : '<span class="badge bg-danger"><i class="bi bi-x-lg"></i> No</span>');
                $('#authenticationType').text(data.authentication.authenticationType || 'None');
                $('#userName').text(data.authentication.userName || 'Anonymous');
                $('#userId').text(data.authentication.userId || 'N/A');
                $('#email').text(data.authentication.email || 'N/A');

                // Roles
                if (data.authentication.roles && data.authentication.roles.length > 0) {
                    let rolesHtml = data.authentication.roles.map(r =>
                        '<span class="badge bg-info me-1">' + r + '</span>').join('');
                    $('#roles').html(rolesHtml);
                } else {
                    $('#roles').html('<span class="text-muted">No roles assigned</span>');
                }

                // Claims
                let claimsHtml = '';
                if (data.authentication.claims && data.authentication.claims.length > 0) {
                    data.authentication.claims.forEach(function (claim) {
                        claimsHtml += '<tr><td class="claim-type"><code>' + claim.type + '</code></td><td>' + claim.value + '</td></tr>';
                    });
                } else {
                    claimsHtml = '<tr><td colspan="2" class="text-muted text-center">No claims found</td></tr>';
                }
                $('#claimsTableBody').html(claimsHtml);

                // Auth check status
                $('#authCheckStatus').html(data.authentication.isAuthenticated
                    ? '<span class="badge bg-success">✓ OK</span>'
                    : '<span class="badge bg-warning">Not Logged In</span>');
            }

            // 4. Session
            if (data.session) {
                $('#sessionId').text(data.session.sessionId || 'N/A');
                $('#sessionAvailable').html(data.session.isAvailable
                    ? '<span class="badge bg-success">Yes</span>'
                    : '<span class="badge bg-danger">No</span>');
                $('#hasToken').html(data.session.hasToken
                    ? '<span class="badge bg-success"><i class="bi bi-check-lg"></i> Yes</span>'
                    : '<span class="badge bg-danger"><i class="bi bi-x-lg"></i> No</span>');
                $('#tokenExpiry').text(data.session.tokenExpiry || 'N/A');
                $('#tokenPreview').text(data.session.tokenPreview || 'N/A');

                // Session Keys
                if (data.session.keys && data.session.keys.length > 0) {
                    let keysHtml = data.session.keys.map(k =>
                        '<span class="badge bg-secondary me-1">' + k + '</span>').join('');
                    $('#sessionKeys').html(keysHtml);
                } else {
                    $('#sessionKeys').html('<span class="text-muted">No session keys</span>');
                }
            }

            // 5. Configuration
            if (data.configuration) {
                $('#apiBaseUrl').text(data.configuration.apiBaseUrl || 'N/A');
                $('#uiBaseUrl').text(data.configuration.uiBaseUrl || 'N/A');
                $('#connectionStringConfigured').html(data.configuration.connectionStringConfigured === 'Yes'
                    ? '<span class="badge bg-success">✓ Configured</span>'
                    : '<span class="badge bg-danger">✗ Not Configured</span>');
                $('#loggingLevel').text(data.configuration.loggingLevel || 'N/A');
                $('#sessionTimeout').text(data.configuration.sessionTimeout || 'N/A');
            }

            // 6. Database
            if (data.database) {
                $('#dbStatus').html(data.database.status && data.database.status.includes('✓')
                    ? '<span class="badge bg-success">' + data.database.status + '</span>'
                    : '<span class="badge bg-danger">' + (data.database.status || 'Unknown') + '</span>');
                $('#dbServer').text(data.database.server || 'N/A');
                $('#dbName').text(data.database.database || 'N/A');
                $('#dbConnected').html(data.database.connected
                    ? '<span class="badge bg-success">Yes</span>'
                    : '<span class="badge bg-danger">No</span>');
                $('#dbCheckStatus').html(data.database.connected
                    ? '<span class="badge bg-success">✓ OK</span>'
                    : '<span class="badge bg-danger">✗ Error</span>');
            }

            // 7. Security
            if (data.security) {
                $('#isHttps').html(data.security.isHttps
                    ? '<span class="badge bg-success"><i class="bi bi-lock-fill"></i> Yes</span>'
                    : '<span class="badge bg-warning"><i class="bi bi-unlock"></i> No</span>');
                $('#tlsVersion').text(data.security.tlsVersion || 'N/A');
                $('#hasCors').html(data.security.hasCors
                    ? '<span class="badge bg-success">Enabled</span>'
                    : '<span class="badge bg-secondary">Not Set</span>');
                $('#hasAntiForgery').html(data.security.hasAntiForgeryToken
                    ? '<span class="badge bg-success">Present</span>'
                    : '<span class="badge bg-secondary">Not Found</span>');
                $('#cookieCount').text(data.security.cookieCount || '0');
            }

            // 8. Request
            if (data.request) {
                $('#requestScheme').html(data.request.scheme === 'https'
                    ? '<span class="badge bg-success">HTTPS</span>'
                    : '<span class="badge bg-warning">HTTP</span>');
                $('#requestHost').text(data.request.host || 'N/A');
                $('#requestPath').text(data.request.path || '/');
                $('#requestMethod').html('<span class="badge bg-primary">' + (data.request.method || 'GET') + '</span>');
                $('#requestProtocol').text(data.request.protocol || 'N/A');
                $('#clientIp').text(data.request.clientIp || 'N/A');
                $('#userAgent').text(data.request.userAgent || 'N/A');

                // Headers
                let headersHtml = '';
                if (data.request.headers) {
                    for (let header in data.request.headers) {
                        headersHtml += '<tr><td><code>' + header + '</code></td><td class="header-value">' +
                                      data.request.headers[header] + '</td></tr>';
                    }
                }
                $('#headersTableBody').html(headersHtml || '<tr><td colspan="2">No headers</td></tr>');
            }

            // 9. Services Status
            if (data.servicesStatus) {
                let servicesHtml = '<div class="row">';
                for (let service in data.servicesStatus) {
                    let svc = data.servicesStatus[service];
                    let isSuccess = svc.status && svc.status.includes('✓');
                    let statusClass = isSuccess ? 'success' : 'danger';
                    let statusIcon = isSuccess ? 'check-circle-fill' : 'x-circle-fill';

                    servicesHtml += `
                        <div class="col-md-6 mb-3">
                            <div class="card service-card border-${statusClass}">
                                <div class="card-header bg-${statusClass} text-white py-2">
                                    <i class="bi bi-${statusIcon} me-2"></i>
                                    <strong>${service}</strong>
                                </div>
                                <div class="card-body py-2">
                                    <table class="table table-sm table-borderless mb-0">
                                        <tr>
                                            <td><strong>Status:</strong></td>
                                            <td>${svc.status || 'Unknown'}</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Code:</strong></td>
                                            <td><span class="badge bg-${isSuccess ? 'success' : 'danger'}">${svc.statusCode || 'N/A'}</span></td>
                                        </tr>
                                        <tr>
                                            <td><strong>URL:</strong></td>
                                            <td style="font-size: 0.8em; word-break: break-all;">
                                                <code>${svc.url || 'N/A'}</code>
                                            </td>
                                        </tr>
                                        ${svc.responseTime ? `<tr><td><strong>Response:</strong></td><td>${svc.responseTime}</td></tr>` : ''}
                                        ${svc.error ? `<tr><td colspan="2" class="text-danger"><small><strong>Error:</strong> ${svc.error}</small></td></tr>` : ''}
                                    </table>
                                </div>
                            </div>
                        </div>
                    `;
                }
                servicesHtml += '</div>';
                $('#servicesStatusContainer').html(servicesHtml);

                // API check status
                let apiHealth = data.servicesStatus['API Health'];
                if (apiHealth) {
                    $('#apiCheckStatus').html(apiHealth.status && apiHealth.status.includes('✓')
                        ? '<span class="badge bg-success">✓ OK</span>'
                        : '<span class="badge bg-danger">✗ Error</span>');
                }
            }

            // 10. Performance
            if (data.performance) {
                $('#appUptime').text(data.performance.applicationUptime || 'N/A');
                $('#currentMemory').text(data.performance.currentMemoryUsage || 'N/A');
                if (data.performance.gcCollections) {
                    $('#gcGen0').text(data.performance.gcCollections.gen0 || '0');
                    $('#gcGen1').text(data.performance.gcCollections.gen1 || '0');
                    $('#gcGen2').text(data.performance.gcCollections.gen2 || '0');
                }
            }
        }

        function clearSession() {
            if (confirm('Are you sure you want to clear the session? You will need to login again.')) {
                $.ajax({
                    url: '@Url.Action("ClearSession", "Diagnostics")',
                    type: 'POST',
                    success: function (data) {
                        alert(data.message || 'Session cleared successfully!');
                        loadDiagnostics();
                    },
                    error: function () {
                        alert('Failed to clear session');
                    }
                });
            }
        }

        function clearCache() {
            if (confirm('Are you sure you want to clear the cache?')) {
                $.ajax({
                    url: '@Url.Action("ClearCache", "Diagnostics")',
                    type: 'POST',
                    success: function (data) {
                        alert(data.message || 'Cache cleared successfully!');
                        loadDiagnostics();
                    },
                    error: function () {
                        alert('Failed to clear cache');
                    }
                });
            }
        }

        function downloadReport() {
            if (!diagnosticsData) {
                alert('Please wait for diagnostics data to load');
                return;
            }

            let report = {
                generatedAt: new Date().toISOString(),
                diagnostics: diagnosticsData
            };

            let dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(report, null, 2));
            let downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", "diagnostics_report_" + new Date().toISOString().slice(0, 10) + ".json");
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
        }
             function loadApiStatus() {
            $('#apiRefreshIcon').addClass('refresh-spin');
            $('#apiSummaryCards').html('<div class="text-center py-4"><div class="spinner-border text-primary"></div><p class="mt-2">Testing all API endpoints...</p></div>');
            $('#apiResultsTable').html('');

            $.ajax({
                url: '@Url.Action("GetAllApiStatus", "Diagnostics")',
                type: 'GET',
                success: function (data) {
                    displayApiStatus(data);
                    $('#apiRefreshIcon').removeClass('refresh-spin');
                },
                error: function (xhr, status, error) {
                    $('#apiSummaryCards').html('<div class="alert alert-danger">Failed to load API status: ' + error + '</div>');
                    $('#apiRefreshIcon').removeClass('refresh-spin');
                }
            });
        }

        function displayApiStatus(data) {
            var summary = data.summary;
            var results = data.results;

            // Summary Cards
            var successRate = summary.totalEndpoints > 0
                ? Math.round((summary.successCount / summary.totalEndpoints) * 100) : 0;
            var successColor = successRate >= 90 ? 'success' : successRate >= 70 ? 'warning' : 'danger';

            var summaryHtml = `
                <div class="col-md-2 col-6">
                    <div class="card border-0 shadow-sm text-center p-3" style="border-radius:12px;">
                        <div class="fw-bold fs-3 text-primary">${summary.totalEndpoints}</div>
                        <small class="text-muted">Total APIs</small>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card border-0 shadow-sm text-center p-3" style="border-radius:12px;">
                        <div class="fw-bold fs-3 text-success">${summary.successCount}</div>
                        <small class="text-muted">✅ Success</small>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card border-0 shadow-sm text-center p-3" style="border-radius:12px;">
                        <div class="fw-bold fs-3 text-danger">${summary.failedCount}</div>
                        <small class="text-muted">❌ Failed</small>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card border-0 shadow-sm text-center p-3" style="border-radius:12px; border-left:4px solid ${successRate >= 90 ? '#28a745' : '#dc3545'} !important;">
                        <div class="fw-bold fs-3 text-${successColor}">${successRate}%</div>
                        <small class="text-muted">Success Rate</small>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card border-0 shadow-sm text-center p-3" style="border-radius:12px;">
                        <div class="fw-bold fs-3">${summary.averageResponseTime}ms</div>
                        <small class="text-muted">Avg Response</small>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card border-0 shadow-sm text-center p-3" style="border-radius:12px;">
                        <div class="fw-bold fs-3">${summary.totalResponseTime}ms</div>
                        <small class="text-muted">Total Time</small>
                    </div>
                </div>`;
            $('#apiSummaryCards').html(summaryHtml);

            // Category Filter
            var categories = [...new Set(results.map(r => r.category))];
            var filterHtml = '<button class="btn btn-sm btn-primary active" onclick="filterByCategory(\'all\', this)">All (' + results.length + ')</button>';
            categories.forEach(function(cat) {
                var count = results.filter(r => r.category === cat).length;
                filterHtml += `<button class="btn btn-sm btn-outline-primary" onclick="filterByCategory('${cat}', this)">${cat} (${count})</button>`;
            });
            $('#categoryFilter').html('<div class="d-flex flex-wrap gap-2">' + filterHtml + '</div>').show();

            // Results Table
            var tableHtml = `
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="apiTable">
                        <thead style="background: linear-gradient(135deg, #667eea, #764ba2); color: white;">
                            <tr>
                                <th class="border-0 ps-3">API Endpoint</th>
                                <th class="border-0">Category</th>
                                <th class="border-0 text-center">Status</th>
                                <th class="border-0 text-center">Code</th>
                                <th class="border-0 text-center">Response Time</th>
                                <th class="border-0 text-center">Size</th>
                                <th class="border-0 text-center">Records</th>
                                <th class="border-0 text-center">Performance</th>
                            </tr>
                        </thead>
                        <tbody>`;

            results.forEach(function (r) {
                var timeColor = r.responseTimeMs < 50 ? 'success' : r.responseTimeMs < 200 ? 'warning' : 'danger';
                var statusBadge = r.isSuccess
                    ? `<span class="badge bg-success">✅ OK</span>`
                    : `<span class="badge bg-danger">❌ Fail</span>`;
                var timeBar = r.isSuccess ? Math.min(r.responseTimeMs / 5, 100) : 0;
                var perfRating = r.responseTimeMs < 20 ? '⚡' : r.responseTimeMs < 50 ? '🟢' : r.responseTimeMs < 100 ? '✅' : r.responseTimeMs < 200 ? '🟡' : r.responseTimeMs < 500 ? '🟠' : '🔴';

                tableHtml += `
                    <tr class="api-row" data-category="${r.category}">
                        <td class="ps-3">
                            <strong style="font-size:0.85rem;">${r.name}</strong>
                            <br><code style="font-size:0.7rem;" class="text-muted">${r.method} ${r.url}</code>
                        </td>
                        <td><span class="badge bg-light text-dark border">${r.category}</span></td>
                        <td class="text-center">${statusBadge}</td>
                        <td class="text-center"><span class="badge bg-${r.isSuccess ? 'success' : 'danger'}">${r.statusCode}</span></td>
                        <td class="text-center">
                            <strong class="text-${timeColor}">${r.responseTimeMs}ms</strong>
                            <div class="progress mt-1" style="height:4px;width:80px;margin:0 auto;">
                                <div class="progress-bar bg-${timeColor}" style="width:${timeBar}%"></div>
                            </div>
                        </td>
                        <td class="text-center"><small>${r.responseSize || '-'}</small></td>
                        <td class="text-center">${r.recordCount !== null ? '<strong>' + r.recordCount + '</strong>' : '-'}</td>
                        <td class="text-center" style="font-size:1.2rem;">${r.isSuccess ? perfRating : '❌'}</td>
                    </tr>`;

                if (r.error) {
                    tableHtml += `<tr class="api-row" data-category="${r.category}"><td colspan="8" class="text-danger ps-5"><small>⚠️ ${r.error}</small></td></tr>`;
                }
            });

            tableHtml += '</tbody></table></div>';
            $('#apiResultsTable').html(tableHtml);
        }

        function filterByCategory(category, btn) {
            $('#categoryFilter .btn').removeClass('active btn-primary').addClass('btn-outline-primary');
            $(btn).removeClass('btn-outline-primary').addClass('active btn-primary');

            if (category === 'all') {
                $('.api-row').show();
            } else {
                $('.api-row').hide();
                $(`.api-row[data-category="${category}"]`).show();
            }
        }

        // =============================================
        // ✅ BENCHMARK
        // =============================================
        function runBenchmark() {
            $('#btnBenchmark').prop('disabled', true).html('<i class="bi bi-hourglass-split"></i> Running...');
            $('#benchmarkResults').html('<div class="text-center py-4"><div class="spinner-border text-warning"></div><p class="mt-2">Running performance benchmark... (3 iterations per endpoint)</p></div>');

            // Switch to benchmark tab
            $('a[href="#benchmarkTab"]').tab('show');

            $.ajax({
                url: '@Url.Action("RunPerformanceBenchmark", "Diagnostics")',
                type: 'GET',
                success: function (data) {
                    displayBenchmark(data);
                    $('#btnBenchmark').prop('disabled', false).html('<i class="bi bi-speedometer2"></i> Run Benchmark');
                },
                error: function () {
                    $('#benchmarkResults').html('<div class="alert alert-danger">Benchmark failed</div>');
                    $('#btnBenchmark').prop('disabled', false).html('<i class="bi bi-speedometer2"></i> Run Benchmark');
                }
            });
        }

        function displayBenchmark(data) {
            var summary = data.summary;
            var benchmarks = data.benchmarks;
            var cacheTests = data.cacheTests;

            var html = `
                <!-- Summary -->
                <div class="card border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, #1a1a2e, #16213e); color:white; border-radius:16px;">
                    <div class="card-body p-4">
                        <div class="row text-center">
                            <div class="col-md-2 col-4">
                                <div class="fs-2 fw-bold">${summary.performanceRating}</div>
                                <small class="opacity-75">Overall Rating</small>
                            </div>
                            <div class="col-md-2 col-4">
                                <div class="fs-3 fw-bold">${summary.averageTimeMs}ms</div>
                                <small class="opacity-75">Average Time</small>
                            </div>
                            <div class="col-md-2 col-4">
                                <div class="fs-3 fw-bold">${summary.fastestTimeMs}ms</div>
                                <small class="opacity-75">Fastest</small>
                            </div>
                            <div class="col-md-2 col-4">
                                <div class="fs-3 fw-bold text-warning">${summary.slowestTimeMs}ms</div>
                                <small class="opacity-75">Slowest</small>
                            </div>
                            <div class="col-md-2 col-4">
                                <div class="fs-3 fw-bold">${summary.totalTests}</div>
                                <small class="opacity-75">Tests Run</small>
                            </div>
                            <div class="col-md-2 col-4">
                                <div class="fs-3 fw-bold">${summary.totalTimeMs}ms</div>
                                <small class="opacity-75">Total Time</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Benchmark Table -->
                <h6 class="fw-bold mb-3"><i class="bi bi-bar-chart me-2"></i>GET Operations Performance (3 iterations each)</h6>
                <div class="table-responsive mb-4">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>API Endpoint</th>
                                <th class="text-center">Min</th>
                                <th class="text-center">Max</th>
                                <th class="text-center">Average</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Rating</th>
                                <th>Performance Bar</th>
                            </tr>
                        </thead>
                        <tbody>`;

            var maxTime = Math.max(...benchmarks.map(b => b.averageTimeMs), 1);

            benchmarks.sort((a, b) => a.averageTimeMs - b.averageTimeMs);
            benchmarks.forEach(function(b) {
                var barPct = Math.round((b.averageTimeMs / maxTime) * 100);
                var barColor = b.averageTimeMs < 50 ? '#28a745' : b.averageTimeMs < 200 ? '#ffc107' : '#dc3545';

                html += `
                    <tr>
                        <td>
                            <strong>${b.name}</strong>
                            <br><code style="font-size:0.65rem;" class="text-muted">${b.url}</code>
                        </td>
                        <td class="text-center">${b.minTimeMs}ms</td>
                        <td class="text-center">${b.maxTimeMs}ms</td>
                        <td class="text-center fw-bold" style="color:${barColor}">${b.averageTimeMs}ms</td>
                        <td class="text-center">${b.success ? '<span class="badge bg-success">✅</span>' : '<span class="badge bg-danger">❌</span>'}</td>
                        <td class="text-center">${b.rating}</td>
                        <td style="min-width:150px;">
                            <div class="progress" style="height:8px;border-radius:10px;">
                                <div class="progress-bar" style="width:${barPct}%;background:${barColor};border-radius:10px;"></div>
                            </div>
                        </td>
                    </tr>`;
            });

            html += '</tbody></table></div>';

            // Cache Effectiveness
            if (cacheTests && cacheTests.length > 0) {
                html += `<h6 class="fw-bold mb-3"><i class="bi bi-lightning me-2"></i>Cache Effectiveness (Cold vs Warm)</h6>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>Endpoint</th>
                                    <th class="text-center">Cold (1st Call)</th>
                                    <th class="text-center">Warm (2nd Call)</th>
                                    <th class="text-center">Improvement</th>
                                    <th class="text-center">Cache Working?</th>
                                </tr>
                            </thead>
                            <tbody>`;

                cacheTests.forEach(function(c) {
                    html += `
                        <tr>
                            <td><strong>${c.name}</strong></td>
                            <td class="text-center">${c.coldTimeMs}ms</td>
                            <td class="text-center fw-bold text-success">${c.warmTimeMs}ms</td>
                            <td class="text-center">
                                <span class="badge ${c.improvementPercent > 0 ? 'bg-success' : 'bg-warning'}">
                                    ${c.improvementPercent > 0 ? '↓' : '↑'} ${Math.abs(c.improvementPercent)}%
                                </span>
                            </td>
                            <td class="text-center">${c.isCacheEffective ? '✅ Yes' : '⚠️ No'}</td>
                        </tr>`;
                });

                html += '</tbody></table></div>';
            }

            $('#benchmarkResults').html(html);
        }

        // =============================================
        // ✅ CUSTOM API TEST
        // =============================================
        $('#customMethod').change(function() {
            $('#postBodySection').toggle($(this).val() === 'POST' || $(this).val() === 'PUT');
        });

        function quickTest(url) {
            $('#customUrl').val(url);
            $('#customMethod').val('GET');
            testCustomEndpoint();
        }

        function testCustomEndpoint() {
            var url = $('#customUrl').val();
            var method = $('#customMethod').val();
            var repeat = parseInt($('#customRepeat').val()) || 1;
            var body = $('#customBody').val();

            if (!url) { alert('Please enter a URL'); return; }

            $('#customTestResults').html('<div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div> Testing...</div>');

            var results = [];
            var completed = 0;

            for (var i = 0; i < repeat; i++) {
                (function(iteration) {
                    $.ajax({
                        url: '@Url.Action("TestSingleEndpoint", "Diagnostics")',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ url: url, method: method, body: body }),
                        success: function(data) {
                            data.iteration = iteration + 1;
                            results.push(data);
                            completed++;
                            if (completed === repeat) displayCustomResults(results);
                        },
                        error: function() {
                            results.push({ success: false, error: 'Request failed', iteration: iteration + 1 });
                            completed++;
                            if (completed === repeat) displayCustomResults(results);
                        }
                    });
                })(i);
            }
        }

        function displayCustomResults(results) {
            var avgTime = results.filter(r => r.success).reduce((s, r) => s + r.responseTimeMs, 0) / Math.max(results.filter(r => r.success).length, 1);

            var html = `
                <div class="card border-0 shadow-sm" style="border-radius:12px;">
                    <div class="card-header bg-light">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong><i class="bi bi-terminal me-2"></i>Test Results — ${results[0]?.method || 'GET'} ${results[0]?.url || ''}</strong>
                            <span class="badge ${results.every(r => r.success) ? 'bg-success' : 'bg-danger'}">
                                ${results.filter(r => r.success).length}/${results.length} Success
                            </span>
                        </div>
                    </div>
                    <div class="card-body">
                        ${results.length > 1 ? `<div class="alert alert-info py-2 mb-3"><strong>Average Response Time:</strong> ${Math.round(avgTime)}ms</div>` : ''}
                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Status</th>
                                        <th>Code</th>
                                        <th>Time</th>
                                        <th>Size</th>
                                        <th>Timestamp</th>
                                    </tr>
                                </thead>
                                <tbody>`;

            results.forEach(function(r) {
                html += `
                    <tr>
                        <td>${r.iteration || 1}</td>
                        <td>${r.success ? '<span class="badge bg-success">✅ OK</span>' : '<span class="badge bg-danger">❌ Fail</span>'}</td>
                        <td><span class="badge bg-${r.success ? 'success' : 'danger'}">${r.statusCode || 'Error'}</span></td>
                        <td><strong>${r.responseTimeMs || 0}ms</strong></td>
                        <td>${r.responseSize || '-'}</td>
                        <td><small class="text-muted">${r.timestamp || '-'}</small></td>
                    </tr>`;
            });

            html += `</tbody></table></div>`;

            // Show response preview for first result
            if (results[0]?.responsePreview) {
                html += `
                    <div class="mt-3">
                        <h6>
                            <i class="bi bi-code-slash me-1"></i>Response Preview
                            <button class="btn btn-sm btn-outline-secondary ms-2" type="button" data-bs-toggle="collapse" data-bs-target="#responsePreview">Show/Hide</button>
                        </h6>
                        <div class="collapse" id="responsePreview">
                            <pre style="max-height:200px;overflow:auto;background:#f8f9fa;padding:10px;border-radius:8px;font-size:0.75rem;">${results[0].responsePreview}</pre>
                        </div>
                    </div>`;
            }

            html += '</div></div>';
            $('#customTestResults').html(html);
        }
    </script>
}