@model EmployeeManagement.UI.ViewModels.PagedResultViewModel<EmployeeManagement.UI.ViewModels.LeaveRequestViewModel>
@{
    ViewData["Title"] = "Team Leave History";
    var selectedYear = (int)ViewBag.SelectedYear;
    var selectedStatus = ViewBag.SelectedStatus as string;
    var currentPage = (int)ViewBag.CurrentPage;
}

@section Styles {
    <style>
        body {
            background: #f4f6f9;
        }

        .page-hero {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 2rem;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
            margin-bottom: 1.5rem;
        }

        .filter-card {
            background: white;
            border-radius: 14px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .data-card {
            background: white;
            border-radius: 14px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            border: none;
            overflow: hidden;
        }

        .table-modern thead th {
            background: #f8fafc;
            color: #475569;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 1rem;
            border-bottom: 2px solid #e2e8f0;
        }

        .table-modern tbody tr {
            transition: all 0.2s;
        }

            .table-modern tbody tr:hover {
                background: #f8fafc;
                transform: scale(1.005);
            }

        .table-modern td {
            padding: 1rem;
            vertical-align: middle;
            font-size: 0.9rem;
        }

        .employee-avatar-sm {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.85rem;
        }

        .status-badge {
            padding: 0.4rem 0.85rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .status-pending {
            background: #fef3c7;
            color: #92400e;
        }

        .status-approved {
            background: #d1fae5;
            color: #065f46;
        }

        .status-rejected {
            background: #fee2e2;
            color: #991b1b;
        }

        .status-cancelled {
            background: #f1f5f9;
            color: #475569;
        }

        .pagination .page-link {
            border-radius: 8px;
            margin: 0 3px;
            border: 1px solid #e2e8f0;
            color: #475569;
        }

        .pagination .page-item.active .page-link {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-color: transparent;
        }
    </style>
}

<div class="container-fluid px-4 py-3 pb-5">

    <!-- Hero -->
    <div class="page-hero">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h2 class="fw-bold mb-1">
                    <i class="bi bi-people-fill me-2"></i>Team Leave History
                </h2>
                <p class="mb-0 opacity-90">
                    View and manage all team leave requests
                </p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="PendingApprovals" class="btn btn-warning">
                    <i class="bi bi-clipboard-check me-1"></i>Pending
                </a>
                <a asp-action="ExportExcel" asp-route-year="@selectedYear"
                   class="btn btn-success">
                    <i class="bi bi-file-earmark-excel me-1"></i>Export
                </a>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="filter-card">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold">Year</label>
                <select name="year" class="form-select">
                    @for (int yr = DateTime.Now.Year; yr >= DateTime.Now.Year - 3; yr--)
                    {
                        <option value="@yr" selected="@(yr == selectedYear)">@yr</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Status</label>
                <select name="status" class="form-select">
                    <option value="">All Status</option>
                    <option value="Pending" selected="@(selectedStatus == "Pending")">Pending</option>
                    <option value="Approved" selected="@(selectedStatus == "Approved")">Approved</option>
                    <option value="Rejected" selected="@(selectedStatus == "Rejected")">Rejected</option>
                    <option value="Cancelled" selected="@(selectedStatus == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Page Size</label>
                <select name="pageSize" class="form-select">
                    <option value="10">10 per page</option>
                    <option value="20" selected>20 per page</option>
                    <option value="50">50 per page</option>
                    <option value="100">100 per page</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bi bi-search me-1"></i>Filter
                </button>
                <a asp-action="TeamHistory" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-clockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Data Table -->
    <div class="data-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-modern align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Leave Type</th>
                            <th>Period</th>
                            <th class="text-center">Days</th>
                            <th>Reason</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Items != null && Model.Items.Any())
                        {
                            foreach (var leave in Model.Items)
                            {
                                var initials = string.IsNullOrEmpty(leave.EmployeeName) ? "?" :
                                string.Concat(leave.EmployeeName.Split(' ').Take(2).Select(n => n.FirstOrDefault())).ToUpper();

                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="employee-avatar-sm">@initials</div>
                                            <div>
                                                <strong>@leave.EmployeeName</strong>
                                                <small class="d-block text-muted">@leave.EmployeeEmail</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@leave.LeaveTypeName</span>
                                    </td>
                                    <td>
                                        <small>
                                            <strong>@leave.StartDate.ToString("dd MMM")</strong> →
                                            <strong>@leave.EndDate.ToString("dd MMM yyyy")</strong>
                                        </small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary fs-6">@leave.TotalDays</span>
                                    </td>
                                    <td>
                                        <small class="text-muted" title="@leave.Reason">
                                            @(leave.Reason?.Length > 40 ? leave.Reason.Substring(0, 40) + "..." : leave.Reason)
                                        </small>
                                    </td>
                                    <td class="text-center">
                                        <span class="status-badge status-@leave.Status?.ToLower()">
                                            @leave.Status
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@leave.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i>
                                    <p>No leave records found</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

      @* ===== ADVANCED PAGINATION ===== *@
@if (Model != null && Model.TotalPages > 1)
{
    <div class="card-footer bg-white border-top py-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

            @* Showing X to Y of Z entries *@
            <div class="text-muted small">
                <i class="bi bi-info-circle me-1"></i>
                Showing <strong>@Model.FirstItemIndex</strong> to
                <strong>@Model.LastItemIndex</strong> of
                <strong>@Model.TotalCount</strong> entries
            </div>

            @* Pagination Buttons *@
            <nav>
                <ul class="pagination mb-0">

                    @* First Page *@
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("TeamHistory", new { year = selectedYear, status = selectedStatus, pageNumber = Model.FirstPage })"
                           title="First Page">
                            <i class="bi bi-chevron-double-left"></i>
                        </a>
                    </li>

                    @* Previous Page *@
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("TeamHistory", new { year = selectedYear, status = selectedStatus, pageNumber = Model.PreviousPage })"
                           title="Previous Page">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>

                    @* Show first page if not in range *@
                    @if (Model.ShouldShowFirstPage())
                    {
                        <li class="page-item">
                            <a class="page-link"
                               href="@Url.Action("TeamHistory", new { year = selectedYear, status = selectedStatus, pageNumber = 1 })">
                                1
                            </a>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }

                    @* Page Numbers (Smart Range) *@
                    @foreach (var page in Model.GetPageRange(2))
                    {
                        <li class="page-item @(page == Model.PageNumber ? "active" : "")">
                            <a class="page-link"
                               href="@Url.Action("TeamHistory", new { year = selectedYear, status = selectedStatus, pageNumber = page })">
                              
                            </a>
                        </li>
                    }

                    @* Show last page if not in range *@
                    @if (Model.ShouldShowLastPage())
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                        <li class="page-item">
                            <a class="page-link"
                               href="@Url.Action("TeamHistory", new { year = selectedYear, status = selectedStatus, pageNumber = Model.LastPage })">
                                @Model.LastPage
                            </a>
                        </li>
                    }

                    @* Next Page *@
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("TeamHistory", new { year = selectedYear, status = selectedStatus, pageNumber = Model.NextPage })"
                           title="Next Page">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>

                    @* Last Page *@
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("TeamHistory", new { year = selectedYear, status = selectedStatus, pageNumber = Model.LastPage })"
                           title="Last Page">
                            <i class="bi bi-chevron-double-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>

            @* Quick Jump to Page (Optional) *@
            <div class="d-flex align-items-center gap-2">
                <label class="text-muted small mb-0">Go to:</label>
                <input type="number"
                       class="form-control form-control-sm"
                       style="width: 70px;"
                       min="1"
                       max="@Model.TotalPages"
                       value="@Model.PageNumber"
                       onchange="window.location.href='@Url.Action("TeamHistory", new { year = selectedYear, status = selectedStatus })&pageNumber=' + this.value" />
                <span class="text-muted small">of @Model.TotalPages</span>
            </div>
        </div>
    </div>
}
</div>