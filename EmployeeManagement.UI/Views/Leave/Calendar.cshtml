@model EmployeeManagement.UI.ViewModels.LeaveCalendarViewModel
@{
    ViewData["Title"] = "Team Leave Calendar";
    var monthNames = new[] { "", "January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December" };

    var daysInMonth = DateTime.DaysInMonth(Model.SelectedYear, Model.SelectedMonth);
    var firstDayOfMonth = new DateTime(Model.SelectedYear, Model.SelectedMonth, 1);
    var prevMonth = firstDayOfMonth.AddMonths(-1);
    var nextMonth = firstDayOfMonth.AddMonths(1);

    // Group leaves by employee
    var employeeLeaves = Model.LeaveItems
        .GroupBy(l => new { l.EmployeeId, l.EmployeeName, l.DepartmentName })
        .OrderBy(g => g.Key.EmployeeName);

    // Calculate summary stats
    var totalOnLeave = Model.LeaveItems
        .Where(l => l.Status == "Approved" && DateTime.Today >= l.StartDate && DateTime.Today <= l.EndDate)
        .Select(l => l.EmployeeId)
        .Distinct()
        .Count();

    var totalPendingLeaves = Model.LeaveItems.Count(l => l.Status == "Pending");
    var totalApprovedLeaves = Model.LeaveItems.Count(l => l.Status == "Approved");
    var totalEmployees = employeeLeaves.Count();
    var totalHolidays = Model.Holidays.Count;

    var isCurrentMonthView = Model.SelectedMonth == DateTime.Now.Month && Model.SelectedYear == DateTime.Now.Year;
}

@section Styles {
    <style>
        /* ===== Hero Section ===== */
        .calendar-hero {
            background: linear-gradient(135deg, #2b4162 0%, #fa9c7a 100%);
            border-radius: 20px;
            padding: 35px 30px;
            color: white;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(43, 65, 98, 0.2);
        }

            .calendar-hero::before {
                content: '📅';
                position: absolute;
                top: -20px;
                right: 10px;
                font-size: 140px;
                opacity: 0.15;
                transform: rotate(15deg);
            }

        /* ===== Month Navigator ===== */
        .month-navigator {
            display: flex;
            align-items: center;
            gap: 15px;
            background: rgba(255, 255, 255, 0.1);
            padding: 8px 15px;
            border-radius: 50px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            width: fit-content;
        }

            .month-navigator .btn-nav {
                width: 35px;
                height: 35px;
                border-radius: 50%;
                background: rgba(255,255,255,0.2);
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: all 0.3s;
                text-decoration: none;
            }

                .month-navigator .btn-nav:hover {
                    background: white;
                    color: #2b4162;
                    transform: scale(1.1);
                }

            .month-navigator .month-title {
                font-size: 1.3rem;
                font-weight: 700;
                min-width: 180px;
                text-align: center;
                letter-spacing: 0.5px;
            }

        /* ===== Stats Pills ===== */
        .hero-stat {
            background: rgba(255,255,255,0.9);
            border-radius: 16px;
            padding: 15px;
            text-align: center;
            color: #2b4162;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            transition: transform 0.3s, box-shadow 0.3s;
            height: 100%;
        }

            .hero-stat:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 25px rgba(0,0,0,0.1);
            }

            .hero-stat .stat-value {
                font-size: 1.8rem;
                font-weight: 800;
                line-height: 1;
                margin-bottom: 5px;
            }

            .hero-stat .stat-label {
                font-size: 0.7rem;
                text-transform: uppercase;
                font-weight: 600;
                letter-spacing: 0.5px;
                color: #6c757d;
            }

        /* ===== Calendar Table ===== */
        .table-responsive {
            border-radius: 16px;
            box-shadow: 0 0 20px rgba(0,0,0,0.03);
            background: white;
            overflow-x: auto;
        }

            /* Modern Scrollbar */
            .table-responsive::-webkit-scrollbar {
                height: 8px;
            }

            .table-responsive::-webkit-scrollbar-track {
                background: #f1f1f1;
                border-radius: 10px;
            }

            .table-responsive::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 10px;
            }

                .table-responsive::-webkit-scrollbar-thumb:hover {
                    background: #94a3b8;
                }

        .calendar-table thead th {
            padding: 12px 2px;
            font-size: 0.75rem;
            border: none;
            background: #f8f9fc;
            color: #495057;
        }

        /* ===== Day Header ===== */
        .day-header {
            text-align: center;
            min-width: 45px;
        }

            .day-header .day-letter {
                font-size: 0.65rem;
                text-transform: uppercase;
                font-weight: 600;
                color: #adb5bd;
            }

            .day-header .day-number {
                font-size: 1rem;
                font-weight: 700;
                color: #495057;
            }

            .day-header.is-weekend {
                opacity: 0.6;
                background: #fdfdfe;
            }

            .day-header.is-today {
                background: #fff3cd !important;
                border-radius: 8px 8px 0 0;
            }

        /* ===== Calendar Cells ===== */
        .cal-cell {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.7rem;
            font-weight: 700;
            margin: 2px auto;
            transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            cursor: pointer;
        }

            .cal-cell:hover {
                transform: scale(1.15) translateY(-2px);
                z-index: 5;
                box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            }

            .cal-cell.type-approved {
                background: #d1e7dd;
                color: #0f5132;
            }

            .cal-cell.type-pending {
                background: #fff3cd;
                color: #664d03;
                animation: pulse 2s infinite;
            }

            .cal-cell.type-holiday {
                background: #cfe2ff;
                color: #084298;
            }

            .cal-cell.type-weekend {
                background: #f8f9fa;
                color: #ced4da;
            }

            .cal-cell.type-today {
                border: 2px solid #0d6efd;
                font-weight: 800;
            }

        @@keyframes pulse {
            0% {
                box-shadow: 0 0 0 0 rgba(255, 193, 7, 0.4);
            }

            70% {
                box-shadow: 0 0 0 6px rgba(255, 193, 7, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(255, 193, 7, 0);
            }
        }

        /* ===== Sticky Employee Column ===== */
        .emp-name-cell {
            position: sticky;
            left: 0;
            background: white;
            z-index: 2;
            min-width: 240px;
            padding: 12px 20px !important;
            border-right: 1px solid #e9ecef;
            box-shadow: 4px 0 15px -5px rgba(0,0,0,0.05); /* Float effect */
        }

        .calendar-table thead th:first-child {
            position: sticky;
            left: 0;
            z-index: 3;
            background: #f8f9fc;
            border-right: 1px solid #e9ecef;
            box-shadow: 4px 0 15px -5px rgba(0,0,0,0.05);
        }

        .emp-avatar {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            font-weight: 700;
            color: white;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        .employee-row:hover {
            background: #f8f9fa !important;
        }

            .employee-row:hover .emp-name-cell {
                background: #f8f9fa !important;
            }

        /* ===== AJAX Loader Overlay ===== */
        #ajax-loader {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(5px);
            z-index: 1000;
            display: none;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            border-radius: 20px;
        }

        .is-loading #ajax-loader {
            display: flex;
        }
    </style>
}

<div class="container-fluid" id="fluent-calendar-container">

    <div id="ajax-loader">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status"></div>
        <h5 class="mt-3 text-primary fw-bold">Updating Calendar...</h5>
    </div>

    <div class="calendar-hero mb-4">
        <div class="row align-items-center">
            <div class="col-md-5">
                <div class="month-navigator mb-3 mb-md-0">
                    <a href="@Url.Action("Calendar", new { month = prevMonth.Month, year = prevMonth.Year, departmentId = Model.SelectedDepartmentId })"
                       class="btn-nav ajax-link" data-url="@Url.Action("Calendar", new { month = prevMonth.Month, year = prevMonth.Year, departmentId = Model.SelectedDepartmentId })">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                    <div class="month-title">
                        @monthNames[Model.SelectedMonth] @Model.SelectedYear
                    </div>
                    <a href="@Url.Action("Calendar", new { month = nextMonth.Month, year = nextMonth.Year, departmentId = Model.SelectedDepartmentId })"
                       class="btn-nav ajax-link" data-url="@Url.Action("Calendar", new { month = nextMonth.Month, year = nextMonth.Year, departmentId = Model.SelectedDepartmentId })">
                        <i class="fas fa-chevron-right"></i>
                    </a>

                    @if (!isCurrentMonthView)
                    {
                        <a href="@Url.Action("Calendar", new { month = DateTime.Now.Month, year = DateTime.Now.Year })"
                           class="btn btn-sm btn-light text-primary fw-bold ms-2 rounded-pill ajax-link">
                            Today
                        </a>
                    }
                </div>
            </div>

            <div class="col-md-7">
                <div class="d-flex justify-content-md-end justify-content-start align-items-center gap-2 mb-3 no-print">
                    <select class="form-select border-0 shadow-sm rounded-pill px-3" style="width: auto; font-weight: 500;" id="departmentFilter">
                        <option value="">🏢 All Departments</option>
                        @if (Model.Departments != null)
                        {
                            foreach (var dept in Model.Departments)
                            {
                                <option value="@dept.Id" selected="@(dept.Id == Model.SelectedDepartmentId)">
                                    @dept.Name
                                </option>
                            }
                        }
                    </select>
                    <button class="btn btn-light rounded-pill shadow-sm text-primary fw-bold" onclick="window.print()">
                        <i class="fas fa-print me-1"></i> Print
                    </button>
                </div>

                <div class="row g-2">
                    <div class="col-3">
                        <div class="hero-stat">
                            <div class="stat-value text-primary">@totalEmployees</div>
                            <div class="stat-label">Staff</div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="hero-stat">
                            <div class="stat-value text-success">@totalApprovedLeaves</div>
                            <div class="stat-label">Approved</div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="hero-stat">
                            <div class="stat-value text-warning">@totalPendingLeaves</div>
                            <div class="stat-label">Pending</div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="hero-stat">
                            <div class="stat-value text-info">@totalHolidays</div>
                            <div class="stat-label">Holidays</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (employeeLeaves.Any())
    {
        <div class="table-responsive bg-white">
            <table class="table table-borderless calendar-table mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="ps-4 py-3 text-uppercase fw-bold">
                            <i class="fas fa-users text-primary me-2"></i> Employee
                        </th>
                        @for (int day = 1; day <= daysInMonth; day++)
                        {
                            var date = new DateTime(Model.SelectedYear, Model.SelectedMonth, day);
                            var isWeekend = date.DayOfWeek == DayOfWeek.Saturday || date.DayOfWeek == DayOfWeek.Sunday;
                            var isToday = date.Date == DateTime.Today;
                            var isHoliday = Model.Holidays.Any(h => h.Date.Date == date.Date);

                            var headerClass = "day-header";
                            if (isWeekend) headerClass += " is-weekend";
                            if (isToday) headerClass += " is-today";

                            <th class="@headerClass @(isHoliday ? "bg-primary bg-opacity-10 rounded-top" : "")">
                                <span class="day-letter">@date.ToString("ddd").Substring(0, 2)</span><br>
                                <span class="day-number @(isToday ? "text-primary" : "")">@day</span>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @{
                        var avatarColors = new[] { "#4facfe", "#fa709a", "#43e97b", "#a18cd1", "#fcb69f", "#667eea" };
                        var empIndex = 0;
                    }
                    @foreach (var emp in employeeLeaves)
                    {
                        var avatarColor = avatarColors[empIndex % avatarColors.Length];
                        empIndex++;

                        <tr class="employee-row border-bottom">
                            <td class="emp-name-cell">
                                <div class="d-flex align-items-center">
                                    <div class="emp-avatar me-3" style="background: @avatarColor;">
                                        @emp.Key.EmployeeName.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark mb-1" style="font-size: 0.9rem;">@emp.Key.EmployeeName</div>
                                        <div class="text-muted" style="font-size: 0.7rem;">
                                            <i class="fas fa-building me-1 opacity-50"></i>@emp.Key.DepartmentName
                                        </div>
                                    </div>
                                </div>
                            </td>

                            @for (int day = 1; day <= daysInMonth; day++)
                            {
                                var date = new DateTime(Model.SelectedYear, Model.SelectedMonth, day);
                                var isWeekend = date.DayOfWeek == DayOfWeek.Saturday || date.DayOfWeek == DayOfWeek.Sunday;
                                var isToday = date.Date == DateTime.Today;
                                var leaveOnDate = emp.FirstOrDefault(l => date >= l.StartDate && date <= l.EndDate);
                                var holidayOnDate = Model.Holidays.FirstOrDefault(h => h.Date.Date == date.Date);

                                var cellClass = "cal-cell";
                                var cellTitle = "";
                                var cellContent = "";

                                if (holidayOnDate != null)
                                {
                                    cellClass += " type-holiday";
                                    cellTitle = $"🎉 {holidayOnDate.Name}";
                                    cellContent = "H";
                                }
                                else if (leaveOnDate != null)
                                {
                                    if (leaveOnDate.Status == "Approved") { cellClass += " type-approved"; cellTitle = $"✅ {leaveOnDate.LeaveTypeName} (Approved)"; }
                                    else { cellClass += " type-pending"; cellTitle = $"⏳ {leaveOnDate.LeaveTypeName} (Pending)"; }

                                    cellContent = leaveOnDate.LeaveTypeCode.Length >= 2 ? leaveOnDate.LeaveTypeCode.Substring(0, 2) : leaveOnDate.LeaveTypeCode;
                                    if (leaveOnDate.IsHalfDay) { cellContent = "½"; cellTitle += " - Half Day"; }
                                }
                                else if (isWeekend) { cellClass += " type-weekend"; }
                                if (isToday) { cellClass += " type-today"; }

                                <td class="text-center @(holidayOnDate != null ? "bg-primary bg-opacity-10" : "")">
                                    <div class="@cellClass" title="@cellTitle">@cellContent</div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm my-4">
            <i class="fas fa-calendar-check fa-4x text-success mb-3 opacity-75"></i>
            <h4 class="fw-bold text-dark">No Leaves Found</h4>
            <p class="text-muted">All team members are available this month.</p>
        </div>
    }

    <div class="bg-white rounded-pill shadow-sm px-4 py-3 mt-4 d-flex justify-content-center gap-4 flex-wrap no-print">
        <div class="d-flex align-items-center gap-2"><span class="badge bg-success bg-opacity-25 text-success p-2">CL</span> <small class="text-muted fw-bold">Approved</small></div>
        <div class="d-flex align-items-center gap-2"><span class="badge bg-warning bg-opacity-25 text-warning p-2">SL</span> <small class="text-muted fw-bold">Pending</small></div>
        <div class="d-flex align-items-center gap-2"><span class="badge bg-primary bg-opacity-25 text-primary p-2">H</span> <small class="text-muted fw-bold">Holiday</small></div>
        <div class="d-flex align-items-center gap-2"><span class="badge bg-light text-secondary border p-2">½</span> <small class="text-muted fw-bold">Half Day</small></div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            initCalendarFeatures();

            // 1. AJAX Function to fetch new calendar data
            function fetchCalendarData(url) {
                const container = $('#fluent-calendar-container');
                container.addClass('is-loading'); // Show spinner

                // Update the Browser URL so the Back button works naturally
                window.history.pushState({path: url}, '', url);

                $.ajax({
                    url: url,
                    type: 'GET',
                    success: function (data) {
                        // Extract only the #fluent-calendar-container HTML from the response
                        const newHtml = $(data).find('#fluent-calendar-container').html();

                        // Replace content
                        container.html(newHtml);
                        container.removeClass('is-loading');

                        // Rebind events since the DOM was replaced
                        initCalendarFeatures();
                    },
                    error: function () {
                        alert('Failed to update calendar. Reloading page...');
                        window.location.href = url; // Fallback to standard navigation on error
                    }
                });
            }

            // 2. Initialize all dynamic features
            function initCalendarFeatures() {
                // Handle Pagination Arrow Clicks
                $('.ajax-link').off('click').on('click', function (e) {
                    e.preventDefault();
                    var url = $(this).attr('href') || $(this).data('url');
                    if (url) fetchCalendarData(url);
                });

                // Handle Department Filter Change
                $('#departmentFilter').off('change').on('change', function () {
                    var deptId = $(this).val();
                    var url = '@Url.Action("Calendar")' + '?month=@Model.SelectedMonth&year=@Model.SelectedYear&departmentId=' + deptId;
                    fetchCalendarData(url);
                });

                // Scroll to 'Today' column for better UX
                var todayCell = document.querySelector('.type-today');
                if (todayCell) {
                    todayCell.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
                }

                // Custom Hover Tooltips for Mobile & Desktop
                $('.cal-cell[title]').off('mouseenter mouseleave click').on('mouseenter click', function () {
                    var title = $(this).attr('title');
                    if (title && !$('.custom-tooltip').length) {
                        var tooltip = $('<div class="custom-tooltip shadow-lg"></div>')
                            .text(title)
                            .css({
                                position: 'fixed', bottom: '20px', left: '50%', transform: 'translateX(-50%)',
                                background: '#2b4162', color: 'white', padding: '8px 16px',
                                borderRadius: '30px', fontSize: '0.85rem', zIndex: '9999',
                                opacity: 0, transition: 'opacity 0.2s'
                            }).appendTo('body');

                        setTimeout(() => tooltip.css('opacity', 1), 10);
                        setTimeout(() => { tooltip.css('opacity', 0); setTimeout(() => tooltip.remove(), 200); }, 2500);
                    }
                });
            }

            // 3. Handle Browser Back/Forward buttons perfectly
            window.addEventListener('popstate', function () {
                window.location.reload(); // The easiest way to handle history navigation cleanly
            });

            // 4. Keyboard Navigation (Using AJAX)
            $(document).on('keydown', function (e) {
                if (!e.target.closest('input, select, textarea')) {
                    if (e.key === 'ArrowLeft') {
                        fetchCalendarData('@Url.Action("Calendar", new { month = prevMonth.Month, year = prevMonth.Year, departmentId = Model.SelectedDepartmentId })');
                    } else if (e.key === 'ArrowRight') {
                        fetchCalendarData('@Url.Action("Calendar", new { month = nextMonth.Month, year = nextMonth.Year, departmentId = Model.SelectedDepartmentId })');
                    } else if (e.key.toLowerCase() === 't') {
                        fetchCalendarData('@Url.Action("Calendar", new { month = DateTime.Now.Month, year = DateTime.Now.Year })');
                    }
                }
            });
        });
    </script>
}