@model List<EmployeeManagement.UI.ViewModels.LeaveBalanceViewModel>
@{
    ViewData["Title"] = "Leave Balance";

    var totalAllocated = Model.Any() ? Model.Sum(b => b.TotalAllocated) : 0;
    var totalUsed = Model.Any() ? Model.Sum(b => b.TotalUsed) : 0;
    var totalPending = Model.Any() ? Model.Sum(b => b.TotalPending) : 0;
    var totalAvailable = Model.Any() ? Model.Sum(b => b.TotalAvailable) : 0;
    var overallUsagePercent = totalAllocated > 0 ? (int)((totalUsed / totalAllocated) * 100) : 0;
}

<!-- ✅ CUSTOM STYLES -->
@section Styles {
    <style>
        /* ===== Gradient Background ===== */
        .balance-hero {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 16px;
            padding: 30px;
            color: white;
            position: relative;
            overflow: hidden;
        }

            .balance-hero::before {
                content: '';
                position: absolute;
                top: -50%;
                right: -20%;
                width: 300px;
                height: 300px;
                background: rgba(255, 255, 255, 0.08);
                border-radius: 50%;
            }

            .balance-hero::after {
                content: '';
                position: absolute;
                bottom: -30%;
                left: -10%;
                width: 200px;
                height: 200px;
                background: rgba(255, 255, 255, 0.05);
                border-radius: 50%;
            }

        /* ===== Summary Stats ===== */
        .hero-stat {
            text-align: center;
            padding: 10px;
        }

            .hero-stat .stat-value {
                font-size: 2rem;
                font-weight: 700;
                line-height: 1.2;
            }

            .hero-stat .stat-label {
                font-size: 0.8rem;
                opacity: 0.8;
                text-transform: uppercase;
                letter-spacing: 1px;
            }

        /* ===== Circular Progress ===== */
        .circular-progress {
            position: relative;
            width: 120px;
            height: 120px;
            margin: 0 auto;
        }

            .circular-progress svg {
                transform: rotate(-90deg);
            }

            .circular-progress .progress-value {
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                font-size: 1.5rem;
                font-weight: 700;
            }

        /* ===== Leave Cards ===== */
        .leave-card {
            border: none;
            border-radius: 16px;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            overflow: hidden;
            position: relative;
        }

            .leave-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15) !important;
            }

            .leave-card .card-accent {
                height: 5px;
                width: 100%;
            }

            .leave-card .leave-icon {
                width: 50px;
                height: 50px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.3rem;
            }

            .leave-card .available-count {
                font-size: 2.5rem;
                font-weight: 800;
                line-height: 1;
                background: linear-gradient(135deg, #667eea, #764ba2);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }

        /* ===== Progress Bar ===== */
        .custom-progress {
            height: 8px;
            border-radius: 10px;
            background: #e9ecef;
            overflow: hidden;
        }

            .custom-progress .progress-fill {
                height: 100%;
                border-radius: 10px;
                transition: width 1s ease-in-out;
            }

        /* ===== Stat Boxes ===== */
        .stat-box {
            background: #f8f9fc;
            border-radius: 10px;
            padding: 10px 8px;
            text-align: center;
            transition: background 0.2s;
        }

            .stat-box:hover {
                background: #eef0f7;
            }

            .stat-box .stat-num {
                font-size: 1.2rem;
                font-weight: 700;
            }

            .stat-box .stat-text {
                font-size: 0.7rem;
                color: #6c757d;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

        /* ===== Badge Styles ===== */
        .badge-paid {
            background: linear-gradient(135deg, #28a745, #20c997);
            color: white;
            font-size: 0.65rem;
            padding: 3px 8px;
            border-radius: 20px;
        }

        .badge-unpaid {
            background: linear-gradient(135deg, #dc3545, #e74c3c);
            color: white;
            font-size: 0.65rem;
            padding: 3px 8px;
            border-radius: 20px;
        }

        .badge-carry {
            background: linear-gradient(135deg, #17a2b8, #6f42c1);
            color: white;
            font-size: 0.65rem;
            padding: 3px 8px;
            border-radius: 20px;
        }

        /* ===== Animations ===== */
        .fade-in-up {
            animation: fadeInUp 0.6s ease forwards;
            opacity: 0;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .leave-card:nth-child(1) {
            animation-delay: 0.1s;
        }

        .leave-card:nth-child(2) {
            animation-delay: 0.2s;
        }

        .leave-card:nth-child(3) {
            animation-delay: 0.3s;
        }

        .leave-card:nth-child(4) {
            animation-delay: 0.4s;
        }

        .leave-card:nth-child(5) {
            animation-delay: 0.5s;
        }

        .leave-card:nth-child(6) {
            animation-delay: 0.6s;
        }

        .leave-card:nth-child(7) {
            animation-delay: 0.7s;
        }

        .leave-card:nth-child(8) {
            animation-delay: 0.8s;
        }

        /* ===== Tooltip on hover ===== */
        .leave-card .hover-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(102, 126, 234, 0.05), rgba(118, 75, 162, 0.05));
            opacity: 0;
            transition: opacity 0.3s;
            pointer-events: none;
        }

        .leave-card:hover .hover-overlay {
            opacity: 1;
        }

        /* ===== Responsive ===== */
        @@media (max-width: 768px) {
            .balance-hero {
                padding: 20px;
            }

            .hero-stat .stat-value {
                font-size: 1.5rem;
            }

            .leave-card .available-count {
                font-size: 2rem;
            }
        }
    </style>
}

<div class="container-fluid">

    <!-- ================================================================ -->
    <!-- ✅ PAGE HEADER -->
    <!-- ================================================================ -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="fas fa-chart-pie me-2 text-primary"></i>Leave Balance
            </h2>
            <p class="text-muted mb-0">
                <i class="fas fa-calendar me-1"></i>Year @DateTime.Now.Year
                <span class="mx-2">|</span>
                <i class="fas fa-sync-alt me-1"></i>Updated: @DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="History" class="btn btn-outline-primary">
                <i class="fas fa-history me-1"></i>History
            </a>
            <a asp-action="Apply" class="btn btn-primary shadow-sm">
                <i class="fas fa-plus me-1"></i>Apply Leave
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <!-- ================================================================ -->
        <!-- ✅ HERO SUMMARY SECTION -->
        <!-- ================================================================ -->
        <div class="balance-hero shadow-lg mb-4 fade-in-up">
            <div class="row align-items-center">
                <!-- Circular Progress -->
                <div class="col-md-3 text-center mb-3 mb-md-0">
                    <div class="circular-progress">
                        <svg width="120" height="120">
                            <!-- Background circle -->
                            <circle cx="60" cy="60" r="50"
                                    fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="10" />
                            <!-- Progress circle -->
                            <circle cx="60" cy="60" r="50"
                                    fill="none" stroke="white" stroke-width="10"
                                    stroke-linecap="round"
                                    stroke-dasharray="@(314)"
                                    stroke-dashoffset="@(314 - (314 * overallUsagePercent / 100))"
                                    id="progressCircle" />
                        </svg>
                        <div class="progress-value text-white">
                            @overallUsagePercent<small>%</small>
                        </div>
                    </div>
                    <div class="mt-2 small opacity-75">Overall Usage</div>
                </div>

                <!-- Summary Stats -->
                <div class="col-md-9">
                    <div class="row">
                        <div class="col-6 col-md-3">
                            <div class="hero-stat">
                                <div class="stat-value">@totalAllocated</div>
                                <div class="stat-label">
                                    <i class="fas fa-calendar-alt me-1"></i>Total Allocated
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="hero-stat">
                                <div class="stat-value">@totalUsed</div>
                                <div class="stat-label">
                                    <i class="fas fa-plane-departure me-1"></i>Used
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="hero-stat">
                                <div class="stat-value">@totalPending</div>
                                <div class="stat-label">
                                    <i class="fas fa-clock me-1"></i>Pending
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="hero-stat">
                                <div class="stat-value" style="font-size: 2.5rem;">@totalAvailable</div>
                                <div class="stat-label">
                                    <i class="fas fa-check-circle me-1"></i>Available
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Overall progress bar -->
                    <div class="mt-3 px-3">
                        <div class="d-flex justify-content-between mb-1 small">
                            <span class="opacity-75">Leave Utilization</span>
                            <span class="fw-bold">@overallUsagePercent% used</span>
                        </div>
                        <div style="height: 8px; border-radius: 10px; background: rgba(255,255,255,0.2); overflow: hidden;">
                            <div style="height: 100%; width: @(overallUsagePercent)%; border-radius: 10px;
                                        background: @(overallUsagePercent > 80 ? "#ff6b6b" : overallUsagePercent > 50 ? "#ffd93d" : "#51cf66");
                                        transition: width 1.5s ease;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================================================================ -->
        <!-- ✅ LEAVE BALANCE CARDS -->
        <!-- ================================================================ -->
        <div class="row g-4">
            @{
                // Define colors and icons for each leave type
                var leaveStyles = new Dictionary<string, (string gradient, string bg, string icon, string lightBg)>
                {
                { "CL", (gradient:"linear-gradient(135deg, #4facfe, #00f2fe)", bg:"#4facfe", icon:"fas fa-umbrella-beach", lightBg:"#e8f4fd") },
                { "SL", (gradient:"linear-gradient(135deg, #f093fb, #f5576c)", bg:"#f5576c", icon:"fas fa-medkit", lightBg:"#fde8f0") },
                { "EL", (gradient:"linear-gradient(135deg, #43e97b, #38f9d7)", bg:"#43e97b", icon:"fas fa-star", lightBg:"#e6faf0") },
                { "ML", (gradient:"linear-gradient(135deg, #fa709a, #fee140)", bg:"#fa709a", icon:"fas fa-baby", lightBg:"#fef0f5") },
                { "PL", (gradient:"linear-gradient(135deg, #a18cd1, #fbc2eb)", bg:"#a18cd1", icon:"fas fa-male", lightBg:"#f0e8f7") },
                { "CO", (gradient:"linear-gradient(135deg, #ffecd2, #fcb69f)", bg:"#fcb69f", icon:"fas fa-exchange-alt", lightBg:"#fff5ec") },
                { "LWP", (gradient:"linear-gradient(135deg, #a8caba, #5d4157)", bg:"#5d4157", icon:"fas fa-ban", lightBg:"#ededed") },
                { "HDL", (gradient:"linear-gradient(135deg, #89f7fe, #66a6ff)", bg:"#66a6ff", icon:"fas fa-adjust", lightBg:"#e8f0fe") }
                };
            }

            @foreach (var balance in Model)
            {
                var usagePercent = balance.TotalAllocated > 0
                ? (int)((balance.TotalUsed / balance.TotalAllocated) * 100) : 0;
                var code = balance.LeaveTypeCode ?? "CL";
                var style = leaveStyles.ContainsKey(code) ? leaveStyles[code] :
                (gradient: "linear-gradient(135deg, #667eea, #764ba2)", bg: "#667eea", icon: "fas fa-calendar-day", lightBg: "#eef0f7");

                var progressBarColor = usagePercent > 80 ? "#ff6b6b" :
                usagePercent > 50 ? "#ffd93d" : style.bg;

                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="card leave-card shadow-sm fade-in-up">
                        <!-- Card Top Accent -->
                        <div class="card-accent" style="background: @style.gradient;"></div>

                        <!-- Hover Overlay -->
                        <div class="hover-overlay"></div>

                        <div class="card-body p-4">
                            <!-- Header Row -->
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="leave-icon" style="background: @style.lightBg; color: @style.bg;">
                                    <i class="@style.icon"></i>
                                </div>
                                <div class="text-end">
                                    @if (balance.IsPaid)
                                    {
                                        <span class="badge-paid">
                                            <i class="fas fa-check me-1"></i>Paid
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-unpaid">
                                            <i class="fas fa-times me-1"></i>Unpaid
                                        </span>
                                    }
                                    @if (balance.CarryForward > 0)
                                    {
                                        <br>
                                        <span class="badge-carry mt-1 d-inline-block">
                                            <i class="fas fa-forward me-1"></i>CF: @balance.CarryForward
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Leave Type Name -->
                            <h6 class="text-uppercase fw-bold text-muted mb-1" style="font-size: 0.75rem; letter-spacing: 1px;">
                                @balance.LeaveTypeName
                            </h6>
                            <small class="text-muted" style="font-size: 0.7rem;">@balance.LeaveTypeCode</small>

                            <!-- Available Count (Big Number) -->
                            <div class="text-center my-3">
                                <div class="available-count" data-target="@balance.TotalAvailable">
                                    @balance.TotalAvailable
                                </div>
                                <div class="text-muted small mt-1">
                                    <i class="fas fa-calendar-check me-1"></i>Days Available
                                </div>
                            </div>

                            <!-- Progress Bar -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <small class="text-muted">Usage</small>
                                    <small class="fw-bold" style="color: @progressBarColor;">@usagePercent%</small>
                                </div>
                                <div class="custom-progress">
                                    <div class="progress-fill"
                                         style="width: @(usagePercent)%; background: @style.gradient;">
                                    </div>
                                </div>
                            </div>

                            <!-- Stats Row -->
                            <div class="row g-2">
                                <div class="col-4">
                                    <div class="stat-box">
                                        <div class="stat-num" style="color: @style.bg;">
                                            @balance.TotalAllocated
                                        </div>
                                        <div class="stat-text">Allocated</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="stat-box">
                                        <div class="stat-num text-danger">
                                            @balance.TotalUsed
                                        </div>
                                        <div class="stat-text">Used</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="stat-box">
                                        <div class="stat-num text-warning">
                                            @balance.TotalPending
                                        </div>
                                        <div class="stat-text">Pending</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Quick Apply Button -->
                            <div class="mt-3 text-center">
                                <a asp-action="Apply"
                                   asp-route-leaveTypeId="@balance.LeaveTypeId"
                                   class="btn btn-sm btn-outline-primary w-100"
                                   style="border-radius: 20px;">
                                    <i class="fas fa-paper-plane me-1"></i>Apply @balance.LeaveTypeCode
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- ================================================================ -->
        <!-- ✅ DETAILED TABLE VIEW -->
        <!-- ================================================================ -->
        <div class="card border-0 shadow-sm mt-4 fade-in-up" style="animation-delay: 0.9s;">
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-table me-2 text-primary"></i>Detailed View
                    </h5>
                    <button class="btn btn-sm btn-outline-secondary" onclick="toggleTableView()">
                        <i class="fas fa-eye me-1" id="toggleIcon"></i>
                        <span id="toggleText">Hide Table</span>
                    </button>
                </div>
            </div>
            <div class="card-body p-0" id="tableView">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead style="background: linear-gradient(135deg, #667eea, #764ba2); color: white;">
                            <tr>
                                <th class="border-0 py-3 ps-4">Leave Type</th>
                                <th class="border-0 py-3 text-center">Code</th>
                                <th class="border-0 py-3 text-center">Allocated</th>
                                <th class="border-0 py-3 text-center">Carry Forward</th>
                                <th class="border-0 py-3 text-center">Used</th>
                                <th class="border-0 py-3 text-center">Pending</th>
                                <th class="border-0 py-3 text-center">Available</th>
                                <th class="border-0 py-3 text-center">Usage</th>
                                <th class="border-0 py-3 text-center">Type</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var balance in Model)
                            {
                                var usagePercent = balance.TotalAllocated > 0
                                ? (int)((balance.TotalUsed / balance.TotalAllocated) * 100)
                                : 0;

                                var code = balance.LeaveTypeCode ?? "CL";

                                var style = leaveStyles.ContainsKey(code)
                                ? leaveStyles[code]
                                : (gradient: "linear-gradient(135deg, #667eea, #764ba2)",
                                bg: "#667eea",
                                icon: "fas fa-calendar-day",
                                lightBg: "#eef0f7");

                                var rowClass = balance.TotalAvailable <= 0 ? "table-danger"
                                : balance.TotalAvailable <= 3 ? "table-warning"
                                : "";

                                <tr class="@rowClass">

                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="leave-icon me-2"
                                                 style="background:@style.lightBg; color:@style.bg; width:35px; height:35px; font-size:0.9rem;">
                                                <i class="@style.icon"></i>
                                            </div>
                                            <strong>@balance.LeaveTypeName</strong>
                                        </div>
                                    </td>

                                    <td class="text-center">
                                        <span class="badge" style="background:@style.bg; font-size:0.75rem;">
                                            @balance.LeaveTypeCode
                                        </span>
                                    </td>

                                    <td class="text-center fw-bold">@balance.TotalAllocated</td>

                                    <td class="text-center">
                                        @if (balance.CarryForward > 0)
                                        {
                                            <span class="text-info fw-bold">+@balance.CarryForward</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0</span>
                                        }
                                    </td>

                                    <td class="text-center text-danger fw-bold">@balance.TotalUsed</td>

                                    <td class="text-center text-warning fw-bold">@balance.TotalPending</td>

                                    <td class="text-center">
                                        <span class="fw-bold fs-5" style="color:@style.bg;">
                                            @balance.TotalAvailable
                                        </span>
                                    </td>

                                    <td class="text-center" style="min-width:120px;">
                                        <div class="d-flex align-items-center justify-content-center gap-2">
                                            <div class="custom-progress flex-grow-1" style="max-width:80px;">
                                                <div class="progress-fill"
                                                     style="width:@(usagePercent)%; background:@style.gradient;">
                                                </div>
                                            </div>
                                            <small class="fw-bold">@usagePercent%</small>
                                        </div>
                                    </td>

                                    <td class="text-center">
                                        @if (balance.IsPaid)
                                        {
                                            <span class="badge bg-success" style="font-size:0.65rem;">Paid</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger" style="font-size:0.65rem;">Unpaid</span>
                                        }
                                    </td>

                                </tr>
                            }
                        </tbody>
                        <tfoot style="background: #f8f9fc;">
                            <tr class="fw-bold">
                                <td class="ps-4" colspan="2">
                                    <i class="fas fa-calculator me-1 text-primary"></i>TOTAL
                                </td>
                                <td class="text-center">@totalAllocated</td>
                                <td class="text-center text-info">
                                    @(Model.Sum(b => b.CarryForward))
                                </td>
                                <td class="text-center text-danger">@totalUsed</td>
                                <td class="text-center text-warning">@totalPending</td>
                                <td class="text-center fs-5" style="color: #667eea;">@totalAvailable</td>
                                <td class="text-center">@overallUsagePercent%</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- ================================================================ -->
        <!-- ✅ TIPS & INFO SECTION -->
        <!-- ================================================================ -->
        <div class="row g-3 mt-3">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                    <div class="card-body text-center py-4">
                        <div class="rounded-circle bg-primary bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3"
                             style="width: 60px; height: 60px;">
                            <i class="fas fa-lightbulb text-primary fa-lg"></i>
                        </div>
                        <h6 class="fw-bold">Plan Ahead</h6>
                        <small class="text-muted">
                            Apply for leaves at least 3 days in advance for better approval chances.
                        </small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                    <div class="card-body text-center py-4">
                        <div class="rounded-circle bg-success bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3"
                             style="width: 60px; height: 60px;">
                            <i class="fas fa-calendar-check text-success fa-lg"></i>
                        </div>
                        <h6 class="fw-bold">Check Holidays</h6>
                        <small class="text-muted">
                            Plan leaves around holidays to maximize your time off efficiently.
                        </small>
                        <br>
                        <a asp-action="Holidays" class="btn btn-sm btn-outline-success mt-2" style="border-radius: 20px;">
                            View Holidays
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                    <div class="card-body text-center py-4">
                        <div class="rounded-circle bg-warning bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3"
                             style="width: 60px; height: 60px;">
                            <i class="fas fa-info-circle text-warning fa-lg"></i>
                        </div>
                        <h6 class="fw-bold">Need Help?</h6>
                        <small class="text-muted">
                            Contact HR department for leave policy queries or balance adjustments.
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================================================================ -->
        <!-- ✅ LEGEND -->
        <!-- ================================================================ -->
        <div class="mt-4 mb-3">
            <div class="d-flex flex-wrap gap-3 justify-content-center">
                <div class="d-flex align-items-center">
                    <div style="width: 12px; height: 12px; border-radius: 50%; background: #51cf66;" class="me-2"></div>
                    <small class="text-muted">0-50% Used (Good)</small>
                </div>
                <div class="d-flex align-items-center">
                    <div style="width: 12px; height: 12px; border-radius: 50%; background: #ffd93d;" class="me-2"></div>
                    <small class="text-muted">50-80% Used (Moderate)</small>
                </div>
                <div class="d-flex align-items-center">
                    <div style="width: 12px; height: 12px; border-radius: 50%; background: #ff6b6b;" class="me-2"></div>
                    <small class="text-muted">80-100% Used (Low Balance)</small>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- ================================================================ -->
        <!-- ✅ EMPTY STATE -->
        <!-- ================================================================ -->
        <div class="card border-0 shadow-sm mt-3">
            <div class="card-body text-center py-5">
                <div class="mb-4">
                    <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center"
                         style="width: 100px; height: 100px;">
                        <i class="fas fa-calendar-times fa-3x text-muted"></i>
                    </div>
                </div>
                <h4 class="fw-bold text-dark">No Leave Balance Allocated</h4>
                <p class="text-muted mb-4">
                    Your leave balance for @DateTime.Now.Year hasn't been set up yet.
                    <br>Please contact your HR department to allocate your annual leave balance.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-action="Index" class="btn btn-primary" style="border-radius: 20px;">
                        <i class="fas fa-tachometer-alt me-1"></i>Go to Dashboard
                    </a>
                    <a asp-action="Holidays" class="btn btn-outline-info" style="border-radius: 20px;">
                        <i class="fas fa-calendar me-1"></i>View Holidays
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // =============================================
        // ✅ TOGGLE TABLE VIEW
        // =============================================
        function toggleTableView() {
            var table = document.getElementById('tableView');
            var icon = document.getElementById('toggleIcon');
            var text = document.getElementById('toggleText');

            if (table.style.display === 'none') {
                table.style.display = 'block';
                icon.className = 'fas fa-eye me-1';
                text.textContent = 'Hide Table';
            } else {
                table.style.display = 'none';
                icon.className = 'fas fa-eye-slash me-1';
                text.textContent = 'Show Table';
            }
        }

        // =============================================
        // ✅ ANIMATE NUMBERS ON SCROLL
        // =============================================
        function animateNumbers() {
            var elements = document.querySelectorAll('.available-count');
            elements.forEach(function (el) {
                var target = parseFloat(el.getAttribute('data-target')) || 0;
                var current = 0;
                var increment = target / 30;
                var isDecimal = target % 1 !== 0;

                var timer = setInterval(function () {
                    current += increment;
                    if (current >= target) {
                        current = target;
                        clearInterval(timer);
                    }
                    el.textContent = isDecimal ? current.toFixed(1) : Math.floor(current);
                }, 30);
            });
        }

        // =============================================
        // ✅ ANIMATE PROGRESS BARS ON LOAD
        // =============================================
        function animateProgressBars() {
            var progressBars = document.querySelectorAll('.progress-fill');
            progressBars.forEach(function (bar) {
                var targetWidth = bar.style.width;
                bar.style.width = '0%';
                setTimeout(function () {
                    bar.style.width = targetWidth;
                }, 300);
            });
        }

        // =============================================
        // ✅ ANIMATE CIRCULAR PROGRESS
        // =============================================
        function animateCircularProgress() {
            var circle = document.getElementById('progressCircle');
            if (circle) {
                var targetOffset = circle.getAttribute('stroke-dashoffset');
                circle.setAttribute('stroke-dashoffset', '314');
                setTimeout(function () {
                    circle.style.transition = 'stroke-dashoffset 1.5s ease';
                    circle.setAttribute('stroke-dashoffset', targetOffset);
                }, 500);
            }
        }

        // =============================================
        // ✅ RUN ANIMATIONS ON PAGE LOAD
        // =============================================
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(animateNumbers, 300);
            setTimeout(animateProgressBars, 500);
            setTimeout(animateCircularProgress, 200);
        });
    </script>
}