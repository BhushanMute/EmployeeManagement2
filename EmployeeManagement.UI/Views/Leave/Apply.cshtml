@model EmployeeManagement.UI.ViewModels.ApplyLeaveViewModel
@{
    ViewData["Title"] = "Apply Leave";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fas fa-calendar-plus me-2"></i>Apply for Leave</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Apply" method="post" enctype="multipart/form-data" id="applyLeaveForm">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="EmployeeId" />

                        <!-- Employee Info -->
                        <div class="alert alert-light border mb-4">
                            <i class="fas fa-user me-2 text-primary"></i>
                            <strong>Applying as:</strong> @Model.EmployeeName
                        </div>

                        <!-- Leave Type -->
                        <div class="mb-3">
                            <label asp-for="LeaveTypeId" class="form-label fw-bold">
                                Leave Type <span class="text-danger">*</span>
                            </label>
                            <select asp-for="LeaveTypeId" class="form-select" id="leaveTypeSelect">
                                <option value="" disabled selected="@(Model.LeaveTypeId == 0)">
                                    -- Select Leave Type --
                                </option>

                                @if (Model.LeaveTypes != null)
                                {
                                    @foreach (var lt in Model.LeaveTypes)
                                    {
                                        <option value="@lt.Id"
                                                data-maxdays="@lt.MaxDays"
                                                data-paid="@lt.IsPaid.ToString().ToLower()">
                                            @lt.Name (@lt.Code) - Max @lt.MaxDays days
                                            @(lt.IsPaid ? "" : " [Unpaid]")
                                        </option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="LeaveTypeId" class="text-danger"></span>
                        </div>

                        <!-- Half Day Toggle -->
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="IsHalfDay"
                                       id="isHalfDay" onchange="toggleHalfDay()">
                                <label class="form-check-label" for="isHalfDay">Half Day Leave</label>
                            </div>
                        </div>

                        <!-- Half Day Type (shown only when half day is selected) -->
                        <div class="mb-3" id="halfDayTypeDiv" style="display:none;">
                            <label asp-for="HalfDayType" class="form-label fw-bold">Half Day Type</label>
                            <select asp-for="HalfDayType" class="form-select">
                                <option value="">-- Select --</option>
                                <option value="FirstHalf">First Half (Morning)</option>
                                <option value="SecondHalf">Second Half (Afternoon)</option>
                            </select>
                        </div>

                        <!-- Date Range -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="StartDate" class="form-label fw-bold">
                                    Start Date <span class="text-danger">*</span>
                                </label>
                                <input asp-for="StartDate" type="date" class="form-control"
                                       id="startDate" min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       onchange="calculateDays()">
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EndDate" class="form-label fw-bold">
                                    End Date <span class="text-danger">*</span>
                                </label>
                                <input asp-for="EndDate" type="date" class="form-control"
                                       id="endDate" min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       onchange="calculateDays()">
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Calculated Days Display -->
                        <div class="alert alert-info mb-3" id="daysInfo" style="display:none;">
                            <i class="fas fa-info-circle me-2"></i>
                            Total Leave Days: <strong id="totalDaysDisplay">0</strong>
                            <span id="weekendInfo" class="ms-2 text-muted"></span>
                        </div>

                        <!-- Reason -->
                        <div class="mb-3">
                            <label asp-for="Reason" class="form-label fw-bold">
                                Reason <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Reason" class="form-control" rows="4"
                                      placeholder="Please provide a detailed reason for your leave request (minimum 10 characters)..."></textarea>
                            <span asp-validation-for="Reason" class="text-danger"></span>
                            <small class="text-muted">
                                <span id="charCount">0</span>/1000 characters
                            </small>
                        </div>

                        <!-- Emergency Contact -->
                        <div class="mb-3">
                            <label asp-for="EmergencyContact" class="form-label fw-bold">
                                Emergency Contact
                            </label>
                            <input asp-for="EmergencyContact" class="form-control"
                                   placeholder="Contact number during leave">
                        </div>

                        <!-- File Attachment -->
                        <div class="mb-4">
                            <label asp-for="Attachment" class="form-label fw-bold">
                                Attachment <small class="text-muted">(Medical certificate, etc.)</small>
                            </label>
                            <input asp-for="Attachment" type="file" class="form-control"
                                   accept=".jpg,.jpeg,.png,.pdf,.doc,.docx">
                            <small class="text-muted">Allowed: jpg, png, pdf, doc (Max 5MB)</small>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-1"></i>Back
                            </a>
                            <button type="submit" class="btn btn-primary px-4" id="submitBtn">
                                <i class="fas fa-paper-plane me-1"></i>Submit Leave Request
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Toggle half day options
        function toggleHalfDay() {
            var isHalfDay = document.getElementById('isHalfDay').checked;
            document.getElementById('halfDayTypeDiv').style.display = isHalfDay ? 'block' : 'none';

            if (isHalfDay) {
                document.getElementById('endDate').value = document.getElementById('startDate').value;
                document.getElementById('endDate').setAttribute('disabled', 'true');
            } else {
                document.getElementById('endDate').removeAttribute('disabled');
            }
            calculateDays();
        }

        // Calculate business days
        function calculateDays() {
            var startDate = new Date(document.getElementById('startDate').value);
            var endDate = new Date(document.getElementById('endDate').value);
            var isHalfDay = document.getElementById('isHalfDay').checked;

            if (isNaN(startDate) || isNaN(endDate)) {
                document.getElementById('daysInfo').style.display = 'none';
                return;
            }

            if (endDate < startDate) {
                document.getElementById('endDate').value = document.getElementById('startDate').value;
                endDate = startDate;
            }

            if (isHalfDay) {
                document.getElementById('totalDaysDisplay').textContent = '0.5';
                document.getElementById('weekendInfo').textContent = '(Half Day)';
                document.getElementById('daysInfo').style.display = 'block';
                return;
            }

            var businessDays = 0;
            var totalDays = 0;
            var current = new Date(startDate);

            while (current <= endDate) {
                totalDays++;
                if (current.getDay() !== 0 && current.getDay() !== 6) {
                    businessDays++;
                }
                current.setDate(current.getDate() + 1);
            }

            var weekendDays = totalDays - businessDays;
            document.getElementById('totalDaysDisplay').textContent = businessDays;
            document.getElementById('weekendInfo').textContent =
                weekendDays > 0 ? `(${weekendDays} weekend day(s) excluded)` : '';
            document.getElementById('daysInfo').style.display = 'block';
        }

        // Character count for reason
        document.querySelector('[name="Reason"]').addEventListener('input', function () {
            document.getElementById('charCount').textContent = this.value.length;
        });

        // Form validation
        document.getElementById('applyLeaveForm').addEventListener('submit', function (e) {
            var btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Submitting...';
        });
    </script>
}