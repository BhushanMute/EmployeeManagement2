@model EmployeeManagement.UI.ViewModels.LeaveDashboardViewModel
@{
    ViewData["Title"] = "Leave Dashboard";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="fas fa-calendar-alt me-2 text-primary"></i>Leave Dashboard</h2>
            <p class="text-muted mb-0">Welcome, @Model.EmployeeName</p>
        </div>
        <div>
            <a asp-action="Apply" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i>Apply Leave
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title opacity-75">Total Available</h6>
                            <h2 class="mb-0">@Model.TotalLeaveAvailable</h2>
                            <small>Days</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-calendar-check fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title opacity-75">Leaves Taken</h6>
                            <h2 class="mb-0">@Model.TotalLeaveTaken</h2>
                            <small>Days</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-plane-departure fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-warning text-dark">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title opacity-75">Pending Requests</h6>
                            <h2 class="mb-0">@Model.TotalPendingRequests</h2>
                            <small>Requests</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-clock fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-info text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title opacity-75">Upcoming Holidays</h6>
                            <h2 class="mb-0">@Model.UpcomingHolidays.Count</h2>
                            <small>Holidays</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-gift fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Leave Balance Section -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-chart-pie me-2 text-primary"></i>Leave Balance</h5>
                    <a asp-action="Balance" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body">
                    @if (Model.Balances.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Leave Type</th>
                                        <th class="text-center">Allocated</th>
                                        <th class="text-center">Used</th>
                                        <th class="text-center">Pending</th>
                                        <th class="text-center">Available</th>
                                        <th>Progress</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var balance in Model.Balances)
                                    {
                                        var usagePercent = balance.TotalAllocated > 0
                                        ? (int)((balance.TotalUsed / balance.TotalAllocated) * 100) : 0;
                                        var progressClass = usagePercent > 80 ? "bg-danger" :
                                        usagePercent > 50 ? "bg-warning" : "bg-success";
                                        <tr>
                                            <td>
                                                <strong>@balance.LeaveTypeName</strong>
                                                <br><small class="text-muted">@balance.LeaveTypeCode</small>
                                            </td>
                                            <td class="text-center">@balance.TotalAllocated</td>
                                            <td class="text-center text-danger">@balance.TotalUsed</td>
                                            <td class="text-center text-warning">@balance.TotalPending</td>
                                            <td class="text-center fw-bold text-success">@balance.TotalAvailable</td>
                                            <td style="min-width: 120px;">
                                                <div class="progress" style="height: 8px;">
                                                    <div class="progress-bar @progressClass"
                                                         style="width: @usagePercent%"></div>
                                                </div>
                                                <small class="text-muted">@usagePercent% used</small>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="fas fa-info-circle fa-2x mb-2"></i>
                            <p>No leave balance found for this year.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Recent Leave Requests -->
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-history me-2 text-primary"></i>Recent Leave Requests</h5>
                    <a asp-action="History" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body">
                    @if (Model.RecentRequests.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Type</th>
                                        <th>From</th>
                                        <th>To</th>
                                        <th>Days</th>
                                        <th>Status</th>
                                        <th>Applied</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var request in Model.RecentRequests)
                                    {
                                        var statusClass = request.Status switch
                                        {
                                            "Approved" => "bg-success",
                                            "Rejected" => "bg-danger",
                                            "Cancelled" => "bg-secondary",
                                            _ => "bg-warning text-dark"
                                        };
                                        <tr>
                                            <td>@request.LeaveTypeName</td>
                                            <td>@request.StartDate.ToString("dd MMM yyyy")</td>
                                            <td>@request.EndDate.ToString("dd MMM yyyy")</td>
                                            <td>@request.TotalDays</td>
                                            <td>
                                                <span class="badge @statusClass">@request.Status</span>
                                            </td>
                                            <td>@request.AppliedDate.ToString("dd MMM yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="fas fa-inbox fa-2x mb-2"></i>
                            <p>No recent leave requests.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Sidebar -->
        <div class="col-lg-4">
            <!-- Quick Actions -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="fas fa-bolt me-2 text-warning"></i>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Apply" class="btn btn-primary">
                            <i class="fas fa-plus me-2"></i>Apply Leave
                        </a>
                        <a asp-action="History" class="btn btn-outline-primary">
                            <i class="fas fa-history me-2"></i>Leave History
                        </a>
                        <a asp-action="Balance" class="btn btn-outline-success">
                            <i class="fas fa-chart-pie me-2"></i>Leave Balance
                        </a>
                        <a asp-action="Holidays" class="btn btn-outline-info">
                            <i class="fas fa-calendar me-2"></i>Holiday Calendar
                        </a>
                    </div>
                </div>
            </div>

            <!-- Upcoming Holidays -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-calendar-day me-2 text-info"></i>Upcoming Holidays</h5>
                    <a asp-action="Holidays" class="btn btn-sm btn-outline-info">All</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.UpcomingHolidays.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var holiday in Model.UpcomingHolidays)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@holiday.Name</strong>
                                        <br><small class="text-muted">@holiday.Day</small>
                                    </div>
                                    <span class="badge bg-info rounded-pill">
                                        @holiday.Date.ToString("dd MMM")
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-center py-3 text-muted">
                            <small>No upcoming holidays</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>