</div>

<!-- ================================================================ -->
<!-- ✅ DOCUMENT VIEWER MODAL -->
<!-- ================================================================ -->
<div class="modal fade" id="documentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" style="border: none; border-radius: 16px; overflow: hidden;">
            <div class="modal-header text-white" style="background: linear-gradient(135deg, #0984e3, #6c5ce7);">
                <h5 class="modal-title">
                    <i class="fas fa-file-alt me-2"></i>
                    <span id="docModalTitle">Document Preview</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0" style="min-height: 350px; background: #f0f2f5;">
                <div id="docLoading" class="text-center py-5">
                    <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;"></div>
                    <p class="mt-3 text-muted">Loading document...</p>
                </div>
                <div id="docImageContainer" class="text-center p-3" style="display:none;">
                    <img id="docImage" src="" alt="Document"
                         class="img-fluid rounded shadow"
                         style="max-height: 70vh; object-fit: contain; cursor: zoom-in; transition: transform 0.3s;"
                         onclick="toggleImageZoom(this)">
                </div>
                <div id="docPdfContainer" style="display:none;">
                    <iframe id="docPdf" src="" style="width: 100%; height: 75vh; border: none; background: #525659;"></iframe>
                </div>
                <div id="docUnsupported" class="text-center py-5" style="display:none;">
                    <i class="fas fa-file-alt fa-2x text-warning mb-3"></i>
                    <h5 class="fw-bold">Preview Not Available</h5>
                    <a id="docDownloadLinkAlt" href="" class="btn btn-primary">
                        <i class="fas fa-download me-1"></i>Download File
                    </a>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between" style="background: #f8f9fa;">
                <small class="text-muted" id="docFileName">document.pdf</small>
                <div class="d-flex gap-2">
                    <a id="docDownloadBtn" href="" download class="btn btn-success btn-sm">
                        <i class="fas fa-download me-1"></i>Download
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        // ✅ Global state for bulk selection
        let selectedLeaves = new Map();
        let currentBulkAction = '';

        // =============================================
        // ✅ TOGGLE VIEW
        // =============================================
        function toggleView(view) {
            if (view === 'card') {
                document.getElementById('cardView').style.display = 'block';
                document.getElementById('tableView').style.display = 'none';
                document.getElementById('btnCardView').classList.add('active');
                document.getElementById('btnTableView').classList.remove('active');
            } else {
                document.getElementById('cardView').style.display = 'none';
                document.getElementById('tableView').style.display = 'block';
                document.getElementById('btnCardView').classList.remove('active');
                document.getElementById('btnTableView').classList.add('active');
            }
        }

        // =============================================
        // ✅ BULK SELECTION LOGIC
        // =============================================
        function toggleSelectAll(checked) {
            // Update all checkboxes in both views
            document.querySelectorAll('.leave-checkbox, .leave-checkbox-table').forEach(cb => {
                cb.checked = checked;
                const card = document.getElementById('card_' + cb.dataset.leaveId);
                if (card) {
                    if (checked) card.classList.add('selected');
                    else card.classList.remove('selected');
                }
            });

            // Update selectAll checkbox
            const selectAllCb = document.getElementById('selectAll');
            if (selectAllCb) selectAllCb.checked = checked;

            updateSelection();
        }

        function updateSelection() {
            selectedLeaves.clear();

            // Collect from all checked checkboxes
            document.querySelectorAll('.leave-checkbox:checked, .leave-checkbox-table:checked').forEach(cb => {
                selectedLeaves.set(cb.dataset.leaveId, cb.dataset.employeeName);

                // Highlight card
                const card = document.getElementById('card_' + cb.dataset.leaveId);
                if (card) card.classList.add('selected');
            });

            // Remove highlight from unchecked
            document.querySelectorAll('.leave-checkbox:not(:checked), .leave-checkbox-table:not(:checked)').forEach(cb => {
                const card = document.getElementById('card_' + cb.dataset.leaveId);
                if (card) card.classList.remove('selected');
            });

            // Sync checkboxes between views (for same ID)
            const checkedIds = Array.from(selectedLeaves.keys());
            document.querySelectorAll('.leave-checkbox, .leave-checkbox-table').forEach(cb => {
                cb.checked = checkedIds.includes(cb.dataset.leaveId);
            });

            // Update UI
            const count = selectedLeaves.size;
            document.getElementById('selectedCount').textContent = count;
            document.getElementById('floatingCount').textContent = count;

            const bar = document.getElementById('bulkActionBar');
            const floatBtn = document.getElementById('floatingBulkBtn');

            if (count > 0) {
                bar.classList.add('show');
                floatBtn.classList.add('show');
            } else {
                bar.classList.remove('show');
                floatBtn.classList.remove('show');
            }
        }

        function clearSelection() {
            document.querySelectorAll('.leave-checkbox, .leave-checkbox-table').forEach(cb => cb.checked = false);
            const selectAllCb = document.getElementById('selectAll');
            if (selectAllCb) selectAllCb.checked = false;
            updateSelection();
        }

        // =============================================
        // ✅ BULK ACTION - Show Modal
        // =============================================
        function bulkAction(action) {
            if (selectedLeaves.size === 0) {
                Swal.fire('No Selection', 'Please select at least one leave request.', 'warning');
                return;
            }

            currentBulkAction = action;
            const count = selectedLeaves.size;
            const isApprove = action === 'approve';

            // Populate modal
            document.getElementById('bulkActionText').textContent = action;
            document.getElementById('bulkCountText').textContent = count;
            document.getElementById('bulkRemarks').value = '';

            // Header styling
            const header = document.getElementById('bulkModalHeader');
            const title = document.getElementById('bulkModalTitle');
            const icon = document.getElementById('bulkModalIcon');
            const alert = document.getElementById('bulkAlert');
            const submitBtn = document.getElementById('bulkSubmitBtn');
            const submitIcon = document.getElementById('bulkSubmitIcon');
            const submitText = document.getElementById('bulkSubmitText');

            if (isApprove) {
                header.style.background = 'linear-gradient(135deg, #28a745, #20c997)';
                header.style.color = 'white';
                title.textContent = `Bulk Approve ${count} Leave Requests`;
                icon.className = 'fas fa-check-double me-2';
                alert.className = 'alert alert-success';
                submitBtn.className = 'btn btn-success px-4';
                submitIcon.className = 'fas fa-check-double me-1';
                submitText.textContent = `Approve All (${count})`;
            } else {
                header.style.background = 'linear-gradient(135deg, #dc3545, #c0392b)';
                header.style.color = 'white';
                title.textContent = `Bulk Reject ${count} Leave Requests`;
                icon.className = 'fas fa-times-circle me-2';
                alert.className = 'alert alert-danger';
                submitBtn.className = 'btn btn-danger px-4';
                submitIcon.className = 'fas fa-times-circle me-1';
                submitText.textContent = `Reject All (${count})`;
            }

            // Populate list
            const list = document.getElementById('bulkEmployeeList');
            list.innerHTML = '';
            let idx = 1;
            selectedLeaves.forEach((name, id) => {
                list.innerHTML += `
                    <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent">
                        <span>
                            <span class="badge bg-secondary me-2">${idx}</span>
                            <strong>${name}</strong>
                            <small class="text-muted ms-2">ID: ${id}</small>
                        </span>
                        <i class="fas fa-${isApprove ? 'check text-success' : 'times text-danger'}"></i>
                    </li>`;
                idx++;
            });

            new bootstrap.Modal(document.getElementById('bulkActionModal')).show();
        }

        // =============================================
        // ✅ EXECUTE BULK ACTION (AJAX)
        // =============================================
        async function executeBulkAction() {
            const btn = document.getElementById('bulkSubmitBtn');
            const originalText = document.getElementById('bulkSubmitText').textContent;

            btn.disabled = true;
            document.getElementById('bulkSubmitText').textContent = 'Processing...';
            document.getElementById('bulkSubmitIcon').className = 'fas fa-spinner fa-spin me-1';

            const leaveIds = Array.from(selectedLeaves.keys()).map(id => parseInt(id));
            const remarks = document.getElementById('bulkRemarks').value;
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            try {
                const formData = new FormData();
                leaveIds.forEach(id => formData.append('leaveIds', id));
                if (remarks) formData.append('remarks', remarks);
                formData.append('__RequestVerificationToken', token);

                const url = currentBulkAction === 'approve'
                    ? '@Url.Action("BulkApprove", "Leave")'
                    : '@Url.Action("BulkReject", "Leave")';

                const response = await fetch(url, {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                const result = await response.json();

                bootstrap.Modal.getInstance(document.getElementById('bulkActionModal')).hide();

                if (result.success) {
                    Swal.fire({
                        title: 'Bulk Action Complete!',
                        html: `
                            <div class="text-start">
                                <p><strong>${result.message}</strong></p>
                                ${result.successCount ? `<p class="text-success"><i class="fas fa-check"></i> Success: ${result.successCount}</p>` : ''}
                                ${result.failCount ? `<p class="text-danger"><i class="fas fa-times"></i> Failed: ${result.failCount}</p>` : ''}
                            </div>`,
                        icon: 'success',
                        confirmButtonText: 'OK'
                    }).then(() => location.reload());
                } else {
                    Swal.fire('Error', result.message || 'Bulk action failed', 'error');
                    btn.disabled = false;
                    document.getElementById('bulkSubmitText').textContent = originalText;
                    document.getElementById('bulkSubmitIcon').className = 'fas fa-check me-1';
                }
            } catch (err) {
                Swal.fire('Error', 'Server error: ' + err.message, 'error');
                btn.disabled = false;
                document.getElementById('bulkSubmitText').textContent = originalText;
            }
        }

        // =============================================
        // ✅ SHOW ACTION MODAL (Single)
        // =============================================
        function showActionModal(id, action, employeeName, leaveType, fromDate, toDate, days) {
            document.getElementById('actionLeaveId').value = id;
            document.getElementById('actionRemarks').value = '';
            document.getElementById('remarkCharCount').textContent = '0';
            document.getElementById('modalEmployeeName').textContent = employeeName;
            document.getElementById('modalLeaveType').textContent = leaveType;
            document.getElementById('modalFromDate').textContent = fromDate;
            document.getElementById('modalToDate').textContent = toDate;
            document.getElementById('modalDays').textContent = days;

            const form = document.getElementById('actionForm');
            const header = document.getElementById('actionModalHeader');
            const titleText = document.getElementById('actionModalTitleText');
            const icon = document.getElementById('actionModalIcon');
            const submitBtn = document.getElementById('actionSubmitBtn');
            const submitBtnIcon = document.getElementById('submitBtnIcon');
            const submitBtnText = document.getElementById('submitBtnText');
            const approveMsg = document.getElementById('approveMessage');

            if (action === 'approve') {
                form.action = '@Url.Action("Approve", "Leave")';
                header.style.background = 'linear-gradient(135deg, #28a745, #20c997)';
                header.style.color = 'white';
                titleText.textContent = 'Approve Leave';
                icon.className = 'fas fa-check-circle me-2';
                approveMsg.innerHTML = `
                    <div class="rounded-circle bg-success bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-2" style="width:60px;height:60px;">
                        <i class="fas fa-check-circle fa-2x text-success"></i>
                    </div>
                    <p class="text-muted">Approve leave for <strong>${employeeName}</strong>?</p>`;
                submitBtn.className = 'btn btn-success px-4';
                submitBtnIcon.className = 'fas fa-check-circle me-1';
                submitBtnText.textContent = 'Approve Leave';
            } else {
                form.action = '@Url.Action("Reject", "Leave")';
                header.style.background = 'linear-gradient(135deg, #dc3545, #c0392b)';
                header.style.color = 'white';
                titleText.textContent = 'Reject Leave';
                icon.className = 'fas fa-times-circle me-2';
                approveMsg.innerHTML = `
                    <div class="rounded-circle bg-danger bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-2" style="width:60px;height:60px;">
                        <i class="fas fa-times-circle fa-2x text-danger"></i>
                    </div>
                    <p class="text-muted">Reject leave for <strong>${employeeName}</strong>?<br><small>Please provide reason below.</small></p>`;
                submitBtn.className = 'btn btn-danger px-4';
                submitBtnIcon.className = 'fas fa-times-circle me-1';
                submitBtnText.textContent = 'Reject Leave';
            }

            new bootstrap.Modal(document.getElementById('actionModal')).show();
        }

        document.getElementById('actionRemarks').addEventListener('input', function () {
            document.getElementById('remarkCharCount').textContent = this.value.length;
        });

        document.getElementById('actionForm').addEventListener('submit', function () {
            const btn = document.getElementById('actionSubmitBtn');
            btn.disabled = true;
            document.getElementById('submitBtnText').textContent = 'Processing...';
            document.getElementById('submitBtnIcon').className = 'fas fa-spinner fa-spin me-1';
        });

        // =============================================
        // ✅ DOCUMENT VIEWER
        // =============================================
        function showDocument(previewUrl, downloadUrl, title) {
            document.getElementById('docLoading').style.display = 'block';
            document.getElementById('docImageContainer').style.display = 'none';
            document.getElementById('docPdfContainer').style.display = 'none';
            document.getElementById('docUnsupported').style.display = 'none';
            document.getElementById('docModalTitle').textContent = title || 'Document Preview';
            document.getElementById('docDownloadBtn').href = downloadUrl;
            document.getElementById('docDownloadLinkAlt').href = downloadUrl;

            const urlParts = previewUrl.split('filePath=');
            const filePath = urlParts.length > 1 ? decodeURIComponent(urlParts[1]) : previewUrl;
            const fileName = filePath.split('/').pop();
            const fileExt = fileName.split('.').pop().toLowerCase();
            document.getElementById('docFileName').textContent = fileName;

            new bootstrap.Modal(document.getElementById('documentModal')).show();

            setTimeout(() => {
                document.getElementById('docLoading').style.display = 'none';
                if (['jpg','jpeg','png','gif','bmp','webp'].includes(fileExt)) {
                    document.getElementById('docImage').src = previewUrl;
                    document.getElementById('docImageContainer').style.display = 'block';
                } else if (fileExt === 'pdf') {
                    document.getElementById('docPdf').src = previewUrl;
                    document.getElementById('docPdfContainer').style.display = 'block';
                } else {
                    document.getElementById('docUnsupported').style.display = 'block';
                }
            }, 500);
        }

        function toggleImageZoom(img) {
            if (img.style.transform === 'scale(1.5)') {
                img.style.transform = 'scale(1)';
                img.style.cursor = 'zoom-in';
            } else {
                img.style.transform = 'scale(1.5)';
                img.style.cursor = 'zoom-out';
            }
        }

        // Keyboard: T to toggle view
        document.addEventListener('keydown', function (e) {
            if (e.target.closest('input, textarea, select')) return;
            if (e.key === 't' || e.key === 'T') {
                const cardView = document.getElementById('cardView');
                toggleView(cardView.style.display !== 'none' ? 'table' : 'card');
            }
        });
    </script>
}