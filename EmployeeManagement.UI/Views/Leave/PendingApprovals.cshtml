@if (pendingRequests.Count > 1)
{
    <div class="fixed-bottom p-3" style="pointer-events: none;">
        <div class="container">
            <div class="card border-0 shadow-lg" style="border-radius: 16px; pointer-events: auto; max-width: 400px; margin-left: auto;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <small class="text-muted">
                        <strong>@pendingRequests.Count</strong> pending requests
                    </small>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-success" style="border-radius: 20px;"
