@{
    ViewData["Title"] = "Role Management";
    var rolesJson = ViewBag.RolesJson as string ?? "{}";
}

@section Styles {
    <style>
        body {
            background: #f0f2f5;
        }

        .roles-hero {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            padding: 2rem;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
            margin-bottom: 1.5rem;
        }

        .stat-tile {
            background: white;
            border-radius: 12px;
            padding: 1.25rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            text-align: center;
            border-left: 4px solid;
            transition: transform 0.2s;
        }

            .stat-tile:hover {
                transform: translateY(-3px);
            }

            .stat-tile.purple {
                border-left-color: #8b5cf6;
            }

            .stat-tile.blue {
                border-left-color: #3b82f6;
            }

            .stat-tile.green {
                border-left-color: #10b981;
            }

            .stat-tile.red {
                border-left-color: #ef4444;
            }

        .stat-num {
            font-size: 2rem;
            font-weight: 800;
            color: #1e293b;
            margin: 0;
        }

        .stat-label {
            font-size: 0.75rem;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-top: 0.5rem;
        }

        .role-card {
            background: white;
            border-radius: 14px;
            padding: 1.5rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            transition: all 0.3s;
            border: 2px solid transparent;
            position: relative;
            overflow: hidden;
            height: 100%;
        }

            .role-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 12px 25px rgba(0,0,0,0.1);
            }

            .role-card.inactive {
                opacity: 0.6;
                background: #f8fafc;
            }

            .role-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: linear-gradient(135deg, var(--role-color1), var(--role-color2));
            }

        .role-icon-large {
            width: 60px;
            height: 60px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.5rem;
            background: linear-gradient(135deg, var(--role-color1), var(--role-color2));
            box-shadow: 0 6px 15px rgba(0,0,0,0.15);
            margin-bottom: 1rem;
        }

        .role-name {
            font-size: 1.2rem;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 0.5rem;
        }

        .role-desc {
            color: #64748b;
            font-size: 0.85rem;
            line-height: 1.5;
            min-height: 40px;
            margin-bottom: 1rem;
        }

        .role-stats {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem;
            background: #f8fafc;
            border-radius: 10px;
            margin-bottom: 1rem;
        }

        .role-actions {
            display: flex;
            gap: 0.5rem;
        }

        .badge-status {
            padding: 0.3rem 0.65rem;
            border-radius: 12px;
            font-size: 0.7rem;
            font-weight: 700;
            position: absolute;
            top: 1rem;
            right: 1rem;
        }

        .badge-active {
            background: #d1fae5;
            color: #065f46;
        }

        .badge-inactive {
            background: #fee2e2;
            color: #991b1b;
        }

        .btn-add-role {
            background: linear-gradient(135deg, #11998e, #38ef7d);
            color: white;
            border: none;
            border-radius: 10px;
            padding: 0.75rem 1.5rem;
            font-weight: 600;
        }

            .btn-add-role:hover {
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 6px 15px rgba(17, 153, 142, 0.4);
            }

        .modal-content {
            border: none;
            border-radius: 16px;
            overflow: hidden;
        }
        
        /* Loading overlay */
        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .loading-spinner {
            width: 50px;
            height: 50px;
            border: 5px solid rgba(255,255,255,0.3);
            border-radius: 50%;
            border-top-color: white;
            animation: spin 1s linear infinite;
        }
        
        @@keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
}

<div class="container-fluid py-3 pb-5">

    <!-- HERO -->
    <div class="roles-hero">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h2 class="fw-bold mb-1">
                    <i class="bi bi-shield-check me-2"></i>Role Management
                </h2>
                <p class="mb-0 opacity-90">Create and manage system roles</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-light fw-bold" data-bs-toggle="modal" data-bs-target="#createRoleModal">
                    <i class="bi bi-plus-circle me-1"></i>Create Role
                </button>
                <a asp-action="Index" class="btn btn-outline-light">
                    <i class="bi bi-people me-1"></i>Users
                </a>
            </div>
        </div>
    </div>

    <!-- MESSAGES -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- STATS -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="stat-tile purple">
                <h3 class="stat-num" id="totalRoles">0</h3>
                <div class="stat-label">Total Roles</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-tile green">
                <h3 class="stat-num" id="activeRoles">0</h3>
                <div class="stat-label">Active</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-tile red">
                <h3 class="stat-num" id="inactiveRoles">0</h3>
                <div class="stat-label">Inactive</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-tile blue">
                <h3 class="stat-num" id="totalUsers">0</h3>
                <div class="stat-label">Total Users</div>
            </div>
        </div>
    </div>

    <!-- ROLE CARDS GRID -->
    <div class="row g-3" id="rolesGrid">
        <div class="col-12 text-center py-5">
            <div class="spinner-border text-primary"></div>
        </div>
    </div>
    
    <!-- Loading Overlay -->
    <div id="loadingOverlay" class="loading-overlay d-none">
        <div class="loading-spinner"></div>
    </div>
</div>

<!-- CREATE ROLE MODAL -->
<div class="modal fade" id="createRoleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header text-white" style="background: linear-gradient(135deg, #11998e, #38ef7d);">
                <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Create New Role</h5>
                <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="createRoleForm" method="post" action="@Url.Action("CreateRole", "UserManagement")">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Role Name <span class="text-danger">*</span></label>
                        <input type="text" name="roleName" id="createRoleName" class="form-control" required
                               placeholder="e.g., Project Manager" maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Description</label>
                        <textarea name="roleDescription" id="createRoleDescription" class="form-control" rows="3"
                                  placeholder="Brief description of role permissions..." maxlength="500"></textarea>
                        <div class="form-text">
                            <span id="descCharCount">0</span>/500 characters
                        </div>
                    </div>
                    <div class="alert alert-info mb-0 small">
                        <i class="bi bi-info-circle me-1"></i>
                        After creating, you can assign this role to users from the User Management page.
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i>Create Role
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- EDIT ROLE MODAL -->
<div class="modal fade" id="editRoleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header text-white" style="background: linear-gradient(135deg, #fa709a, #fee140);">
                <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Edit Role</h5>
                <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="editRoleForm" asp-controller="UserManagement" asp-action="EditRole" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="roleId" id="editRoleId" />

                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Role Name <span class="text-danger">*</span></label>
                        <input type="text" name="roleName" id="editRoleName" class="form-control" required
                               placeholder="e.g., Project Manager" maxlength="100" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Description</label>
                        <textarea name="roleDescription" id="editRoleDescription" class="form-control" rows="3"
                                  placeholder="Brief description of role permissions..." maxlength="500"></textarea>
                        <div class="form-text">
                            <span id="editDescCharCount">0</span>/500 characters
                        </div>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" name="isActive" id="editRoleActive" class="form-check-input" checked>
                        <label class="form-check-label" for="editRoleActive">
                            <span id="statusLabel">Active</span>
                        </label>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i>Update Role
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- SweetAlert2 CDN -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const rolesResponse = @Html.Raw(string.IsNullOrWhiteSpace(rolesJson) ? "{}" : rolesJson);
        const roles = rolesResponse.data || rolesResponse.Data || [];

        const roleColors = {
            'Admin': ['#ef4444', '#f87171'],
            'HR': ['#f59e0b', '#fbbf24'],
            'Manager': ['#3b82f6', '#60a5fa'],
            'Developer': ['#8b5cf6', '#a78bfa'],
            'QA': ['#10b981', '#34d399'],
            'Payroll': ['#06b6d4', '#22d3ee'],
            'Employee': ['#64748b', '#94a3b8'],
            'Finance': ['#a855f7', '#c084fc']
        };

        const roleIcons = {
            'Admin': 'shield-fill-check',
            'HR': 'people-fill',
            'Manager': 'person-badge-fill',
            'Developer': 'code-slash',
            'QA': 'bug-fill',
            'Payroll': 'cash-coin',
            'Employee': 'person-fill',
            'Finance': 'currency-rupee'
        };

        function getRoleId(role) {
            return role.roleId || role.RoleId || role.id || role.Id;
        }

        function getRoleName(role) {
            return role.roleName || role.RoleName || role.name || role.Name || '';
        }

        function getRoleDescription(role) {
            return role.roleDescription || role.RoleDescription || role.description || role.Description || '';
        }

        function getIsActive(role) {
            const value = role.isActive ?? role.IsActive;
            return value === true || value === 1 || value === 'true' || value === 'True';
        }

        function getUserCount(role) {
            return role.userCount || role.UserCount || 0;
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        $(document).ready(function () {
            console.log("Roles API Response:", rolesResponse);
            console.log("Roles Array:", roles);

            if (Array.isArray(roles) && roles.length > 0) {
                renderRoles(roles);
                updateStats(roles);
            } else {
                showEmpty();
            }

            // Description character counters
            $('#createRoleDescription').on('input', function () {
                $('#descCharCount').text(this.value.length);
            });
            
            $('#editRoleDescription').on('input', function () {
                $('#editDescCharCount').text(this.value.length);
            });

            $('#editRoleActive').on('change', function () {
                $('#statusLabel').text(this.checked ? 'Active' : 'Inactive');
            });

            // Handle form submissions with proper UX
            $('#createRoleForm').off('submit').on('submit', function(e) {
                showLoading();
                
                // Add a small delay to ensure loading state is visible
                setTimeout(() => {
                    // Allow form to submit normally
                }, 200);
            });

            $('#editRoleForm').off('submit').on('submit', function(e) {
                showLoading();
                
                // Add a small delay to ensure loading state is visible
                setTimeout(() => {
                    // Allow form to submit normally
                }, 200);
            });

            $('#roleSearch').on('input', filterRoles);
            $('#statusFilter').on('change', filterRoles);
        });

        function renderRoles(rolesList) {
            const grid = $('#rolesGrid');
            grid.empty();

            if (!rolesList || rolesList.length === 0) {
                showEmpty();
                return;
            }

            rolesList.forEach(function (role, index) {
                const roleId = getRoleId(role);
                const roleName = getRoleName(role);
                const roleDescription = getRoleDescription(role);
                const isActive = getIsActive(role);
                const userCount = getUserCount(role);

                const colors = roleColors[roleName] || ['#667eea', '#764ba2'];
                const icon = roleIcons[roleName] || 'person-circle';

                const safeRoleName = escapeHtml(roleName);
                const safeDesc = escapeHtml(roleDescription || 'No description provided');

                grid.append(`
                    <div class="col-md-4 col-lg-3 role-card-wrapper"
                         data-name="${safeRoleName.toLowerCase()}"
                         data-desc="${safeDesc.toLowerCase()}"
                         data-active="${isActive}"
                         style="animation-delay: ${index * 50}ms">

                        <div class="role-card ${isActive ? '' : 'inactive'}"
                             style="--role-color1: ${colors[0]}; --role-color2: ${colors[1]};">

                            <span class="badge-status ${isActive ? 'badge-active' : 'badge-inactive'}">
                                ${isActive ? 'Active' : 'Inactive'}
                            </span>

                            <div class="role-icon-large">
                                <i class="bi bi-${icon}"></i>
                            </div>

                            <div class="role-name">${safeRoleName}</div>

                            <div class="role-desc">${safeDesc}</div>

                            <div class="role-stats">
                                <i class="bi bi-people-fill text-primary"></i>
                                <strong>${userCount}</strong>
                                <span class="text-muted small">
                                    user${userCount !== 1 ? 's' : ''}
                                </span>
                            </div>

                            <div class="role-actions">
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary flex-fill"
                                        onclick='editRole(${JSON.stringify(role).replace(/"/g, "&quot;")})'>
                                    <i class="bi bi-pencil"></i> Edit
                                </button>

                                ${
                                    userCount === 0
                                    ? `<button type="button"
                                               class="btn btn-sm btn-outline-danger"
                                               onclick="deleteRole(${roleId}, '${safeRoleName.replace(/'/g, "\\'")}')">
                                           <i class="bi bi-trash"></i>
                                       </button>`
                                    : `<button type="button"
                                               class="btn btn-sm btn-outline-secondary"
                                               disabled
                                               title="Cannot delete - users assigned">
                                           <i class="bi bi-lock"></i>
                                       </button>`
                                }
                            </div>
                        </div>
                    </div>
                `);
            });
        }

        function updateStats(rolesList) {
            $('#totalRoles').text(rolesList.length);
            $('#activeRoles').text(rolesList.filter(r => getIsActive(r)).length);
            $('#inactiveRoles').text(rolesList.filter(r => !getIsActive(r)).length);
            $('#totalUsers').text(rolesList.reduce((sum, r) => sum + getUserCount(r), 0));
        }

        function showEmpty() {
            $('#rolesGrid').html(`
                <div class="col-12">
                    <div class="text-center py-5 bg-white rounded shadow-sm">
                        <i class="bi bi-shield-exclamation display-1 text-muted opacity-50"></i>
                        <h4 class="mt-3 text-muted">No roles found</h4>
                        <p class="text-muted">Create your first role to get started</p>
                        <button type="button" class="btn btn-primary mt-2" data-bs-toggle="modal" data-bs-target="#createRoleModal">
                            <i class="bi bi-plus-circle me-1"></i>Create Role
                        </button>
                    </div>
                </div>
            `);
        }

        function filterRoles() {
            const query = $('#roleSearch').val().toLowerCase().trim();
            const status = $('#statusFilter').val();

            $('.role-card-wrapper').each(function () {
                const card = $(this);
                const name = card.data('name') || '';
                const desc = card.data('desc') || '';
                const isActive = card.data('active') === true || card.data('active') === 'true';

                const matchSearch = !query || name.includes(query) || desc.includes(query);
                const matchStatus =
                    status === 'all' ||
                    (status === 'active' && isActive) ||
                    (status === 'inactive' && !isActive);

                card.toggleClass('hidden', !(matchSearch && matchStatus));
            });

            const visibleCount = $('.role-card-wrapper:not(.hidden)').length;

            if (visibleCount === 0 && (query || status !== 'all')) {
                if (!$('.no-results-message').length) {
                    $('#rolesGrid').append(`
                        <div class="no-results-message col-12 text-center py-4 text-muted">
                            <i class="bi bi-search fs-1 opacity-50"></i>
                            <h5 class="mt-2">No roles match your search</h5>
                            <p class="small">Try different keywords or clear filters</p>
                        </div>
                    `);
                }
            } else {
                $('.no-results-message').remove();
            }
        }

        function editRole(role) {
            $('#editRoleId').val(getRoleId(role));
            $('#editRoleName').val(getRoleName(role));
            $('#editRoleDescription').val(getRoleDescription(role));
            $('#editRoleActive').prop('checked', getIsActive(role));
            $('#statusLabel').text(getIsActive(role) ? 'Active' : 'Inactive');
            
            // Update character counter for edit description
            $('#editDescCharCount').text($('#editRoleDescription').val().length);

            new bootstrap.Modal(document.getElementById('editRoleModal')).show();
        }

        async function deleteRole(id, name) {
            const confirmResult = await Swal.fire({
                title: 'Delete Role?',
                html: `Are you sure you want to delete <strong>${escapeHtml(name)}</strong>?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Delete',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#ef4444'
            });

            if (!confirmResult.isConfirmed) return;

            showLoading();
            
            try {
                const response = await fetch('/UserManagement/DeleteRole', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    body: `id=${encodeURIComponent(id)}`
                });

                const data = await response.json();

                hideLoading();
                
                if (data.success) {
                    await Swal.fire('Deleted', data.message || 'Role deleted successfully', 'success');
                    window.location.href = '/UserManagement/Roles';
                } else {
                    Swal.fire('Cannot Delete', data.message || 'Failed to delete role', 'error');
                }
            } catch (error) {
                hideLoading();
                Swal.fire('Error', error.message || 'Something went wrong', 'error');
            }
        }
        
        function showLoading() {
            $('#loadingOverlay').removeClass('d-none');
        }
        
        function hideLoading() {
            $('#loadingOverlay').addClass('d-none');
        }
    </script>
}