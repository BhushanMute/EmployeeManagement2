@{
    ViewData["Title"] = "Role Management";
    var rolesJson = ViewBag.RolesJson as string ?? "{}";
}

@section Styles {
    <style>
        body {
            background: #f0f2f5;
        }

        .roles-hero {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            padding: 2rem;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
            margin-bottom: 1.5rem;
        }

        .stat-tile {
            background: white;
            border-radius: 12px;
            padding: 1.25rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            text-align: center;
            border-left: 4px solid;
            transition: transform 0.2s;
        }

            .stat-tile:hover {
                transform: translateY(-3px);
            }

            .stat-tile.purple {
                border-left-color: #8b5cf6;
            }

            .stat-tile.blue {
                border-left-color: #3b82f6;
            }

            .stat-tile.green {
                border-left-color: #10b981;
            }

            .stat-tile.red {
                border-left-color: #ef4444;
            }

        .stat-num {
            font-size: 2rem;
            font-weight: 800;
            color: #1e293b;
            margin: 0;
        }

        .stat-label {
            font-size: 0.75rem;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-top: 0.5rem;
        }

        .role-card {
            background: white;
            border-radius: 14px;
            padding: 1.5rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            transition: all 0.3s;
            border: 2px solid transparent;
            position: relative;
            overflow: hidden;
            height: 100%;
        }

            .role-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 12px 25px rgba(0,0,0,0.1);
            }

            .role-card.inactive {
                opacity: 0.6;
                background: #f8fafc;
            }

            .role-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: linear-gradient(135deg, var(--role-color1), var(--role-color2));
            }

        .role-icon-large {
            width: 60px;
            height: 60px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.5rem;
            background: linear-gradient(135deg, var(--role-color1), var(--role-color2));
            box-shadow: 0 6px 15px rgba(0,0,0,0.15);
            margin-bottom: 1rem;
        }

        .role-name {
            font-size: 1.2rem;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 0.5rem;
        }

        .role-desc {
            color: #64748b;
            font-size: 0.85rem;
            line-height: 1.5;
            min-height: 40px;
            margin-bottom: 1rem;
        }

        .role-stats {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem;
            background: #f8fafc;
            border-radius: 10px;
            margin-bottom: 1rem;
        }

        .role-actions {
            display: flex;
            gap: 0.5rem;
        }

        .badge-status {
            padding: 0.3rem 0.65rem;
            border-radius: 12px;
            font-size: 0.7rem;
            font-weight: 700;
            position: absolute;
            top: 1rem;
            right: 1rem;
        }

        .badge-active {
            background: #d1fae5;
            color: #065f46;
        }

        .badge-inactive {
            background: #fee2e2;
            color: #991b1b;
        }

        .btn-add-role {
            background: linear-gradient(135deg, #11998e, #38ef7d);
            color: white;
            border: none;
            border-radius: 10px;
            padding: 0.75rem 1.5rem;
            font-weight: 600;
        }

            .btn-add-role:hover {
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 6px 15px rgba(17, 153, 142, 0.4);
            }

        .modal-content {
            border: none;
            border-radius: 16px;
            overflow: hidden;
        }
    </style>
}

<div class="container-fluid py-3 pb-5">

    <!-- HERO -->
    <div class="roles-hero">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h2 class="fw-bold mb-1">
                    <i class="bi bi-shield-check me-2"></i>Role Management
                </h2>
                <p class="mb-0 opacity-90">Create and manage system roles</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-light fw-bold" data-bs-toggle="modal" data-bs-target="#createRoleModal">
                    <i class="bi bi-plus-circle me-1"></i>Create Role
                </button>
                <a asp-action="Index" class="btn btn-outline-light">
                    <i class="bi bi-people me-1"></i>Users
                </a>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- STATS -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="stat-tile purple">
                <h3 class="stat-num" id="totalRoles">0</h3>
                <div class="stat-label">Total Roles</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-tile green">
                <h3 class="stat-num" id="activeRoles">0</h3>
                <div class="stat-label">Active</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-tile red">
                <h3 class="stat-num" id="inactiveRoles">0</h3>
                <div class="stat-label">Inactive</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-tile blue">
                <h3 class="stat-num" id="totalUsers">0</h3>
                <div class="stat-label">Total Users</div>
            </div>
        </div>
    </div>

    <!-- ROLE CARDS GRID -->
    <div class="row g-3" id="rolesGrid">
        <div class="col-12 text-center py-5">
            <div class="spinner-border text-primary"></div>
        </div>
    </div>
</div>

<!-- CREATE ROLE MODAL -->
<div class="modal fade" id="createRoleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header text-white" style="background: linear-gradient(135deg, #11998e, #38ef7d);">
                <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Create New Role</h5>
                <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/UserManagement/CreateRole" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Role Name <span class="text-danger">*</span></label>
                        <input type="text" name="roleName" class="form-control" required
                               placeholder="e.g., Project Manager" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Description</label>
                        <textarea name="roleDescription" class="form-control" rows="3"
                                  placeholder="Brief description of role permissions..."></textarea>
                    </div>
                    <div class="alert alert-info mb-0 small">
                        <i class="bi bi-info-circle me-1"></i>
                        After creating, you can assign this role to users from the User Management page.
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i>Create Role
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- EDIT ROLE MODAL -->
<div class="modal fade" id="editRoleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header text-white" style="background: linear-gradient(135deg, #fa709a, #fee140);">
                <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Edit Role</h5>
                <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="EditRole" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="roleId" id="editRoleId" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Role Name <span class="text-danger">*</span></label>
                        <input type="text" name="roleName" id="editRoleName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Description</label>
                        <textarea name="roleDescription" id="editRoleDesc" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="isActive"
                               id="editRoleActive" value="true" />
                        <label class="form-check-label fw-bold" for="editRoleActive">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning text-white">
                        <i class="bi bi-check-circle me-1"></i>Update Role
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const rolesData = @Html.Raw(rolesJson);

        const roleColors = {
            'Admin': ['#ef4444', '#f87171'],
            'HR': ['#f59e0b', '#fbbf24'],
            'Manager': ['#3b82f6', '#60a5fa'],
            'Developer': ['#8b5cf6', '#a78bfa'],
            'QA': ['#10b981', '#34d399'],
            'Payroll': ['#06b6d4', '#22d3ee'],
            'Employee': ['#64748b', '#94a3b8'],
            'Finance': ['#a855f7', '#c084fc']
        };

        const roleIcons = {
            'Admin': 'shield-fill-check', 'HR': 'people-fill',
            'Manager': 'person-badge-fill', 'Developer': 'code-slash',
            'QA': 'bug-fill', 'Payroll': 'cash-coin',
            'Employee': 'person-fill', 'Finance': 'currency-rupee'
        };

        $(document).ready(function() {
            if (rolesData?.data) {
                renderRoles(rolesData.data);
                updateStats(rolesData.data);
            } else {
                showEmpty();
            }
        });

        function renderRoles(roles) {
            const grid = $('#rolesGrid');
            grid.empty();

            if (!roles.length) {
                showEmpty();
                return;
            }

            roles.forEach(role => {
                const colors = roleColors[role.roleName] || ['#667eea', '#764ba2'];
                const icon = roleIcons[role.roleName] || 'person-circle';
                const statusClass = role.isActive ? 'badge-active' : 'badge-inactive';
                const statusText = role.isActive ? 'Active' : 'Inactive';
                const cardClass = role.isActive ? '' : 'inactive';

                grid.append(`
                    <div class="col-md-4 col-lg-3">
                        <div class="role-card ${cardClass}" style="--role-color1: ${colors[0]}; --role-color2: ${colors[1]};">
                            <span class="badge-status ${statusClass}">${statusText}</span>
                            <div class="role-icon-large">
                                <i class="bi bi-${icon}"></i>
                            </div>
                            <div class="role-name">${role.roleName}</div>
                            <div class="role-desc">${role.roleDescription || 'No description provided'}</div>

                            <div class="role-stats">
                                <i class="bi bi-people-fill text-primary"></i>
                                <strong>${role.userCount}</strong>
                                <span class="text-muted small">user${role.userCount !== 1 ? 's' : ''}</span>
                            </div>

                            <div class="role-actions">
                                <button class="btn btn-sm btn-outline-primary flex-fill"
                                        onclick='editRole(${JSON.stringify(role)})'>
                                    <i class="bi bi-pencil"></i> Edit
                                </button>
                                ${role.userCount === 0 ?
                                    `<button class="btn btn-sm btn-outline-danger"
                                            onclick="deleteRole(${role.roleId}, '${role.roleName}')">
                                        <i class="bi bi-trash"></i>
                                    </button>` :
                                    `<button class="btn btn-sm btn-outline-secondary" disabled
                                            title="Cannot delete - users assigned">
                                        <i class="bi bi-lock"></i>
                                    </button>`
                                }
                            </div>
                        </div>
                    </div>
                `);
            });
        }

        function updateStats(roles) {
            $('#totalRoles').text(roles.length);
            $('#activeRoles').text(roles.filter(r => r.isActive).length);
            $('#inactiveRoles').text(roles.filter(r => !r.isActive).length);
            $('#totalUsers').text(roles.reduce((sum, r) => sum + r.userCount, 0));
        }

        function showEmpty() {
            $('#rolesGrid').html(`
                <div class="col-12">
                    <div class="text-center py-5 bg-white rounded shadow-sm">
                        <i class="bi bi-shield-exclamation display-1 text-muted opacity-50"></i>
                        <h4 class="mt-3 text-muted">No roles created yet</h4>
                        <p class="text-muted">Create your first role to get started</p>
                        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createRoleModal">
                            <i class="bi bi-plus-circle me-1"></i>Create Role
                        </button>
                    </div>
                </div>
            `);
        }

        function editRole(role) {
            $('#editRoleId').val(role.roleId);
            $('#editRoleName').val(role.roleName);
            $('#editRoleDesc').val(role.roleDescription || '');
            $('#editRoleActive').prop('checked', role.isActive);
            new bootstrap.Modal('#editRoleModal').show();
        }

        async function deleteRole(id, name) {
            if (!confirm(`⚠️ Delete role "${name}"?\n\nThis cannot be undone.`)) return;

            const fd = new FormData();
            fd.append('id', id);

            try {
                const res = await fetch('/UserManagement/DeleteRole', { method: 'POST', body: fd });
                const result = await res.json();
                if (result.success) {
                    alert('✅ Role deleted!');
                    location.reload();
                } else {
                    alert('❌ ' + (result.message || 'Failed to delete'));
                }
            } catch (err) {
                alert('Error: ' + err.message);
            }
        }
    </script>
}