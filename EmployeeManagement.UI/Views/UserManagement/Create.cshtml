
@{
    ViewData["Title"] = "Create New User";

    var dropdownsJson = ViewBag.DropdownsJson as string;

    if (string.IsNullOrWhiteSpace(dropdownsJson))
    {
        dropdownsJson = "{\"status\":true,\"message\":\"ViewFallback\",\"data\":{\"roles\":[],\"departments\":[],\"designations\":[]}}";
    }
}

@section Styles {
    <style>
        body { background: #f0f2f5; }

        .create-hero {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            color: white;
            padding: 2rem;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(17, 153, 142, 0.3);
            margin-bottom: 1.5rem;
        }

        .stepper {
            background: white;
            border-radius: 14px;
            padding: 1.5rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            margin-bottom: 1.5rem;
            display: flex;
            justify-content: space-between;
            position: relative;
        }

        .step {
            flex: 1;
            text-align: center;
            position: relative;
            z-index: 2;
        }

        .step:not(:last-child)::after {
            content: '';
            position: absolute;
            top: 22px;
            left: calc(50% + 25px);
            right: calc(-50% + 25px);
            height: 3px;
            background: #e2e8f0;
            z-index: 1;
        }

        .step.completed:not(:last-child)::after {
            background: linear-gradient(90deg, #11998e, #38ef7d);
        }

        .step-icon {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: #e2e8f0;
            color: #94a3b8;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            font-weight: 700;
            transition: all 0.3s;
            position: relative;
            z-index: 2;
        }

        .step.active .step-icon {
            background: linear-gradient(135deg, #11998e, #38ef7d);
            color: white;
            transform: scale(1.15);
            box-shadow: 0 6px 15px rgba(17, 153, 142, 0.4);
        }

        .step.completed .step-icon {
            background: linear-gradient(135deg, #11998e, #38ef7d);
            color: white;
        }

        .step-label {
            margin-top: 0.5rem;
            font-size: 0.85rem;
            font-weight: 600;
            color: #64748b;
        }

        .step.active .step-label { color: #11998e; }
        .step.completed .step-label { color: #10b981; }

        .form-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            overflow: hidden;
        }

        .form-step {
            display: none;
            padding: 2rem;
            animation: fadeSlide 0.4s ease;
        }

        .form-step.active { display: block; }

        @@keyframes fadeSlide {
            from { opacity: 0; transform: translateX(20px); }
            to { opacity: 1; transform: translateX(0); }
        }

        .step-title {
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 0.5rem;
        }

        .step-subtitle {
            color: #64748b;
            margin-bottom: 1.5rem;
        }

        .form-label {
            font-weight: 600;
            color: #334155;
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
        }

        .form-control, .form-select {
            border-radius: 10px;
            border: 1.5px solid #e2e8f0;
            padding: 0.65rem 1rem;
            transition: all 0.2s;
        }

        .form-control:focus, .form-select:focus {
            border-color: #11998e;
            box-shadow: 0 0 0 3px rgba(17, 153, 142, 0.15);
        }

        .required { color: #ef4444; }

        .role-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
            gap: 0.75rem;
        }

        .role-card {
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 1rem;
            cursor: pointer;
            transition: all 0.2s;
            background: white;
            position: relative;
            min-height: 150px;
        }

        .role-card:hover {
            transform: translateY(-2px);
            border-color: #11998e;
            box-shadow: 0 6px 15px rgba(17, 153, 142, 0.15);
        }

        .role-card.selected {
            border-color: #11998e;
            background: linear-gradient(135deg, #d1fae5, #ffffff);
        }

        .role-card .check-icon {
            position: absolute;
            top: 0.5rem;
            right: 0.5rem;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #11998e;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            opacity: 0;
            transition: all 0.2s;
        }

        .role-card.selected .check-icon { opacity: 1; }

        .role-icon {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.4rem;
            margin-bottom: 0.75rem;
        }

        .role-name {
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 0.25rem;
        }

        .role-desc {
            font-size: 0.8rem;
            color: #64748b;
            line-height: 1.4;
        }

        .password-strength {
            height: 6px;
            background: #e2e8f0;
            border-radius: 3px;
            margin-top: 0.5rem;
            overflow: hidden;
        }

        .password-strength-bar {
            height: 100%;
            transition: all 0.3s;
            border-radius: 3px;
            width: 0%;
        }

        .strength-weak { background: #ef4444; width: 33%; }
        .strength-medium { background: #f59e0b; width: 66%; }
        .strength-strong { background: #10b981; width: 100%; }

        .summary-card {
            background: linear-gradient(135deg, #f8fafc, #ffffff);
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 1.25rem;
            margin-bottom: 1rem;
            height: 100%;
        }

        .summary-section { margin-bottom: 1rem; }

        .summary-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #64748b;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .summary-value {
            font-size: 1rem;
            color: #1e293b;
            font-weight: 600;
        }

        .btn-step {
            border-radius: 10px;
            padding: 0.75rem 1.5rem;
            font-weight: 600;
            transition: all 0.3s;
        }

        .btn-next {
            background: linear-gradient(135deg, #11998e, #38ef7d);
            color: white;
            border: none;
        }

        .btn-next:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(17, 153, 142, 0.4);
        }

        .btn-submit-final {
            background: linear-gradient(135deg, #4facfe, #00f2fe);
            color: white;
            border: none;
            padding: 0.85rem 2rem;
            font-weight: 700;
            border-radius: 12px;
        }

        .btn-submit-final:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(79, 172, 254, 0.4);
        }

        .invalid-feedback {
            display: block;
            font-size: 0.8rem;
        }

        .form-control.is-invalid,
        .form-select.is-invalid {
            border-color: #ef4444;
        }

        .form-control.is-valid,
        .form-select.is-valid {
            border-color: #10b981;
        }

        @@media (max-width: 768px) {
            .stepper { padding: 1rem 0.5rem; }
            .step-label { font-size: 0.7rem; }
            .step-icon { width: 36px; height: 36px; }
            .form-step { padding: 1.25rem; }
        }
        /* Selected role preview */
        .selected-roles-preview {
            background: linear-gradient(135deg, #f0f9ff, #ffffff);
            border: 2px dashed #3b82f6;
            border-radius: 10px;
            padding: 1rem;
        }

            .selected-roles-preview .badge {
                font-size: 0.85rem;
                padding: 0.5rem 0.75rem;
            }

                .selected-roles-preview .badge i.bi-x-circle {
                    cursor: pointer;
                    transition: transform 0.2s;
                }

                    .selected-roles-preview .badge i.bi-x-circle:hover {
                        transform: scale(1.2);
                    }

        /* Department section styling */
        .dept-section {
            background: linear-gradient(135deg, #fafbfc, #ffffff);
            border-radius: 12px;
            padding: 1.5rem;
            border: 1px solid #e2e8f0;
        }

        /* Smart suggestion box */
        #roleDeptInfo {
            animation: slideInDown 0.3s ease;
        }

        @@keyframes slideInDown {
            from

        {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        /* Employee code prefix */
        #codePrefix {
            font-family: 'Courier New', monospace;
            font-weight: 700;
            color: #6366f1;
        }

        /* Generate button hover */
        #generateCodeBtn:hover {
            color: #6366f1 !important;
            transform: scale(1.05);
        }

        /* Hidden role cards (smooth) */
        .role-card {
            transition: all 0.3s ease;
        }

            .role-card[style*="display: none"] {
                opacity: 0;
                transform: scale(0.95);
            }
    </style>
}

<div class="container py-3 pb-5">

    <!-- HERO -->
    <div class="create-hero">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h2 class="fw-bold mb-1">
                    <i class="bi bi-person-plus me-2"></i>Create New User
                </h2>
                <p class="mb-0 opacity-90">Register a new user with role assignment</p>
            </div>
            <a asp-action="Index" class="btn btn-light fw-semibold">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- STEPPER -->
    <div class="stepper">
        <div class="step active" data-step="1">
            <div class="step-icon">1</div>
            <div class="step-label">Basic Info</div>
        </div>
        <div class="step" data-step="2">
            <div class="step-icon">2</div>
            <div class="step-label">Security</div>
        </div>
        <div class="step" data-step="3">
            <div class="step-icon">3</div>
            <div class="step-label">Role & Department</div>
        </div>
        <div class="step" data-step="4">
            <div class="step-icon">4</div>
            <div class="step-label">Review & Create</div>
        </div>
    </div>

    <!-- FORM -->
    <form asp-action="Create" method="post" id="createUserForm" autocomplete="off">
        @Html.AntiForgeryToken()

        <div class="form-card">

            <!-- STEP 1: BASIC INFO -->
            <div class="form-step active" id="step1">
                <h4 class="step-title">
                    <i class="bi bi-person-circle text-primary me-2"></i>Basic Information
                </h4>
                <p class="step-subtitle">Enter user personal details</p>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Full Name <span class="required">*</span></label>
                        <input type="text" name="fullName" id="fullName" class="form-control"
                               required placeholder="e.g., John Doe" />
                        <div class="invalid-feedback d-none" id="fullNameError">
                            Full name is required
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Username <span class="required">*</span></label>
                        <input type="text" name="username" id="username" class="form-control"
                               required minlength="3" pattern="[a-zA-Z0-9_]+"
                               placeholder="e.g., johndoe" />
                        <small class="text-muted">Letters, numbers and underscore only</small>
                        <div class="invalid-feedback d-none" id="usernameError">
                            Username is required and minimum 3 characters
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Email Address <span class="required">*</span></label>
                        <input type="email" name="email" id="email" class="form-control"
                               required placeholder="user@@company.com" />
                        <div class="invalid-feedback d-none" id="emailError">
                            Valid email address is required
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Phone Number</label>
                        <input type="tel" name="phoneNumber" id="phoneNumber" class="form-control"
                               placeholder="e.g., +91-9876543210" />
                    </div>
                </div>
            </div>

            <!-- STEP 2: SECURITY -->
            <div class="form-step" id="step2">
                <h4 class="step-title">
                    <i class="bi bi-shield-lock text-warning me-2"></i>Security Setup
                </h4>
                <p class="step-subtitle">Set a strong password for the user</p>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Password <span class="required">*</span></label>
                        <div class="input-group">
                            <input type="password" name="password" id="password" class="form-control"
                                   required minlength="6" placeholder="Enter strong password" />
                            <button type="button" class="btn btn-outline-secondary" id="togglePwd1">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <div class="password-strength">
                            <div class="password-strength-bar" id="strengthBar"></div>
                        </div>
                        <small class="text-muted" id="strengthText">Minimum 6 characters</small>
                        <div class="invalid-feedback d-none" id="passwordError">
                            Password must be at least 6 characters
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Confirm Password <span class="required">*</span></label>
                        <div class="input-group">
                            <input type="password" id="confirmPassword" class="form-control"
                                   required placeholder="Re-enter password" />
                            <button type="button" class="btn btn-outline-secondary" id="togglePwd2">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <small class="text-danger d-none" id="pwdMismatch">Passwords do not match</small>
                    </div>

                    <div class="col-12">
                        <div class="alert alert-info mb-0">
                            <h6 class="alert-heading">
                                <i class="bi bi-info-circle me-1"></i>Password Requirements
                            </h6>
                            <ul class="mb-0 small" id="pwdRules">
                                <li id="rule-length">At least 6 characters</li>
                                <li id="rule-uppercase">Contains uppercase letter</li>
                                <li id="rule-number">Contains a number</li>
                                <li id="rule-special">Contains special character</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-step" id="step3">
                <h4 class="step-title">
                    <i class="bi bi-people text-info me-2"></i>Role & Department Assignment
                </h4>
                <p class="step-subtitle">Select roles and assign department</p>

                <input type="hidden" name="roleIds" id="roleIdsInput" />

                <!-- ===== ROLE SELECTION ===== -->
                <div class="mb-4">
                    <label class="form-label mb-3 d-flex justify-content-between align-items-center">
                        <span>
                            <i class="bi bi-shield-check me-1"></i>
                            Select Roles <span class="required">*</span>
                            <small class="text-muted">(Multiple roles allowed)</small>
                        </span>
                        <span class="badge bg-primary" id="selectedRoleCount">0 selected</span>
                    </label>

                    <!-- Role Search Filter -->
                    <div class="input-group mb-3" style="max-width: 400px;">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="roleSearch" class="form-control"
                               placeholder="Search roles..." />
                    </div>

                    <div class="role-grid" id="roleGrid">
                        <div class="text-center text-muted py-3">
                            <div class="spinner-border spinner-border-sm"></div>
                            Loading roles...
                        </div>
                    </div>

                    <div class="invalid-feedback d-none mt-2" id="roleError">
                        Please select at least one role
                    </div>

                    <!-- Selected Roles Preview -->
                    <div class="selected-roles-preview mt-3 d-none" id="selectedRolesPreview">
                        <small class="text-muted fw-bold">Selected Roles:</small>
                        <div id="selectedRolesBadges" class="mt-2"></div>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- ===== DEPARTMENT SECTION ===== -->
                <div class="dept-section">
                    <h6 class="fw-bold mb-3 text-muted">
                        <i class="bi bi-building me-1"></i>Department Information
                        <small class="text-muted fw-normal" id="deptRequired" style="display:none;">
                            (Required for selected role)
                        </small>
                    </h6>

                    <div class="row g-3">
                        <!-- Department Dropdown -->
                        <div class="col-md-4">
                            <label class="form-label">
                                Department
                                <span class="required d-none" id="deptStar">*</span>
                            </label>
                            <select name="departmentId" id="departmentId" class="form-select">
                                <option value="">-- Select Department --</option>
                            </select>
                            <small class="text-muted">Choose user's department</small>
                            <div class="invalid-feedback d-none" id="deptError">
                                Department is required for this role
                            </div>
                        </div>

                        <!-- Designation Dropdown (filtered by department) -->
                        <div class="col-md-4">
                            <label class="form-label">
                                Designation
                                <small class="text-muted" id="desigHint" style="display:none;">
                                    (Select department first)
                                </small>
                            </label>
                            <select name="designationId" id="designationId" class="form-select" disabled>
                                <option value="">-- Select Designation --</option>
                            </select>
                            <small class="text-muted">Filtered by department</small>
                        </div>

                        <!-- Employee Code with Auto-Generate -->
                        <div class="col-md-4">
                            <label class="form-label d-flex justify-content-between">
                                <span>Employee Code</span>
                                <button type="button" class="btn btn-link btn-sm p-0"
                                        id="generateCodeBtn" title="Auto-generate code">
                                    <i class="bi bi-magic"></i> Auto-generate
                                </button>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light fw-bold" id="codePrefix">EMP-</span>
                                <input type="text" name="employeeCode" id="employeeCode"
                                       class="form-control" placeholder="001" />
                            </div>
                            <small class="text-muted">Unique code (e.g., EMP-IT-001)</small>
                        </div>
                    </div>

                    <!-- ===== ROLE-DEPT MAPPING INFO ===== -->
                    <div class="alert alert-info mt-3 d-none" id="roleDeptInfo">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>Smart Suggestion:</strong>
                        <span id="suggestionText"></span>
                    </div>
                </div>
            </div>
            <!-- STEP 4: REVIEW -->
            <div class="form-step" id="step4">
                <h4 class="step-title">
                    <i class="bi bi-check-circle text-success me-2"></i>Review & Confirm
                </h4>
                <p class="step-subtitle">Verify all details before creating user</p>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="summary-card">
                            <h6 class="text-primary fw-bold mb-3">
                                <i class="bi bi-person-circle me-1"></i>Basic Information
                            </h6>
                            <div class="summary-section">
                                <div class="summary-label">Full Name</div>
                                <div class="summary-value" id="sumFullName">-</div>
                            </div>
                            <div class="summary-section">
                                <div class="summary-label">Username</div>
                                <div class="summary-value" id="sumUsername">-</div>
                            </div>
                            <div class="summary-section">
                                <div class="summary-label">Email</div>
                                <div class="summary-value" id="sumEmail">-</div>
                            </div>
                            <div class="summary-section mb-0">
                                <div class="summary-label">Phone</div>
                                <div class="summary-value" id="sumPhone">-</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="summary-card">
                            <h6 class="text-info fw-bold mb-3">
                                <i class="bi bi-shield-check me-1"></i>Role & Department
                            </h6>
                            <div class="summary-section">
                                <div class="summary-label">Assigned Roles</div>
                                <div class="summary-value" id="sumRoles">-</div>
                            </div>
                            <div class="summary-section">
                                <div class="summary-label">Department</div>
                                <div class="summary-value" id="sumDepartment">-</div>
                            </div>
                            <div class="summary-section">
                                <div class="summary-label">Designation</div>
                                <div class="summary-value" id="sumDesignation">-</div>
                            </div>
                            <div class="summary-section mb-0">
                                <div class="summary-label">Employee Code</div>
                                <div class="summary-value" id="sumEmpCode">-</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="alert alert-warning d-flex align-items-center">
                            <i class="bi bi-exclamation-triangle me-2 fs-4"></i>
                            <div>
                                <strong>Important:</strong>
                                Please verify all details before creating this user account.
                            </div>
                        </div>

                        <div class="form-check">
                            <input type="checkbox" id="confirmCheck" class="form-check-input" required />
                            <label class="form-check-label" for="confirmCheck">
                                I confirm that all information is correct.
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ✅ FIXED: NAVIGATION BUTTONS (NO inline onclick) -->
            <div class="d-flex justify-content-between p-3 border-top bg-light">
                <button type="button" class="btn btn-step btn-outline-secondary" id="prevBtn" style="display:none;">
                    <i class="bi bi-arrow-left me-1"></i>Previous
                </button>
                <div></div>
                <button type="button" class="btn btn-step btn-next" id="nextBtn">
                    Next <i class="bi bi-arrow-right ms-1"></i>
                </button>
                <button type="submit" class="btn-submit-final" id="submitBtn" style="display:none;" disabled>
                    <i class="bi bi-check-circle me-1"></i>Create User
                </button>
            </div>
        </div>
    </form>
</div>
@section Scripts {
    <script>
        const dropdownData = @Html.Raw(dropdownsJson);

        console.log("RAW DROPDOWN DATA FROM VIEW:", dropdownData);

        let currentStep = 1;
        const totalSteps = 4;

        let selectedRoles = [];
        let allRoles = [];
        let allDepartments = [];
        let allDesignations = [];

        const ROLES_REQUIRING_DEPT = ['Employee', 'Manager', 'Developer', 'QA', 'HR'];
        const SYSTEM_ROLES = ['Admin', 'SuperAdmin'];

        function escapeHtml(value) {
            if (value === null || value === undefined) return '';

            return String(value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function isValidEmail(email) {
            const pattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            return pattern.test(email);
        }

        function hasSpecialChar(password) {
            return /[!@@#\$%\^&\*]/.test(password);
        }

        function getRoleId(role) {
            return role.roleId ?? role.RoleId ?? role.id ?? role.Id;
        }

        function getRoleName(role) {
            return role.roleName ?? role.RoleName ?? role.name ?? role.Name ?? '';
        }

        function getRoleDescription(role) {
            return role.roleDescription ?? role.RoleDescription ?? role.description ?? role.Description ?? 'No description';
        }

        function isRoleActive(role) {
            const value = role.isActive ?? role.IsActive;

            if (value === undefined || value === null) return true;

            return value === true || value === 1 || value === 'true';
        }

        function getItemId(item) {
            return item.id ??
                item.Id ??
                item.departmentId ??
                item.DepartmentId ??
                item.designationId ??
                item.DesignationId;
        }

        function getItemName(item) {
            return item.name ??
                item.Name ??
                item.departmentName ??
                item.DepartmentName ??
                item.designationName ??
                item.DesignationName ??
                '';
        }

        function getDesignationDepartmentId(item) {
            return item.departmentId ?? item.DepartmentId;
        }

        function loadDropdownData() {
            const data = dropdownData.data || dropdownData.Data || {};

            allRoles = data.roles || data.Roles || [];
            allDepartments = data.departments || data.Departments || [];
            allDesignations = data.designations || data.Designations || [];

            console.log('Roles:', allRoles);
            console.log('Departments:', allDepartments);
            console.log('Designations:', allDesignations);

            renderRoles();
            renderDepartments();
            renderDesignations();
        }

        function renderRoles() {
            const grid = $('#roleGrid');
            grid.empty();

            if (!allRoles.length) {
                grid.html('<div class="alert alert-warning mb-0">No roles available. Please create roles first.</div>');
                return;
            }

            const roleColors = {
                'Admin': '#ef4444',
                'HR': '#f59e0b',
                'Manager': '#3b82f6',
                'Developer': '#8b5cf6',
                'QA': '#10b981',
                'Payroll': '#06b6d4',
                'Employee': '#64748b',
                'Finance': '#a855f7'
            };

            const roleIcons = {
                'Admin': 'shield-fill-check',
                'HR': 'people-fill',
                'Manager': 'person-badge-fill',
                'Developer': 'code-slash',
                'QA': 'bug-fill',
                'Payroll': 'cash-coin',
                'Employee': 'person-fill',
                'Finance': 'currency-rupee'
            };

            let activeRoleCount = 0;

            allRoles.forEach(function (role) {
                if (!isRoleActive(role)) return;

                const roleId = getRoleId(role);
                const roleName = getRoleName(role);
                const roleDescription = getRoleDescription(role);

                if (!roleId || !roleName) return;

                activeRoleCount++;

                const color = roleColors[roleName] || '#667eea';
                const icon = roleIcons[roleName] || 'person-circle';

                grid.append(
                    '<div class="role-card" data-id="' + escapeHtml(roleId) + '" data-name="' + escapeHtml(roleName) + '">' +
                        '<div class="check-icon"><i class="bi bi-check-lg"></i></div>' +
                        '<div class="role-icon" style="background:' + color + '">' +
                            '<i class="bi bi-' + icon + '"></i>' +
                        '</div>' +
                        '<div class="role-name">' + escapeHtml(roleName) + '</div>' +
                        '<div class="role-desc">' + escapeHtml(roleDescription) + '</div>' +
                    '</div>'
                );
            });

            if (activeRoleCount === 0) {
                grid.html('<div class="alert alert-warning mb-0">No active roles available.</div>');
            }
        }

        function renderDepartments() {
            const select = $('#departmentId');

            select.empty();
            select.append('<option value="">-- Select Department --</option>');

            console.log("Binding departments count:", allDepartments.length);

            allDepartments.forEach(function (dept) {
                const id = getItemId(dept);
                const name = getItemName(dept);

                console.log("Department:", id, name);

                if (id && name) {
                    select.append(
                        '<option value="' + escapeHtml(id) + '">' +
                        escapeHtml(name) +
                        '</option>'
                    );
                }
            });
        }

        function renderDesignations() {
            const select = $('#designationId');

            select.empty();
            select.append('<option value="">-- Select Designation --</option>');
            select.prop('disabled', true);

            $('#desigHint').text('(Select department first)').show();
        }

        function bindDesignationsByDepartment(deptId) {
            const desigSelect = $('#designationId');

            desigSelect.empty();
            desigSelect.append('<option value="">-- Select Designation --</option>');
            desigSelect.prop('disabled', true);

            if (!deptId) {
                $('#desigHint').text('(Select department first)').show();
                return;
            }

            const filteredDesignations = allDesignations.filter(function (d) {
                const designationDeptId = getDesignationDepartmentId(d);

                return designationDeptId &&
                    designationDeptId.toString() === deptId.toString();
            });

            if (filteredDesignations.length === 0) {
                desigSelect.append('<option value="">No designation found</option>');
                $('#desigHint').text('(No designation found)').show();
                return;
            }

            filteredDesignations.forEach(function (d) {
                const id = getItemId(d);
                const name = getItemName(d);

                if (id && name) {
                    desigSelect.append(
                        '<option value="' + escapeHtml(id) + '">' +
                        escapeHtml(name) +
                        '</option>'
                    );
                }
            });

            desigSelect.prop('disabled', false);
            $('#desigHint').hide();
        }

        function toggleRole(roleId, roleName) {
            roleId = parseInt(roleId);

            const card = $('.role-card[data-id="' + roleId + '"]');

            const index = selectedRoles.findIndex(function (role) {
                return parseInt(role.id) === roleId;
            });

            if (index > -1) {
                selectedRoles.splice(index, 1);
                card.removeClass('selected');
            } else {
                selectedRoles.push({
                    id: roleId,
                    name: roleName
                });
                card.addClass('selected');
            }

            $('#roleIdsInput').val(selectedRoles.map(function (role) {
                return role.id;
            }).join(','));

            $('#roleError').addClass('d-none');

            updateRoleUI();
            checkDepartmentRequirement();
        }

        function updateRoleUI() {
            $('#selectedRoleCount').text(selectedRoles.length + ' selected');

            if (selectedRoles.length > 0) {
                const badges = selectedRoles.map(function (role) {
                    return '<span class="badge bg-primary me-1 mb-1">' +
                        '<i class="bi bi-shield-check me-1"></i>' +
                        escapeHtml(role.name) +
                        '</span>';
                }).join('');

                $('#selectedRolesBadges').html(badges);
                $('#selectedRolesPreview').removeClass('d-none');
            } else {
                $('#selectedRolesBadges').html('');
                $('#selectedRolesPreview').addClass('d-none');
            }
        }

        function checkDepartmentRequirement() {
            const needsDept = selectedRoles.some(function (role) {
                return ROLES_REQUIRING_DEPT.includes(role.name);
            });

            const onlySystemRole = selectedRoles.length > 0 &&
                selectedRoles.every(function (role) {
                    return SYSTEM_ROLES.includes(role.name);
                });

            if (needsDept && !onlySystemRole) {
                $('#departmentId').prop('required', true);
                $('#deptStar').removeClass('d-none');
                $('#deptRequired').show();
            } else {
                $('#departmentId').prop('required', false);
                $('#deptStar').addClass('d-none');
                $('#deptRequired').hide();
                $('#deptError').addClass('d-none');
            }
        }

        function changeStep(direction) {
            const newStep = currentStep + direction;

            if (direction === 1 && !validateStep(currentStep)) {
                return;
            }

            if (newStep < 1 || newStep > totalSteps) {
                return;
            }

            $('.form-step').removeClass('active');
            $('#step' + newStep).addClass('active');

            $('.step').removeClass('active completed');

            for (let i = 1; i <= totalSteps; i++) {
                const stepElement = $('.step[data-step="' + i + '"]');

                if (i < newStep) {
                    stepElement.addClass('completed');
                } else if (i === newStep) {
                    stepElement.addClass('active');
                }
            }

            currentStep = newStep;
            updateButtons();

            if (newStep === 4) {
                populateSummary();
            }

            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        }

        function validateStep(step) {
            let valid = true;

            if (step === 1) {
                const fullName = $('#fullName').val().trim();
                const username = $('#username').val().trim();
                const email = $('#email').val().trim();

                if (!fullName) {
                    $('#fullName').addClass('is-invalid').removeClass('is-valid');
                    $('#fullNameError').removeClass('d-none');
                    valid = false;
                } else {
                    $('#fullName').removeClass('is-invalid').addClass('is-valid');
                    $('#fullNameError').addClass('d-none');
                }

                if (!username || username.length < 3) {
                    $('#username').addClass('is-invalid').removeClass('is-valid');
                    $('#usernameError').removeClass('d-none');
                    valid = false;
                } else {
                    $('#username').removeClass('is-invalid').addClass('is-valid');
                    $('#usernameError').addClass('d-none');
                }

                if (!email || !isValidEmail(email)) {
                    $('#email').addClass('is-invalid').removeClass('is-valid');
                    $('#emailError').removeClass('d-none');
                    valid = false;
                } else {
                    $('#email').removeClass('is-invalid').addClass('is-valid');
                    $('#emailError').addClass('d-none');
                }
            }

            if (step === 2) {
                const password = $('#password').val();
                const confirmPassword = $('#confirmPassword').val();

                if (!password || password.length < 6) {
                    $('#password').addClass('is-invalid').removeClass('is-valid');
                    $('#passwordError').removeClass('d-none');
                    valid = false;
                } else {
                    $('#password').removeClass('is-invalid').addClass('is-valid');
                    $('#passwordError').addClass('d-none');
                }

                if (!confirmPassword || password !== confirmPassword) {
                    $('#confirmPassword').addClass('is-invalid').removeClass('is-valid');
                    $('#pwdMismatch').removeClass('d-none');
                    valid = false;
                } else {
                    $('#confirmPassword').removeClass('is-invalid').addClass('is-valid');
                    $('#pwdMismatch').addClass('d-none');
                }
            }

            if (step === 3) {
                if (selectedRoles.length === 0) {
                    $('#roleError').removeClass('d-none');
                    valid = false;
                } else {
                    $('#roleError').addClass('d-none');
                }

                if ($('#departmentId').prop('required') && !$('#departmentId').val()) {
                    $('#departmentId').addClass('is-invalid');
                    $('#deptError').removeClass('d-none');
                    valid = false;
                } else {
                    $('#departmentId').removeClass('is-invalid');
                    $('#deptError').addClass('d-none');
                }
            }

            return valid;
        }

        function updateButtons() {
            $('#prevBtn').toggle(currentStep > 1);
            $('#nextBtn').toggle(currentStep < totalSteps);
            $('#submitBtn').toggle(currentStep === totalSteps);
        }

        function populateSummary() {
            $('#sumFullName').text($('#fullName').val().trim() || '-');
            $('#sumUsername').text($('#username').val().trim() || '-');
            $('#sumEmail').text($('#email').val().trim() || '-');
            $('#sumPhone').text($('#phoneNumber').val().trim() || '-');

            const roleBadges = selectedRoles.map(function (role) {
                return '<span class="badge bg-primary me-1 mb-1">' + escapeHtml(role.name) + '</span>';
            }).join('');

            $('#sumRoles').html(roleBadges || '-');

            const department = $('#departmentId option:selected').text();
            $('#sumDepartment').text(department !== '-- Select Department --' ? department : '-');

            const designation = $('#designationId option:selected').text();
            $('#sumDesignation').text(designation !== '-- Select Designation --' ? designation : '-');

            const prefix = $('#codePrefix').text();
            const code = $('#employeeCode').val().trim();
            $('#sumEmpCode').text(code ? prefix + code : '-');
        }

        function checkPasswordStrength() {
            const password = $('#password').val();
            let score = 0;

            const hasLength = password.length >= 6;
            const hasUppercase = /[A-Z]/.test(password);
            const hasNumber = /[0-9]/.test(password);
            const hasSpecial = hasSpecialChar(password);

            if (hasLength) score++;
            if (hasUppercase) score++;
            if (hasNumber) score++;
            if (hasSpecial) score++;

            $('#rule-length').css('color', hasLength ? '#10b981' : '#94a3b8');
            $('#rule-uppercase').css('color', hasUppercase ? '#10b981' : '#94a3b8');
            $('#rule-number').css('color', hasNumber ? '#10b981' : '#94a3b8');
            $('#rule-special').css('color', hasSpecial ? '#10b981' : '#94a3b8');

            const bar = $('#strengthBar');
            const text = $('#strengthText');

            bar.removeClass('strength-weak strength-medium strength-strong');

            if (!password) {
                text.text('Minimum 6 characters').css('color', '#64748b');
                bar.css('width', '0%');
                return;
            }

            bar.css('width', '');

            if (score <= 1) {
                bar.addClass('strength-weak');
                text.text('Weak').css('color', '#ef4444');
            } else if (score === 2) {
                bar.addClass('strength-weak');
                text.text('Fair').css('color', '#f59e0b');
            } else if (score === 3) {
                bar.addClass('strength-medium');
                text.text('Good').css('color', '#3b82f6');
            } else {
                bar.addClass('strength-strong');
                text.text('Strong').css('color', '#10b981');
            }
        }

        function checkPasswordMatch() {
            const password = $('#password').val();
            const confirmPassword = $('#confirmPassword').val();

            if (confirmPassword && password !== confirmPassword) {
                $('#pwdMismatch').removeClass('d-none');
                $('#confirmPassword').addClass('is-invalid');
            } else {
                $('#pwdMismatch').addClass('d-none');
                $('#confirmPassword').removeClass('is-invalid');
            }
        }

        function togglePassword(id, button) {
            const input = $('#' + id);
            const type = input.attr('type') === 'password' ? 'text' : 'password';

            input.attr('type', type);
            $(button).find('i').toggleClass('bi-eye bi-eye-slash');
        }

        function updateEmployeeCodePrefix(deptName) {
            let prefix = 'EMP-';

            if (deptName && deptName !== '-- Select Department --') {
                const deptCode = deptName.substring(0, 3).toUpperCase().replace(/[^A-Z]/g, '');
                prefix = 'EMP-' + deptCode + '-';
            }

            $('#codePrefix').text(prefix);
        }

        function showQuickToast(message) {
            const toast = $(
                '<div class="toast align-items-center text-white bg-success border-0 position-fixed top-0 end-0 m-3 show" style="z-index:9999;">' +
                    '<div class="d-flex">' +
                        '<div class="toast-body">' +
                            '<i class="bi bi-check-circle me-2"></i>' + escapeHtml(message) +
                        '</div>' +
                    '</div>' +
                '</div>'
            );

            $('body').append(toast);

            setTimeout(function () {
                toast.fadeOut(function () {
                    toast.remove();
                });
            }, 3000);
        }

        $(document).ready(function () {
            loadDropdownData();
            updateButtons();

            $('#nextBtn').on('click', function (event) {
                event.preventDefault();
                changeStep(1);
            });

            $('#prevBtn').on('click', function (event) {
                event.preventDefault();
                changeStep(-1);
            });

            $('#togglePwd1').on('click', function () {
                togglePassword('password', this);
            });

            $('#togglePwd2').on('click', function () {
                togglePassword('confirmPassword', this);
            });

            $('#password').on('input', function () {
                checkPasswordStrength();
                checkPasswordMatch();
            });

            $('#confirmPassword').on('input', checkPasswordMatch);

            $('#confirmCheck').on('change', function () {
                $('#submitBtn').prop('disabled', !this.checked);
            });

            $(document).on('click', '#roleGrid .role-card', function () {
                const roleId = $(this).attr('data-id');
                const roleName = $(this).attr('data-name');

                toggleRole(roleId, roleName);
            });

            $('#roleSearch').on('input', function () {
                const query = $(this).val().toLowerCase().trim();

                $('.role-card').each(function () {
                    const name = ($(this).attr('data-name') || '').toLowerCase();
                    const desc = $(this).find('.role-desc').text().toLowerCase();

                    if (name.includes(query) || desc.includes(query)) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            });

            $('#departmentId').on('change', function () {
                const deptId = $(this).val();
                const deptName = $('#departmentId option:selected').text();

                bindDesignationsByDepartment(deptId);
                updateEmployeeCodePrefix(deptName);

                $('#departmentId').removeClass('is-invalid');
                $('#deptError').addClass('d-none');
            });

            $('#generateCodeBtn').on('click', function () {
                const randomNum = String(Math.floor(Math.random() * 900) + 100);
                $('#employeeCode').val(randomNum);
                showQuickToast('Employee code generated');
            });

            $('#employeeCode').on('input', function () {
                let value = $(this).val().toUpperCase();
                value = value.replace(/[^A-Z0-9]/g, '');

                if (value.length > 10) {
                    value = value.substring(0, 10);
                }

                $(this).val(value);
            });

            $('#fullName, #username, #email').on('input', function () {
                $(this).removeClass('is-invalid');
                $('#' + this.id + 'Error').addClass('d-none');
            });

            $('#createUserForm').on('submit', function (event) {
                if (!validateStep(1) || !validateStep(2) || !validateStep(3)) {
                    event.preventDefault();
                    alert('Please complete all required fields in previous steps.');
                    return;
                }

                if (!$('#confirmCheck').is(':checked')) {
                    event.preventDefault();
                    alert('Please confirm the details before creating user.');
                    return;
                }

                $('#submitBtn')
                    .prop('disabled', true)
                    .html('<i class="bi bi-hourglass-split me-1"></i>Creating...');
            });
        });
    </script>
}