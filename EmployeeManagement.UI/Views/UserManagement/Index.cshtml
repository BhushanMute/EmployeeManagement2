@using EmployeeManagement.UI.Services
@inject IImageService ImageService

@{
    ViewData["Title"] = "User Management";
    var usersJson = ViewBag.UsersJson as string ?? "{}";
    var rolesJson = ViewBag.RolesJson as string ?? "{}";
    var showNewUser = ViewBag.ShowNewUser as bool? ?? false;
}

@section Styles {
    <style>
        body {
            background: #f0f2f5;
        }

        .hero-bar {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            padding: 1.75rem 2rem;
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
            margin-bottom: 1.5rem;
        }

        .data-card {
            background: white;
            border-radius: 14px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

        .filter-card {
            background: white;
            border-radius: 12px;
            padding: 1.25rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            margin-bottom: 1rem;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
        }

        .role-tag {
            display: inline-block;
            padding: 0.2rem 0.6rem;
            background: #e0e7ff;
            color: #4338ca;
            border-radius: 12px;
            font-size: 0.7rem;
            font-weight: 600;
            margin: 2px;
        }

        .status-active {
            background: #d1fae5;
            color: #065f46;
            padding: 0.25rem 0.65rem;
            border-radius: 12px;
            font-size: 0.7rem;
            font-weight: 700;
        }

        .status-inactive {
            background: #fee2e2;
            color: #991b1b;
            padding: 0.25rem 0.65rem;
            border-radius: 12px;
            font-size: 0.7rem;
            font-weight: 700;
        }

        /* New styles for detailed success notification */
        .user-created-notification {
            background: linear-gradient(135deg, #10b981, #34d399);
            color: white;
            border-radius: 12px;
            padding: 1.25rem;
            margin-bottom: 1.5rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 6px 20px rgba(16, 185, 129, 0.3);
        }

            .user-created-notification::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 4px;
                height: 100%;
                background: white;
            }

        .user-created-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .user-created-icon {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .user-created-content h4 {
            margin: 0 0 0.25rem 0;
            font-weight: 700;
        }

        .user-created-content p {
            margin: 0;
            opacity: 0.9;
        }

        .user-details-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-top: 1rem;
        }

        .detail-item {
            background: rgba(255, 255, 255, 0.15);
            padding: 0.75rem;
            border-radius: 8px;
        }

        .detail-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            opacity: 0.8;
            margin-bottom: 0.25rem;
        }

        .detail-value {
            font-weight: 600;
            word-break: break-word;
        }

        .notification-actions {
            display: flex;
            justify-content: flex-end;
            gap: 0.5rem;
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 1px solid rgba(255, 255, 255, 0.2);
        }

        .btn-dismiss-user {
            background: rgba(255, 255, 255, 0.2);
            border: none;
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 6px;
            transition: all 0.2s;
        }

            .btn-dismiss-user:hover {
                background: rgba(255, 255, 255, 0.3);
            }

        .btn-view-user {
            background: white;
            color: #10b981;
            padding: 0.5rem 1rem;
            border-radius: 6px;
            font-weight: 600;
            transition: all 0.2s;
        }

            .btn-view-user:hover {
                background: #f0fdf4;
                transform: translateY(-2px);
            }

        /* Profile image styles */
        .profile-image-cell {
            width: 60px;
        }

        .profile-img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #e2e8f0;
        }

        .profile-img-container {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Empty state styling */
        .empty-state {
            text-align: center;
            padding: 2rem;
            color: #64748b;
        }

            .empty-state i {
                font-size: 4rem;
                color: #cbd5e1;
                margin-bottom: 1rem;
            }

            .empty-state h3 {
                font-size: 1.5rem;
                margin-bottom: 0.5rem;
                color: #1e293b;
            }

            .empty-state p {
                max-width: 500px;
                margin: 0 auto;
            }
    </style>
}

<div class="container-fluid py-3 pb-5">
    <div class="hero-bar">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h3 class="fw-bold mb-1"><i class="bi bi-people-fill me-2"></i>User Management</h3>
                <p class="mb-0 opacity-90">Manage users, roles & permissions</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Create" class="btn btn-light fw-bold">
                    <i class="bi bi-person-plus me-1"></i>Create User
                </a>
                <a asp-action="Roles" class="btn btn-outline-light">
                    <i class="bi bi-shield-check me-1"></i>Manage Roles
                </a>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null && showNewUser)
    {
        var successMessage = TempData["Success"]?.ToString() ?? "";
        var isNewUserCreation = successMessage.Contains("created successfully", StringComparison.OrdinalIgnoreCase);

        if (isNewUserCreation)
        {
            <div class="user-created-notification" id="userCreatedNotification">
                <div class="user-created-header">
                    <div class="user-created-icon">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div class="user-created-content">
                        <h4>New User Created Successfully!</h4>
                        <p>Your new user has been added to the system</p>
                    </div>
                </div>

                <div class="user-details-grid">
                    <div class="detail-item">
                        <div class="detail-label">Full Name</div>
                        <div class="detail-value" id="newUserFullName">Loading...</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Username</div>
                        <div class="detail-value" id="newUserUsername">Loading...</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Email</div>
                        <div class="detail-value" id="newUserEmail">Loading...</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Status</div>
                        <div class="detail-value" id="newUserStatus">Active</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Created Date</div>
                        <div class="detail-value" id="newUserCreatedDate">Just now</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Roles</div>
                        <div class="detail-value" id="newUserRoles">Loading...</div>
                    </div>
                </div>

                <div class="notification-actions">
                    <button class="btn-dismiss-user" onclick="dismissUserNotification()">
                        <i class="bi bi-x me-1"></i>Dismiss
                    </button>
                    <a href="#" class="btn-view-user" id="viewUserLink">
                        <i class="bi bi-eye me-1"></i>View User
                    </a>
                </div>
            </div>
        }
    }
    else if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="filter-card">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control" placeholder="🔍 Search by name, email..." />
            </div>
            <div class="col-md-3">
                <select name="role" class="form-select" id="roleFilter">
                    <option value="">All Roles</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All Status</option>
                    <option value="Active" selected="@(ViewBag.SelectedStatus == "Active")">Active</option>
                    <option value="Inactive" selected="@(ViewBag.SelectedStatus == "Inactive")">Inactive</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-search"></i></button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-clockwise"></i></a>
            </div>
        </form>
    </div>

    <div class="data-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background: #f8fafc;">
                    <tr>
                        <th>Profile</th>
                        <th>User</th>
                        <th>Email</th>
                        <th>Roles</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Last Login</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody id="userTableBody">
                    <!-- Content will be populated by JavaScript -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Reset Password Modal -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title">🔑 Reset Password</h5>
                <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="resetUserId" />
                <p>Enter new password for user: <strong id="resetUserName"></strong></p>
                <input type="password" id="newPassword" class="form-control" placeholder="New password (min 6 chars)" minlength="6" />
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-warning" onclick="confirmResetPassword()">Reset</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const usersData = @Html.Raw(usersJson);
        const rolesData = @Html.Raw(rolesJson);

        $(document).ready(function() {
            // Populate role filter
            if (rolesData?.data) {
                const sel = $('#roleFilter');
                rolesData.data.forEach(r => {
                    sel.append(`<option value="${r.roleName}">${r.roleName}</option>`);
                });
            }

            // Render users
            if (usersData?.data?.users) {
                renderUsers(usersData.data.users);
            } else {
                // Check if the JSON is empty or malformed
                if (usersJson === "{}" || !usersData || !usersData.data) {
                    showEmptyState("No users found. Make sure the API is returning user data.");
                } else {
                    showEmptyState("No users returned from API. Check API response format.");
                }
            }

            // If showing new user notification, fetch user details
            @if (ViewBag.ShowNewUser as bool? ?? false)
            {
                    <text>
                    setTimeout(fetchNewUserDetails, 100);
                    </text>
            }
        });

        function showEmptyState(message) {
            $('#userTableBody').html(`
                <tr>
                    <td colspan="8" class="py-5">
                        <div class="empty-state">
                            <i class="bi bi-person-lines"></i>
                            <h3>No Users Found</h3>
                            <p>${message}</p>
                            <div class="mt-3">
                                <a asp-action="Create" class="btn btn-primary">
                                    <i class="bi bi-person-plus me-1"></i>Create First User
                                </a>
                            </div>
                        </div>
                    </td>
                </tr>
            `);
        }

        function renderUsers(users) {
            const tbody = $('#userTableBody');
            tbody.empty();

            if (!users || users.length === 0) {
                showEmptyState("No users available in the system.");
                return;
            }

            users.forEach(u => {
                const initials = (u.fullName || 'U').split(' ').map(n => n.charAt(0)).join('').substring(0,2).toUpperCase();
                const statusClass = u.isActive ? 'status-active' : 'status-inactive';
                const statusText = u.isActive ? 'Active' : 'Inactive';
                const roles = u.roles ? u.roles.split(',').map(r => `<span class="role-tag">${r.trim()}</span>`).join(' ') : '<span class="text-muted small">No roles</span>';

                // Get profile image URL using the service
                const profileImageUrl = u.profilePicture || u.ProfilePicture || u.profilePicture || u.ProfilePicture || '';
                const imageUrl = getImageUrl(profileImageUrl);

                tbody.append(`
                    <tr>
                        <td class="profile-image-cell">
                            <div class="profile-img-container">
                                <img src="${imageUrl}"
                                     alt="Profile"
                                     class="profile-img"
                                     onerror="this.src='/images/default-profile.png'; this.onerror=null;" />
                            </div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="user-avatar">${initials}</div>
                                <div>
                                    <strong>${u.fullName}</strong>
                                    <div class="small text-muted">${u.username}</div>
                                </div>
                            </div>
                        </td>
                        <td>${u.email}</td>
                        <td>${roles}</td>
                        <td><span class="${statusClass}">${statusText}</span></td>
                        <td><small>${formatDate(u.createdDate)}</small></td>
                        <td><small>${u.lastLoginDate ? formatDate(u.lastLoginDate) : 'Never'}</small></td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm">
                                <a href="/UserManagement/Edit/${u.userId}" class="btn btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button class="btn btn-outline-warning" onclick="resetPassword(${u.userId}, '${u.fullName}')" title="Reset Password">
                                    <i class="bi bi-key"></i>
                                </button>
                                <button class="btn btn-outline-${u.isActive ? 'secondary' : 'success'}" onclick="toggleStatus(${u.userId}, ${!u.isActive})" title="${u.isActive ? 'Deactivate' : 'Activate'}">
                                    <i class="bi bi-${u.isActive ? 'pause-circle' : 'play-circle'}"></i>
                                </button>
                                <button class="btn btn-outline-danger" onclick="deleteUser(${u.userId}, '${u.fullName}')" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `);
            });
        }

        function getImageUrl(profilePath) {
            // This function simulates the server-side ImageService logic
            if (!profilePath) {
                return '/images/default-profile.png';
            }

            // If it's already a relative path, return as-is
            if (profilePath.startsWith('/')) {
                return profilePath;
            }

            // If it's an absolute URL from the API, convert it to relative
            if (profilePath.startsWith('http')) {
                try {
                    var uri = new URL(profilePath);
                    // If it's from the API server, convert to relative path
                    if (uri.hostname.includes('localhost') && uri.port === '26024') {
                        // Extract the path component
                        var relativePath = uri.pathname;
                        return relativePath;
                    } else {
                        // External URL - return as is
                        return profilePath;
                    }
                } catch (e) {
                    console.error('Invalid URI format:', profilePath);
                    return '/images/default-profile.png';
                }
            }

            // If it's a simple filename, assume it's in uploads
            if (!profilePath.includes('/') && !profilePath.includes('\\')) {
                return '/uploads/profiles/' + profilePath;
            }

            return profilePath;
        }

        function resetPassword(id, name) {
            $('#resetUserId').val(id);
            $('#resetUserName').text(name);
            $('#newPassword').val('');
            new bootstrap.Modal('#resetPasswordModal').show();
        }

        async function confirmResetPassword() {
            const id = $('#resetUserId').val();
            const pwd = $('#newPassword').val();
            if (pwd.length < 6) { alert('Min 6 characters'); return; }

            const fd = new FormData();
            fd.append('id', id);
            fd.append('newPassword', pwd);

            const res = await fetch('/UserManagement/ResetPassword', { method: 'POST', body: fd });
            const result = await res.json();
            alert(result.success ? '✅ Password reset!' : '❌ Failed');
            if (result.success) bootstrap.Modal.getInstance('#resetPasswordModal').hide();
        }

        async function toggleStatus(id, newStatus) {
            if (!confirm(`${newStatus ? 'Activate' : 'Deactivate'} this user?`)) return;

            const fd = new FormData();
            fd.append('id', id);
            fd.append('isActive', newStatus);

            const res = await fetch('/UserManagement/ToggleStatus', { method: 'POST', body: fd });
            const result = await res.json();
            if (result.success) location.reload();
            else alert('Failed');
        }

        async function deleteUser(id, name) {
            if (!confirm(`Delete user "${name}"? This cannot be undone.`)) return;

            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/UserManagement/Delete/' + id;
            document.body.appendChild(form);
            form.submit();
        }

        function formatDate(d) {
            if (!d) return '';
            return new Date(d).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
        }

        // Function to fetch details of the newly created user
        async function fetchNewUserDetails() {
            try {
                // Get the last created user from the user list (most recent first)
                if (usersData?.data?.users && usersData.data.users.length > 0) {
                    // Assuming the most recent user is the first one in the list
                    const latestUser = usersData.data.users[0];

                    // Update the notification with user details
                    document.getElementById('newUserFullName').textContent = latestUser.fullName;
                    document.getElementById('newUserUsername').textContent = latestUser.username;
                    document.getElementById('newUserEmail').textContent = latestUser.email;
                    document.getElementById('newUserStatus').textContent = latestUser.isActive ? 'Active' : 'Inactive';
                    document.getElementById('newUserCreatedDate').textContent = formatDate(latestUser.createdDate);
                    document.getElementById('newUserRoles').textContent = latestUser.roles || 'No roles assigned';
                    document.getElementById('viewUserLink').href = `/UserManagement/Edit/${latestUser.userId}`;
                }
            } catch (error) {
                console.error('Error fetching new user details:', error);
            }
        }

        // Function to dismiss the user notification
        function dismissUserNotification() {
            const notification = document.getElementById('userCreatedNotification');
            if (notification) {
                notification.style.transition = 'all 0.3s ease';
                notification.style.opacity = '0';
                notification.style.transform = 'translateY(-20px)';

                setTimeout(() => {
                    notification.style.display = 'none';
                }, 300);
            }
        }
    </script>
}