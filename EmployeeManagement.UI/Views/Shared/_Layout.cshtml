@{
    var username = Context.Session.GetString("Username");
    var UserId = Context.Session.GetString("UserId");
    var email = Context.Session.GetString("Email");
    var fullName = Context.Session.GetString("FullName");
    var profilePic = Context.Session.GetString("ProfilePicture");
    var rolesString = Context.Session.GetString("Roles") ?? "";
    var permissionsString = Context.Session.GetString("Permissions") ?? "";

    // ✅ FIX: Case-insensitive role checking
    var roles = rolesString.Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(r => r.Trim())
        .ToArray();

    var permissions = permissionsString.Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(p => p.Trim())
        .ToArray();

    // ✅ FIX: Case-insensitive comparison
    var isAdmin = roles.Any(r => r.Equals("Admin", StringComparison.OrdinalIgnoreCase));
    var isHR = roles.Any(r => r.Equals("HR", StringComparison.OrdinalIgnoreCase)) || isAdmin;
    var isManager = roles.Any(r => r.Equals("Manager", StringComparison.OrdinalIgnoreCase)) || isHR;
    var isEmployee = roles.Any(r => r.Equals("Employee", StringComparison.OrdinalIgnoreCase));

    // Get initials for fallback
    var initials = "";
    if (!string.IsNullOrEmpty(fullName))
    {
        var names = fullName.Split(' ');
        initials = names.Length >= 2
            ? $"{names[0].FirstOrDefault()}{names[1].FirstOrDefault()}".ToUpper()
            : $"{names[0].FirstOrDefault()}".ToUpper();
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Employee Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">

    <!-- ✅ Load CSS with media print trick (non-blocking) for non-critical CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
          rel="stylesheet" media="print" onload="this.media='all'">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="fas fa-users-cog me-2"></i>Employee Management
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                @if (!string.IsNullOrEmpty(username))
                {
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home me-1"></i>Dashboard
                            </a>
                        </li>

                        @if (permissions.Contains("Employee.View") || roles.Any())
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Employee" asp-action="Index">
                                    <i class="fas fa-users me-1"></i>Employees
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Student" asp-action="Index">
                                    <i class="fas fa-user-graduate me-1"></i>Students
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Student/UploadExcel">
                                    <i class="fas fa-file-excel me-1"></i>Upload Excel
                                </a>
                            </li>
                        }

                        @if (isHR)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-file-alt me-1"></i>Reports
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Report" asp-action="EmployeeReport">
                                            <i class="fas fa-users me-2 text-primary"></i>Employee Report
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Report" asp-action="AttendanceReport">
                                            <i class="fas fa-clipboard-check me-2 text-success"></i>Attendance Report
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Report" asp-action="SalaryReport">
                                            <i class="fas fa-money-bill-wave me-2 text-warning"></i>Salary Report
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Leave" asp-action="Reports">
                                            <i class="fas fa-calendar-check me-2 text-info"></i>Leave Report
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        @if (isAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-cog me-1"></i>Administration
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="UserManagement" asp-action="Index">
                                            <i class="fas fa-user-check me-2 text-warning"></i>User Approvals & Roles
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="User" asp-action="Index">
                                            <i class="fas fa-users-cog me-2"></i>User Management
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Role" asp-action="Index">
                                            <i class="fas fa-user-tag me-2"></i>Role Management
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" href="#">
                                            <i class="fas fa-history me-2"></i>Audit Logs
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(username))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-calendar-alt me-1"></i>Leave
                                </a>
                                <ul class="dropdown-menu">
                                    @* ===== ALL USERS ===== *@
                                    <li>
                                        <a class="dropdown-item" asp-controller="Leave" asp-action="Index">
                                            <i class="fas fa-tachometer-alt me-2"></i>Leave Dashboard
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Leave" asp-action="Apply">
                                            <i class="fas fa-calendar-plus me-2"></i>Apply Leave
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Leave" asp-action="History">
                                            <i class="fas fa-history me-2"></i>Leave History
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Leave" asp-action="Balance">
                                            <i class="fas fa-chart-pie me-2"></i>Leave Balance
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Leave" asp-action="Holidays">
                                            <i class="fas fa-calendar me-2"></i>Holiday Calendar
                                        </a>
                                    </li>

                                    @* ===== MANAGER / HR / ADMIN ONLY ===== *@
                                    @if (isManager)
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li class="dropdown-header">
                                            <small class="text-muted text-uppercase">Management</small>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Leave" asp-action="AdminDashboard">
                                                <i class="fas fa-chart-line me-2 text-primary"></i>Leave Analytics
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Leave" asp-action="PendingApprovals">
                                                <i class="fas fa-clipboard-check me-2 text-warning"></i>Pending Approvals
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Leave" asp-action="Calendar">
                                                <i class="fas fa-calendar-alt me-2 text-info"></i>Team Calendar
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Leave" asp-action="Reports">
                                                <i class="fas fa-chart-bar me-2 text-success"></i>Leave Reports
                                            </a>
                                        </li>
                                    }
                                    @if (isAdmin || isHR)
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li class="dropdown-header">
                                            <small class="text-muted text-uppercase">Administration</small>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Leave" asp-action="ManageAllocation">
                                                <i class="fas fa-tasks me-2 text-success"></i>Manage Allocation
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                                <img src="@(string.IsNullOrEmpty(profilePic) ? "" : profilePic)"
                                     class="rounded-circle me-2 border border-2 border-white @(string.IsNullOrEmpty(profilePic) ? "d-none" : "")"
                                     style="width: 32px; height: 32px; object-fit: cover;"
                                     alt="Profile"
                                     id="navbarProfileImg"
                                     onerror="this.classList.add('d-none'); document.getElementById('navbarProfileInitials').classList.remove('d-none'); document.getElementById('navbarProfileInitials').classList.add('d-flex');">

                                <span class="rounded-circle bg-light text-primary align-items-center justify-content-center me-2 @(string.IsNullOrEmpty(profilePic) ? "d-flex" : "d-none")"
                                      id="navbarProfileInitials"
                                      style="width: 32px; height: 32px; font-size: 12px; font-weight: bold;">
                                    @initials
                                </span>

                                <span class="d-none d-md-inline">@(!string.IsNullOrEmpty(fullName) ? fullName : email)</span>
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li class="dropdown-header">
                                    <div class="d-flex align-items-center py-2">
                                        <img src="@(string.IsNullOrEmpty(profilePic) ? "" : profilePic)"
                                             class="rounded-circle me-3 @(string.IsNullOrEmpty(profilePic) ? "d-none" : "")"
                                             style="width: 50px; height: 50px; object-fit: cover;"
                                             alt="Profile"
                                             id="dropdownProfileImg"
                                             onerror="this.classList.add('d-none'); document.getElementById('dropdownProfileInitials').classList.remove('d-none'); document.getElementById('dropdownProfileInitials').classList.add('d-flex');">

                                        <div class="rounded-circle bg-primary text-white align-items-center justify-content-center me-3 @(string.IsNullOrEmpty(profilePic) ? "d-flex" : "d-none")"
                                             id="dropdownProfileInitials"
                                             style="width: 50px; height: 50px; font-size: 18px; font-weight: bold;">
                                            @initials
                                        </div>

                                        <div>
                                            <strong class="d-block">@fullName</strong>
                                            <small class="text-muted">
                                                <i class="fas fa-envelope me-1"></i>@email
                                            </small>
                                            @if (roles.Any())
                                            {
                                                <div class="mt-1">
                                                    <span class="badge bg-primary">@roles.FirstOrDefault()</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                        <i class="fas fa-user me-2 text-primary"></i>My Profile
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="EditProfile" asp-route-id="@UserId">
                                        <i class="fas fa-user-edit me-2 text-info"></i>Edit Profile
                                    </a>

                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                        <i class="fas fa-key me-2 text-warning"></i>Change Password
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="fas fa-sign-out-alt me-2"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </ul>
                }
                else
                {
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                <i class="fas fa-sign-in-alt me-1"></i>Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Register">
                                <i class="fas fa-user-plus me-1"></i>Register
                            </a>
                        </li>
                    </ul>
                }
            </div>
        </div>
    </nav>

    <main class="container mt-4">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="footer mt-5 py-3 bg-light">
        <div class="container text-center">
            <span class="text-muted">&copy; @DateTime.Now.Year Employee Management System</span>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

    <script>
        // ✅ Global function to update navbar profile picture (can be called from any page)
        function updateNavbarProfilePicture(imageUrl) {
            if (!imageUrl) return;

            var timestamp = new Date().getTime();
            var newUrl = imageUrl.includes('?') ? imageUrl + '&t=' + timestamp : imageUrl + '?t=' + timestamp;

            // ✅ Update navbar small image
            var navbarImg = document.getElementById('navbarProfileImg');
            if (navbarImg) {
                navbarImg.src = newUrl;
                navbarImg.classList.remove('d-none');
                navbarImg.style.display = 'block';
            }

            // ✅ Hide navbar initials
            var navbarInitials = document.getElementById('navbarProfileInitials');
            if (navbarInitials) {
                navbarInitials.classList.add('d-none');
                navbarInitials.classList.remove('d-flex');
            }

            // ✅ Update dropdown header image
            var dropdownImg = document.getElementById('dropdownProfileImg');
            if (dropdownImg) {
                dropdownImg.src = newUrl;
                dropdownImg.classList.remove('d-none');
                dropdownImg.style.display = 'block';
            }

            // ✅ Hide dropdown initials
            var dropdownInitials = document.getElementById('dropdownProfileInitials');
            if (dropdownInitials) {
                dropdownInitials.classList.add('d-none');
                dropdownInitials.classList.remove('d-flex');
            }

            console.log('Navbar profile picture updated:', newUrl);
        }

        // ✅ Auto-dismiss alerts after 5 seconds
        setTimeout(function() {
            var alerts = document.querySelectorAll('.alert');
            alerts.forEach(function(alert) {
                var bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>