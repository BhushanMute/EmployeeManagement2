@{
    ViewData["Title"] = "Edit Ticket";
    var userRole = ViewBag.UserRole as string ?? "Employee";
    var ticketData = ViewBag.TicketJson as string ?? "{}";
    var dropdownData = ViewBag.DropdownsJson as string ?? "{}";
}

@section Styles {
    <style>
        body {
            background: #f4f6f9;
        }

        .edit-hero {
            background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
            color: white;
            padding: 2rem;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(250, 112, 154, 0.3);
            margin-bottom: 1.5rem;
        }

        .form-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            border: none;
            overflow: hidden;
        }

        .form-section {
            padding: 1.5rem;
            border-bottom: 1px solid #f1f5f9;
        }

            .form-section:last-child {
                border-bottom: none;
            }

        .form-section-title {
            font-weight: 700;
            color: #475569;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .form-control, .form-select {
            border-radius: 10px;
            border: 1.5px solid #e2e8f0;
            padding: 0.65rem 1rem;
        }

            .form-control:focus, .form-select:focus {
                border-color: #fa709a;
                box-shadow: 0 0 0 3px rgba(250, 112, 154, 0.15);
            }

        .priority-selector, .type-selector {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 0.5rem;
        }

        .selector-option {
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            padding: 0.75rem;
            text-align: center;
            cursor: pointer;
            background: white;
            transition: all 0.2s;
        }

            .selector-option:hover {
                transform: translateY(-2px);
            }

            .selector-option.selected {
                border-color: #fa709a;
                background: linear-gradient(135deg, #fef2f2, #fce7f3);
            }

            .selector-option i {
                font-size: 1.35rem;
                margin-bottom: 0.35rem;
            }

        .btn-update {
            background: linear-gradient(135deg, #fa709a, #fee140);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 0.75rem 2rem;
            font-weight: 700;
            transition: all 0.2s;
        }

            .btn-update:hover {
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 6px 15px rgba(250, 112, 154, 0.4);
            }

        .changes-indicator {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: #fbbf24;
            color: #78350f;
            padding: 0.75rem 1.25rem;
            border-radius: 12px;
            font-weight: 700;
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
            display: none;
            z-index: 1000;
        }

            .changes-indicator.show {
                display: block;
                animation: bounceIn 0.4s;
            }

        .empty-master-box {
            border: 2px dashed #cbd5e1;
            border-radius: 12px;
            padding: 1rem;
            color: #64748b;
            background: #f8fafc;
            text-align: center;
        }

        @@keyframes bounceIn {
            0% {
                transform: scale(0.5);
                opacity: 0;
            }

            50% {
                transform: scale(1.1);
            }

            100% {
                transform: scale(1);
                opacity: 1;
            }
        }
    </style>
}

<div class="container py-3 pb-5">

    <div class="edit-hero">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h2 class="fw-bold mb-1">
                    <i class="bi bi-pencil-square me-2"></i>Edit Ticket
                </h2>
                <p class="mb-0 opacity-90" id="editTicketNumber">Loading...</p>
            </div>
            <a href="javascript:history.back()" class="btn btn-light fw-semibold">
                <i class="bi bi-arrow-left me-1"></i>Cancel
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Edit" method="post" id="editForm">
        @Html.AntiForgeryToken()

        <input type="hidden" name="ticketId" id="ticketIdInput" />

        <input type="hidden" name="ticketTypeId" id="ticketTypeIdInput" />
        <input type="hidden" name="priorityId" id="priorityIdInput" />
        <input type="hidden" name="categoryId" id="categoryIdInput" />
        <input type="hidden" name="moduleId" id="moduleIdInput" />
        <input type="hidden" name="severityId" id="severityIdInput" />

        <div class="form-card">

            <div class="form-section">
                <div class="form-section-title">
                    <i class="bi bi-info-circle text-primary"></i>Basic Information
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Title</label>
                    <input type="text" name="title" id="titleInput" class="form-control"
                           required maxlength="500" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Description</label>
                    <textarea name="description" id="descInput" class="form-control"
                              rows="4" required></textarea>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">
                    <i class="bi bi-tags text-info"></i>Type & Priority
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Ticket Type</label>
                        <input type="hidden" name="ticketType" id="ticketTypeInput" />
                        <div class="type-selector" id="typeSelector"></div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Priority</label>
                        <input type="hidden" name="priority" id="priorityInput" />
                        <div class="priority-selector" id="prioritySelector"></div>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">
                    <i class="bi bi-calendar text-secondary"></i>Schedule & Categorization
                </div>

                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Due Date</label>
                        <input type="date" name="dueDate" id="dueDateInput" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Module</label>
                        <select name="module" id="moduleInput" class="form-select">
                            <option value="">Select Module</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Category</label>
                        <select name="category" id="categoryInput" class="form-select">
                            <option value="">Select Category</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Severity</label>
                        <select name="severity" id="severityInput" class="form-select">
                            <option value="">Select Severity</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-section" id="bugFieldsSection" style="display:none;">
                <div class="form-section-title">
                    <i class="bi bi-bug text-danger"></i>Bug Details
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Steps to Reproduce</label>
                    <textarea name="stepsToReproduce" id="stepsInput" class="form-control" rows="3"></textarea>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Expected Result</label>
                        <textarea name="expectedResult" id="expectedInput" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Actual Result</label>
                        <textarea name="actualResult" id="actualInput" class="form-control" rows="2"></textarea>
                    </div>
                </div>

                <div class="mt-3">
                    <label class="form-label fw-semibold">Environment</label>
                    <input type="text" name="environment" id="envInput" class="form-control" />
                </div>
            </div>

            <div class="form-section">
                <div class="d-flex justify-content-end gap-2 flex-wrap">
                    <a href="javascript:history.back()" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-x-circle me-1"></i>Cancel
                    </a>

                    <button type="submit" class="btn btn-update" id="updateBtn">
                        <i class="bi bi-check-circle me-1"></i>Update Ticket
                    </button>
                </div>
            </div>

        </div>
    </form>
</div>

<div class="changes-indicator" id="changesIndicator">
    <i class="bi bi-exclamation-circle me-1"></i>You have unsaved changes
</div>

@section Scripts {
    <script>
        const ticketData = @Html.Raw(ticketData);
        const dropdownData = @Html.Raw(dropdownData);
        const dd = dropdownData?.data || {};
        let hasChanges = false;
        let isInitialLoad = true;

        $(document).ready(function () {
            bindTicketTypes();
            bindPriorities();
            bindCategories();
            bindModules();
            bindSeverities();

            if (ticketData?.data) {
                populateForm(ticketData.data);
            } else {
                $('#editTicketNumber').text('Ticket not found');
            }

            trackChanges();

            $('#moduleInput').on('change', function () {
                $('#moduleIdInput').val($(this).find(':selected').data('id') || '');
            });

            $('#categoryInput').on('change', function () {
                $('#categoryIdInput').val($(this).find(':selected').data('id') || '');
            });

            $('#severityInput').on('change', function () {
                $('#severityIdInput').val($(this).find(':selected').data('id') || '');
            });

            isInitialLoad = false;
        });

        function bindTicketTypes() {
            const items = dd.ticketTypeItems || [];
            const $box = $('#typeSelector');
            $box.empty();

            if (!items.length && dd.ticketTypes && dd.ticketTypes.length) {
                dd.ticketTypes.forEach((name, index) => {
                    $box.append(buildTypeCard(index + 1, name, name, null));
                });
            } else if (items.length) {
                items.forEach(x => {
                    $box.append(buildTypeCard(x.id, x.name, x.code, x.colorCode));
                });
            } else {
                $box.html('<div class="empty-master-box">No ticket types found.</div>');
            }
        }

        function bindPriorities() {
            const items = dd.priorityItems || [];
            const $box = $('#prioritySelector');
            $box.empty();

            if (!items.length && dd.priorities && dd.priorities.length) {
                dd.priorities.forEach((name, index) => {
                    $box.append(buildPriorityCard(index + 1, name, name, null));
                });
            } else if (items.length) {
                items.forEach(x => {
                    $box.append(buildPriorityCard(x.id, x.name, x.code, x.colorCode));
                });
            } else {
                $box.html('<div class="empty-master-box">No priorities found.</div>');
            }
        }

        function bindCategories() {
            const items = dd.categoryItems || [];
            const $select = $('#categoryInput');
            $select.find('option:not(:first)').remove();

            items.forEach(x => {
                $select.append(`<option value="${escapeHtml(x.name)}" data-id="${x.id}">${escapeHtml(x.name)}</option>`);
            });
        }

        function bindModules() {
            const items = dd.moduleItems || [];
            const $select = $('#moduleInput');
            $select.find('option:not(:first)').remove();

            items.forEach(x => {
                $select.append(`<option value="${escapeHtml(x.name)}" data-id="${x.id}" data-category-id="${x.categoryId || ''}">${escapeHtml(x.name)}</option>`);
            });
        }

        function bindSeverities() {
            const items = dd.severityItems || [];
            const $select = $('#severityInput');
            $select.find('option:not(:first)').remove();

            items.forEach(x => {
                $select.append(`<option value="${escapeHtml(x.name)}" data-id="${x.id}">${escapeHtml(x.name)}</option>`);
            });
        }

        function populateForm(t) {
            $('#editTicketNumber').html(`<i class="bi bi-hash"></i>${escapeHtml(t.ticketNumber || '')}`);

            $('#ticketIdInput').val(t.ticketId || '');
            $('#titleInput').val(t.title || '');
            $('#descInput').val(t.description || '');
            $('#dueDateInput').val(t.dueDate ? t.dueDate.split('T')[0] : '');

            $('#stepsInput').val(t.stepsToReproduce || '');
            $('#expectedInput').val(t.expectedResult || '');
            $('#actualInput').val(t.actualResult || '');
            $('#envInput').val(t.environment || '');

            selectTypeByTicket(t);
            selectPriorityByTicket(t);

            setSelectByValueOrId('#moduleInput', '#moduleIdInput', t.module || t.moduleName, t.moduleId);
            setSelectByValueOrId('#categoryInput', '#categoryIdInput', t.category || t.categoryName, t.categoryId);
            setSelectByValueOrId('#severityInput', '#severityIdInput', t.severity || t.severityName, t.severityId);

            if ((t.ticketType || '').toLowerCase() === 'bug') {
                $('#bugFieldsSection').show();
            } else {
                $('#bugFieldsSection').hide();
            }
        }

        function selectTypeByTicket(t) {
            let $option = $(`#typeSelector .selector-option[data-id="${t.ticketTypeId}"]`);

            if (!$option.length) {
                $option = $('#typeSelector .selector-option').filter(function () {
                    return ($(this).data('name') || '').toString().toLowerCase() === (t.ticketType || '').toLowerCase();
                }).first();
            }

            if ($option.length) {
                selectOption($option[0], 'type', $option.data('name'), $option.data('id'), false);
            } else {
                $('#ticketTypeInput').val(t.ticketType || '');
                $('#ticketTypeIdInput').val(t.ticketTypeId || '');
            }
        }

        function selectPriorityByTicket(t) {
            let $option = $(`#prioritySelector .selector-option[data-id="${t.priorityId}"]`);

            if (!$option.length) {
                $option = $('#prioritySelector .selector-option').filter(function () {
                    return ($(this).data('name') || '').toString().toLowerCase() === (t.priority || '').toLowerCase();
                }).first();
            }

            if ($option.length) {
                selectOption($option[0], 'priority', $option.data('name'), $option.data('id'), false);
            } else {
                $('#priorityInput').val(t.priority || '');
                $('#priorityIdInput').val(t.priorityId || '');
            }
        }

        function setSelectByValueOrId(selectId, hiddenId, value, id) {
            const $select = $(selectId);

            if (id) {
                const $byId = $select.find(`option[data-id="${id}"]`);
                if ($byId.length) {
                    $byId.prop('selected', true);
                    $(hiddenId).val(id);
                    return;
                }
            }

            if (value) {
                $select.val(value);
                $(hiddenId).val($select.find(':selected').data('id') || '');
            }
        }

        function buildTypeCard(id, name, code, color) {
            const lower = (name || '').toLowerCase();
            const icon = getTypeIcon(lower);

            return `
                <div class="selector-option"
                     data-id="${id}"
                     data-name="${escapeHtml(name)}"
                     data-code="${escapeHtml(code || '')}"
                     onclick="selectOption(this, 'type', '${escapeJs(name)}', ${id}, true)">
                    <i class="${icon}" style="${color ? `color:${color};` : ''}"></i>
                    <div class="small fw-bold">${escapeHtml(name)}</div>
                    <small class="text-muted">${escapeHtml(code || '')}</small>
                </div>`;
        }

        function buildPriorityCard(id, name, code, color) {
            const lower = (name || '').toLowerCase();
            const icon = getPriorityIcon(lower);

            return `
                <div class="selector-option"
                     data-id="${id}"
                     data-name="${escapeHtml(name)}"
                     data-code="${escapeHtml(code || '')}"
                     onclick="selectOption(this, 'priority', '${escapeJs(name)}', ${id}, true)">
                    <i class="${icon}" style="${color ? `color:${color};` : ''}"></i>
                    <div class="small fw-bold">${escapeHtml(name)}</div>
                    <small class="text-muted">${escapeHtml(code || '')}</small>
                </div>`;
        }

        function selectOption(element, type, value, id, markChange = true) {
            const selector = type === 'type' ? '#typeSelector' : '#prioritySelector';
            $(`${selector} .selector-option`).removeClass('selected');
            $(element).addClass('selected');

            if (type === 'type') {
                $('#ticketTypeInput').val(value);
                $('#ticketTypeIdInput').val(id || '');

                if ((value || '').toLowerCase() === 'bug') {
                    $('#bugFieldsSection').slideDown();
                } else {
                    $('#bugFieldsSection').slideUp();
                }
            } else {
                $('#priorityInput').val(value);
                $('#priorityIdInput').val(id || '');
            }

            if (markChange && !isInitialLoad) {
                hasChanges = true;
                $('#changesIndicator').addClass('show');
            }
        }

        function trackChanges() {
            $('input, textarea, select').on('change input', function () {
                if (!isInitialLoad) {
                    hasChanges = true;
                    $('#changesIndicator').addClass('show');
                }
            });
        }

        window.addEventListener('beforeunload', function (e) {
            if (hasChanges) {
                e.preventDefault();
                e.returnValue = '';
            }
        });

        $('#editForm').on('submit', function (e) {
            const title = $('#titleInput').val().trim();
            const desc = $('#descInput').val().trim();

            if (title.length < 5) {
                e.preventDefault();
                alert('Title must be at least 5 characters');
                return;
            }

            if (desc.length < 10) {
                e.preventDefault();
                alert('Description must be at least 10 characters');
                return;
            }

            if (!$('#ticketTypeInput').val()) {
                e.preventDefault();
                alert('Please select ticket type');
                return;
            }

            if (!$('#priorityInput').val()) {
                e.preventDefault();
                alert('Please select priority');
                return;
            }

            hasChanges = false;

            $('#updateBtn').prop('disabled', true)
                .html('<i class="bi bi-hourglass-split me-1"></i>Updating...');
        });

        function getTypeIcon(type) {
            if (type.includes('bug')) return 'bi bi-bug text-danger';
            if (type.includes('feature')) return 'bi bi-stars text-warning';
            if (type.includes('task')) return 'bi bi-check2-square text-primary';
            if (type.includes('support')) return 'bi bi-headset text-info';
            if (type.includes('change')) return 'bi bi-arrow-repeat text-warning';
            if (type.includes('improvement')) return 'bi bi-arrow-up-circle text-success';
            return 'bi bi-ticket-detailed text-primary';
        }

        function getPriorityIcon(priority) {
            if (priority.includes('critical')) return 'bi bi-exclamation-triangle text-danger';
            if (priority.includes('high')) return 'bi bi-arrow-up-circle';
            if (priority.includes('medium')) return 'bi bi-dash-circle text-warning';
            if (priority.includes('low')) return 'bi bi-arrow-down-circle text-success';
            return 'bi bi-flag text-secondary';
        }

        function escapeHtml(value) {
            return String(value || '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');
        }

        function escapeJs(value) {
            return String(value || '').replaceAll("\\", "\\\\").replaceAll("'", "\\'");
        }
    </script>
}