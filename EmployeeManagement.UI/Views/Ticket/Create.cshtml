@{
    ViewData["Title"] = "Create Ticket";
    var userRole = ViewBag.UserRole as string ?? "Employee";
    var dropdownsJson = ViewBag.DropdownsJson as string ?? "{}";
}

@section Styles {
    <style>
        body {
            background: #f0f2f5;
        }

        .form-hero {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            color: white;
            padding: 2rem;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(17, 153, 142, 0.3);
            margin-bottom: 1.5rem;
        }

        .form-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            border: none;
            overflow: hidden;
        }

        .form-section {
            padding: 1.5rem;
            border-bottom: 1px solid #f1f5f9;
        }

            .form-section:last-child {
                border-bottom: none;
            }

        .form-section-title {
            font-weight: 700;
            color: #475569;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .form-control, .form-select {
            border-radius: 10px;
            border: 1.5px solid #e2e8f0;
            padding: 0.65rem 1rem;
            transition: all 0.2s;
        }

            .form-control:focus, .form-select:focus {
                border-color: #11998e;
                box-shadow: 0 0 0 3px rgba(17, 153, 142, 0.15);
            }

        .form-label {
            font-weight: 600;
            color: #334155;
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
        }

        .required {
            color: #ef4444;
        }

        /* Priority Selector */
        .priority-selector {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 0.75rem;
        }

        .priority-option {
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 1rem 0.75rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s;
            background: white;
        }

            .priority-option:hover {
                transform: translateY(-2px);
            }

            .priority-option.selected.critical {
                border-color: #dc3545;
                background: linear-gradient(135deg, #fff5f5, #fed7d7);
            }

            .priority-option.selected.high {
                border-color: #fd7e14;
                background: linear-gradient(135deg, #fff7ed, #ffedd5);
            }

            .priority-option.selected.medium {
                border-color: #ffc107;
                background: linear-gradient(135deg, #fffbeb, #fef3c7);
            }

            .priority-option.selected.low {
                border-color: #28a745;
                background: linear-gradient(135deg, #f0fdf4, #dcfce7);
            }

        .priority-icon {
            font-size: 1.5rem;
            margin-bottom: 0.5rem;
        }

        /* Type Selector */
        .type-selector {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 0.75rem;
        }

        .type-option {
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 1rem 0.75rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s;
            background: white;
        }

            .type-option:hover {
                transform: translateY(-2px);
            }

            .type-option.selected {
                border-color: #667eea;
                background: linear-gradient(135deg, #eef2ff, #e0e7ff);
                color: #4338ca;
            }

            .type-option i {
                font-size: 1.5rem;
                margin-bottom: 0.5rem;
                display: block;
            }

        .bug-fields {
            background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
            border-radius: 12px;
            padding: 1.25rem;
            border-left: 4px solid #f59e0b;
        }

        .btn-submit {
            background: linear-gradient(135deg, #11998e, #38ef7d);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 0.85rem 2rem;
            font-weight: 700;
            transition: all 0.3s;
        }

            .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(17, 153, 142, 0.4);
                color: white;
            }

        .char-counter {
            text-align: right;
            font-size: 0.75rem;
            color: #94a3b8;
            margin-top: 0.25rem;
        }
    </style>
}

<div class="container py-3 pb-5">

    <!-- HERO -->
    <div class="form-hero">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h2 class="fw-bold mb-1">
                    <i class="bi bi-plus-circle me-2"></i>Create New Ticket
                </h2>
                <p class="mb-0 opacity-90">Report bugs, request features, or seek support</p>
            </div>
            <a href="javascript:history.back()" class="btn btn-light fw-semibold">
                <i class="bi bi-arrow-left me-1"></i>Back
            </a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Create" method="post" id="createForm">
        @Html.AntiForgeryToken()

        <div class="form-card">

            <!-- BASIC INFO -->
            <div class="form-section">
                <div class="form-section-title">
                    <i class="bi bi-info-circle text-primary"></i>Basic Information
                </div>

                <div class="mb-3">
                    <label class="form-label">Title <span class="required">*</span></label>
                    <input type="text" name="title" class="form-control" required
                           maxlength="500" id="titleInput"
                           placeholder="Brief description (e.g., Login page error on Chrome)" />
                    <div class="char-counter"><span id="titleCount">0</span>/500</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Description <span class="required">*</span></label>
                    <textarea name="description" class="form-control" rows="4" required
                              id="descInput"
                              placeholder="Detailed description of the issue or request..."></textarea>
                </div>
            </div>

            <!-- TICKET TYPE -->
            <div class="form-section">
                <div class="form-section-title">
                    <i class="bi bi-tags text-info"></i>Ticket Type
                </div>

                <input type="hidden" name="ticketType" id="typeInput" value="Bug" required />

                <div class="type-selector">
                    <div class="type-option selected" data-type="Bug" onclick="selectType(this, 'Bug')">
                        <i class="bi bi-bug-fill text-danger"></i>
                        <strong>Bug</strong>
                        <small class="d-block text-muted">Something broken</small>
                    </div>
                    <div class="type-option" data-type="Feature" onclick="selectType(this, 'Feature')">
                        <i class="bi bi-stars text-warning"></i>
                        <strong>Feature</strong>
                        <small class="d-block text-muted">New functionality</small>
                    </div>
                    <div class="type-option" data-type="Task" onclick="selectType(this, 'Task')">
                        <i class="bi bi-check2-square text-primary"></i>
                        <strong>Task</strong>
                        <small class="d-block text-muted">Work item</small>
                    </div>
                    <div class="type-option" data-type="Improvement" onclick="selectType(this, 'Improvement')">
                        <i class="bi bi-arrow-up-circle text-success"></i>
                        <strong>Improvement</strong>
                        <small class="d-block text-muted">Enhance existing</small>
                    </div>
                    <div class="type-option" data-type="Support" onclick="selectType(this, 'Support')">
                        <i class="bi bi-headset text-info"></i>
                        <strong>Support</strong>
                        <small class="d-block text-muted">Need help</small>
                    </div>
                </div>
            </div>

            <!-- PRIORITY -->
            <div class="form-section">
                <div class="form-section-title">
                    <i class="bi bi-flag-fill text-warning"></i>Priority
                </div>

                <input type="hidden" name="priority" id="priorityInput" value="Medium" required />

                <div class="priority-selector">
                    <div class="priority-option" data-priority="Low" onclick="selectPriority(this, 'Low')">
                        <div class="priority-icon"><i class="bi bi-arrow-down-circle text-success"></i></div>
                        <strong>Low</strong>
                        <small class="d-block text-muted">No urgency</small>
                    </div>
                    <div class="priority-option selected medium" data-priority="Medium" onclick="selectPriority(this, 'Medium')">
                        <div class="priority-icon"><i class="bi bi-dash-circle text-warning"></i></div>
                        <strong>Medium</strong>
                        <small class="d-block text-muted">Normal</small>
                    </div>
                    <div class="priority-option" data-priority="High" onclick="selectPriority(this, 'High')">
                        <div class="priority-icon"><i class="bi bi-arrow-up-circle" style="color:#fd7e14;"></i></div>
                        <strong>High</strong>
                        <small class="d-block text-muted">Important</small>
                    </div>
                    <div class="priority-option" data-priority="Critical" onclick="selectPriority(this, 'Critical')">
                        <div class="priority-icon"><i class="bi bi-exclamation-triangle text-danger"></i></div>
                        <strong>Critical</strong>
                        <small class="d-block text-muted">Urgent!</small>
                    </div>
                </div>
            </div>

            <!-- CATEGORIZATION -->
            <div class="form-section">
                <div class="form-section-title">
                    <i class="bi bi-diagram-3 text-secondary"></i>Categorization
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Module</label>
                        <select name="module" class="form-select">
                            <option value="">Select Module</option>
                            <option value="HR">HR Management</option>
                            <option value="Payroll">Payroll</option>
                            <option value="Leave">Leave Management</option>
                            <option value="Attendance">Attendance</option>
                            <option value="Employee">Employee</option>
                            <option value="Reports">Reports</option>
                            <option value="Authentication">Authentication</option>
                            <option value="UI">User Interface</option>
                            <option value="API">API</option>
                            <option value="Database">Database</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Category</label>
                        <select name="category" class="form-select">
                            <option value="">Select Category</option>
                            <option value="Functionality">Functionality</option>
                            <option value="UI/UX">UI/UX</option>
                            <option value="Performance">Performance</option>
                            <option value="Security">Security</option>
                            <option value="Documentation">Documentation</option>
                            <option value="Integration">Integration</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Severity</label>
                        <select name="severity" class="form-select">
                            <option value="">Select Severity</option>
                            <option value="Blocker">Blocker</option>
                            <option value="Major">Major</option>
                            <option value="Minor">Minor</option>
                            <option value="Trivial">Trivial</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- BUG-SPECIFIC FIELDS -->
            <div class="form-section" id="bugFieldsSection">
                <div class="form-section-title">
                    <i class="bi bi-bug text-danger"></i>Bug Details
                </div>

                <div class="bug-fields">
                    <div class="mb-3">
                        <label class="form-label">Steps to Reproduce</label>
                        <textarea name="stepsToReproduce" class="form-control" rows="3"
                                  placeholder="1. Go to login page&#10;2. Click Submit&#10;3. See error"></textarea>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Expected Result</label>
                            <textarea name="expectedResult" class="form-control" rows="2"
                                      placeholder="What should happen..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Actual Result</label>
                            <textarea name="actualResult" class="form-control" rows="2"
                                      placeholder="What actually happens..."></textarea>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label">Environment</label>
                        <input type="text" name="environment" class="form-control"
                               placeholder="e.g., Windows 11, Chrome 119, Production" />
                    </div>
                </div>
            </div>

            <!-- ASSIGNMENT (Manager/Admin only) -->
            @if (userRole == "Admin" || userRole == "Manager")
            {
                <div class="form-section">
                    <div class="form-section-title">
                        <i class="bi bi-person-check text-primary"></i>Assignment & Schedule
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Assign To</label>
                            <select name="assignedTo" class="form-select" id="assignSelect">
                                <option value="">Unassigned</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Due Date</label>
                            <input type="date" name="dueDate" class="form-control"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Est. Hours</label>
                            <input type="number" name="estimatedHours" class="form-control"
                                   step="0.5" min="0" placeholder="8" />
                        </div>
                    </div>
                </div>
            }

            <!-- ACTIONS -->
            <div class="form-section">
                <div class="d-flex gap-2 justify-content-end flex-wrap">
                    <a href="javascript:history.back()" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-x-circle me-1"></i>Cancel
                    </a>
                    <button type="reset" class="btn btn-outline-warning px-4">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
                    </button>
                    <button type="submit" class="btn btn-submit px-4" id="submitBtn">
                        <i class="bi bi-check-circle me-1"></i>Create Ticket
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const dropdownData = @Html.Raw(dropdownsJson);

        $(document).ready(function() {
            // Populate developers
            if (dropdownData?.data?.developers) {
                const $select = $('#assignSelect');
                dropdownData.data.developers.forEach(d => {
                    $select.append(`<option value="${d.userId}">${d.fullName} (${d.role || 'Developer'})</option>`);
                });
            }

            // Char counter
            $('#titleInput').on('input', function() {
                $('#titleCount').text(this.value.length);
            });
        });

        function selectType(el, type) {
            $('.type-option').removeClass('selected');
            $(el).addClass('selected');
            $('#typeInput').val(type);

            if (type === 'Bug') $('#bugFieldsSection').slideDown();
            else $('#bugFieldsSection').slideUp();
        }

        function selectPriority(el, priority) {
            $('.priority-option').removeClass('selected critical high medium low');
            $(el).addClass('selected ' + priority.toLowerCase());
            $('#priorityInput').val(priority);
        }

        $('#createForm').on('submit', function(e) {
            const title = $('#titleInput').val().trim();
            const desc = $('#descInput').val().trim();

            if (title.length < 5) {
                e.preventDefault();
                alert('Title must be at least 5 characters');
                return;
            }

            if (desc.length < 10) {
                e.preventDefault();
                alert('Description must be at least 10 characters');
                return;
            }

            $('#submitBtn').prop('disabled', true)
                .html('<i class="bi bi-hourglass-split me-1"></i>Creating...');
        });
    </script>
}