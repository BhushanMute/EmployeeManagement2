@{
    ViewData["Title"] = "Create Ticket";
    var userRole = ViewBag.UserRole as string ?? "Employee";
    var dropdownsJson = ViewBag.DropdownsJson as string ?? "{}";
}

@section Styles {
    <style>
        body {
            background: #f0f2f5;
        }

        .form-hero {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            color: white;
            padding: 2rem;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(17, 153, 142, 0.3);
            margin-bottom: 1.5rem;
        }

        .form-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            border: none;
            overflow: hidden;
        }

        .form-section {
            padding: 1.5rem;
            border-bottom: 1px solid #f1f5f9;
        }

            .form-section:last-child {
                border-bottom: none;
            }

        .form-section-title {
            font-weight: 700;
            color: #475569;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .form-control, .form-select {
            border-radius: 10px;
            border: 1.5px solid #e2e8f0;
            padding: 0.65rem 1rem;
            transition: all 0.2s;
        }

            .form-control:focus, .form-select:focus {
                border-color: #11998e;
                box-shadow: 0 0 0 3px rgba(17, 153, 142, 0.15);
            }

        .form-label {
            font-weight: 600;
            color: #334155;
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
        }

        .required {
            color: #ef4444;
        }

        .priority-selector {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 0.75rem;
        }

        .priority-option {
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 1rem 0.75rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s;
            background: white;
        }

            .priority-option:hover {
                transform: translateY(-2px);
            }

            .priority-option.selected {
                border-color: #11998e;
                background: linear-gradient(135deg, #ecfdf5, #d1fae5);
            }

                .priority-option.selected.critical {
                    border-color: #dc3545;
                    background: linear-gradient(135deg, #fff5f5, #fed7d7);
                }

                .priority-option.selected.high {
                    border-color: #fd7e14;
                    background: linear-gradient(135deg, #fff7ed, #ffedd5);
                }

                .priority-option.selected.medium {
                    border-color: #ffc107;
                    background: linear-gradient(135deg, #fffbeb, #fef3c7);
                }

                .priority-option.selected.low {
                    border-color: #28a745;
                    background: linear-gradient(135deg, #f0fdf4, #dcfce7);
                }

        .priority-icon {
            font-size: 1.5rem;
            margin-bottom: 0.5rem;
        }

        .type-selector {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 0.75rem;
        }

        .type-option {
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 1rem 0.75rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s;
            background: white;
        }

            .type-option:hover {
                transform: translateY(-2px);
            }

            .type-option.selected {
                border-color: #667eea;
                background: linear-gradient(135deg, #eef2ff, #e0e7ff);
                color: #4338ca;
            }

            .type-option i {
                font-size: 1.5rem;
                margin-bottom: 0.5rem;
                display: block;
            }

        .bug-fields {
            background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
            border-radius: 12px;
            padding: 1.25rem;
            border-left: 4px solid #f59e0b;
        }

        .btn-submit {
            background: linear-gradient(135deg, #11998e, #38ef7d);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 0.85rem 2rem;
            font-weight: 700;
            transition: all 0.3s;
        }

            .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(17, 153, 142, 0.4);
                color: white;
            }

        .char-counter {
            text-align: right;
            font-size: 0.75rem;
            color: #94a3b8;
            margin-top: 0.25rem;
        }

        .empty-master-box {
            border: 2px dashed #cbd5e1;
            border-radius: 12px;
            padding: 1rem;
            color: #64748b;
            background: #f8fafc;
            text-align: center;
        }
    </style>
}

<div class="container py-3 pb-5">

    <div class="form-hero">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h2 class="fw-bold mb-1">
                    <i class="bi bi-plus-circle me-2"></i>Create New Ticket
                </h2>
                <p class="mb-0 opacity-90">Report bugs, request features, or seek support</p>
            </div>
            <a href="javascript:history.back()" class="btn btn-light fw-semibold">
                <i class="bi bi-arrow-left me-1"></i>Back
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Create" method="post" id="createForm">
        @Html.AntiForgeryToken()

        <input type="hidden" name="ticketTypeId" id="ticketTypeIdInput" />
        <input type="hidden" name="priorityId" id="priorityIdInput" />
        <input type="hidden" name="categoryId" id="categoryIdInput" />
        <input type="hidden" name="moduleId" id="moduleIdInput" />
        <input type="hidden" name="severityId" id="severityIdInput" />

        <div class="form-card">

            <div class="form-section">
                <div class="form-section-title">
                    <i class="bi bi-info-circle text-primary"></i>Basic Information
                </div>

                <div class="mb-3">
                    <label class="form-label">Title <span class="required">*</span></label>
                    <input type="text" name="title" class="form-control" required
                           maxlength="500" id="titleInput"
                           placeholder="Brief description e.g. Login page error on Chrome" />
                    <div class="char-counter"><span id="titleCount">0</span>/500</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Description <span class="required">*</span></label>
                    <textarea name="description" class="form-control" rows="4" required
                              id="descInput"
                              placeholder="Detailed description of the issue or request..."></textarea>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">
                    <i class="bi bi-tags text-info"></i>Ticket Type
                </div>

                <input type="hidden" name="ticketType" id="typeInput" required />

                <div class="type-selector" id="dynamicTypeSelector"></div>
            </div>

            <div class="form-section">
                <div class="form-section-title">
                    <i class="bi bi-flag-fill text-warning"></i>Priority
                </div>

                <input type="hidden" name="priority" id="priorityInput" required />

                <div class="priority-selector" id="dynamicPrioritySelector"></div>
            </div>

            <div class="form-section">
                <div class="form-section-title">
                    <i class="bi bi-diagram-3 text-secondary"></i>Categorization
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Module</label>
                        <select name="module" id="moduleSelect" class="form-select">
                            <option value="">Select Module</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Category</label>
                        <select name="category" id="categorySelect" class="form-select">
                            <option value="">Select Category</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Severity</label>
                        <select name="severity" id="severitySelect" class="form-select">
                            <option value="">Select Severity</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-section" id="bugFieldsSection" style="display:none;">
                <div class="form-section-title">
                    <i class="bi bi-bug text-danger"></i>Bug Details
                </div>

                <div class="bug-fields">
                    <div class="mb-3">
                        <label class="form-label">Steps to Reproduce</label>
                        <textarea name="stepsToReproduce" class="form-control" rows="3"
                                  placeholder="1. Go to login page&#10;2. Click Submit&#10;3. See error"></textarea>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Expected Result</label>
                            <textarea name="expectedResult" class="form-control" rows="2"
                                      placeholder="What should happen..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Actual Result</label>
                            <textarea name="actualResult" class="form-control" rows="2"
                                      placeholder="What actually happens..."></textarea>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label">Environment</label>
                        <input type="text" name="environment" class="form-control"
                               placeholder="e.g. Windows 11, Chrome 119, Production" />
                    </div>
                </div>
            </div>

            @if (userRole == "Admin" || userRole == "Manager")
            {
                <div class="form-section">
                    <div class="form-section-title">
                        <i class="bi bi-person-check text-primary"></i>Assignment & Schedule
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Assign To</label>
                            <select name="assignedTo" class="form-select" id="assignSelect">
                                <option value="">Unassigned</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Due Date</label>
                            <input type="date" name="dueDate" class="form-control"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Est. Hours</label>
                            <input type="number" name="estimatedHours" class="form-control"
                                   step="0.5" min="0" placeholder="8" />
                        </div>
                    </div>
                </div>
            }

            <div class="form-section">
                <div class="d-flex gap-2 justify-content-end flex-wrap">
                    <a href="javascript:history.back()" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-x-circle me-1"></i>Cancel
                    </a>

                    <button type="reset" class="btn btn-outline-warning px-4">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
                    </button>

                    <button type="submit" class="btn btn-submit px-4" id="submitBtn">
                        <i class="bi bi-check-circle me-1"></i>Create Ticket
                    </button>
                </div>
            </div>

        </div>
    </form>
</div>

@section Scripts {
    <script>
        const dropdownData = @Html.Raw(dropdownsJson);
        const dd = dropdownData?.data || {};

        $(document).ready(function () {
            bindTicketTypes();
            bindPriorities();
            bindCategories();
            bindModules();
            bindSeverities();
            bindDevelopers();

            $('#titleInput').on('input', function () {
                $('#titleCount').text(this.value.length);
            });

            $('#moduleSelect').on('change', function () {
                const selected = $(this).find(':selected');
                $('#moduleIdInput').val(selected.data('id') || '');
            });

            $('#categorySelect').on('change', function () {
                const selected = $(this).find(':selected');
                $('#categoryIdInput').val(selected.data('id') || '');
            });

            $('#severitySelect').on('change', function () {
                const selected = $(this).find(':selected');
                $('#severityIdInput').val(selected.data('id') || '');
            });

            $('#createForm').on('reset', function () {
                setTimeout(function () {
                    const firstType = $('#dynamicTypeSelector .type-option').first();
                    if (firstType.length) {
                        selectType(firstType[0], firstType.data('name'), firstType.data('id'));
                    }

                    const mediumPriority = $('#dynamicPrioritySelector .priority-option').filter(function () {
                        return ($(this).data('name') || '').toString().toLowerCase() === 'medium';
                    }).first();

                    const firstPriority = mediumPriority.length ? mediumPriority : $('#dynamicPrioritySelector .priority-option').first();
                    if (firstPriority.length) {
                        selectPriority(firstPriority[0], firstPriority.data('name'), firstPriority.data('id'));
                    }

                    $('#categoryIdInput').val('');
                    $('#moduleIdInput').val('');
                    $('#severityIdInput').val('');
                }, 50);
            });
        });

        function bindTicketTypes() {
            const items = dd.ticketTypeItems || [];
            const $box = $('#dynamicTypeSelector');
            $box.empty();

            if (!items.length && dd.ticketTypes && dd.ticketTypes.length) {
                dd.ticketTypes.forEach((name, index) => {
                    $box.append(buildTypeCard(index + 1, name, name, null));
                });
            } else if (items.length) {
                items.forEach(x => {
                    $box.append(buildTypeCard(x.id, x.name, x.code, x.colorCode));
                });
            } else {
                $box.html('<div class="empty-master-box">No ticket types found. Please add Ticket Type master data.</div>');
                return;
            }

            const $first = $box.find('.type-option').first();
            if ($first.length) {
                selectType($first[0], $first.data('name'), $first.data('id'));
            }
        }

        function bindPriorities() {
            const items = dd.priorityItems || [];
            const $box = $('#dynamicPrioritySelector');
            $box.empty();

            if (!items.length && dd.priorities && dd.priorities.length) {
                dd.priorities.forEach((name, index) => {
                    $box.append(buildPriorityCard(index + 1, name, name, null));
                });
            } else if (items.length) {
                items.forEach(x => {
                    $box.append(buildPriorityCard(x.id, x.name, x.code, x.colorCode));
                });
            } else {
                $box.html('<div class="empty-master-box">No priorities found. Please add Priority master data.</div>');
                return;
            }

            const $medium = $box.find('.priority-option').filter(function () {
                const name = ($(this).data('name') || '').toString().toLowerCase();
                const code = ($(this).data('code') || '').toString().toLowerCase();
                return name === 'medium' || code === 'medium';
            }).first();

            const $selected = $medium.length ? $medium : $box.find('.priority-option').first();

            if ($selected.length) {
                selectPriority($selected[0], $selected.data('name'), $selected.data('id'));
            }
        }

        function bindCategories() {
            const items = dd.categoryItems || [];
            const $select = $('#categorySelect');
            $select.find('option:not(:first)').remove();

            items.forEach(x => {
                $select.append(`<option value="${escapeHtml(x.name)}" data-id="${x.id}">${escapeHtml(x.name)}</option>`);
            });
        }

        function bindModules() {
            const items = dd.moduleItems || [];
            const $select = $('#moduleSelect');
            $select.find('option:not(:first)').remove();

            items.forEach(x => {
                $select.append(`<option value="${escapeHtml(x.name)}" data-id="${x.id}" data-category-id="${x.categoryId || ''}">${escapeHtml(x.name)}</option>`);
            });
        }

        function bindSeverities() {
            const items = dd.severityItems || [];
            const $select = $('#severitySelect');
            $select.find('option:not(:first)').remove();

            items.forEach(x => {
                $select.append(`<option value="${escapeHtml(x.name)}" data-id="${x.id}">${escapeHtml(x.name)}</option>`);
            });
        }

        function bindDevelopers() {
            const developers = dd.developers || [];
            const $select = $('#assignSelect');

            if (!$select.length) return;

            $select.find('option:not(:first)').remove();

            developers.forEach(d => {
                const userId = d.userId || d.id || d.value;
                const fullName = d.fullName || d.name || d.text || 'User';
                const role = d.role || 'Developer';

                $select.append(`<option value="${userId}">${escapeHtml(fullName)} (${escapeHtml(role)})</option>`);
            });
        }

        function buildTypeCard(id, name, code, color) {
            const lower = (name || '').toLowerCase();
            const icon = getTypeIcon(lower);

            return `
                <div class="type-option"
                     data-id="${id}"
                     data-name="${escapeHtml(name)}"
                     data-code="${escapeHtml(code || '')}"
                     onclick="selectType(this, '${escapeJs(name)}', ${id})">
                    <i class="${icon}" style="${color ? `color:${color};` : ''}"></i>
                    <strong>${escapeHtml(name)}</strong>
                    <small class="d-block text-muted">${escapeHtml(code || '')}</small>
                </div>`;
        }

        function buildPriorityCard(id, name, code, color) {
            const cls = (name || '').toLowerCase().replace(/\s+/g, '');
            const icon = getPriorityIcon(cls);

            return `
                <div class="priority-option"
                     data-id="${id}"
                     data-name="${escapeHtml(name)}"
                     data-code="${escapeHtml(code || '')}"
                     onclick="selectPriority(this, '${escapeJs(name)}', ${id})">
                    <div class="priority-icon">
                        <i class="${icon}" style="${color ? `color:${color};` : ''}"></i>
                    </div>
                    <strong>${escapeHtml(name)}</strong>
                    <small class="d-block text-muted">${escapeHtml(code || '')}</small>
                </div>`;
        }

        function selectType(el, type, id) {
            $('.type-option').removeClass('selected');
            $(el).addClass('selected');

            $('#typeInput').val(type);
            $('#ticketTypeIdInput').val(id || '');

            if ((type || '').toLowerCase() === 'bug') {
                $('#bugFieldsSection').slideDown();
            } else {
                $('#bugFieldsSection').slideUp();
            }
        }

        function selectPriority(el, priority, id) {
            $('.priority-option').removeClass('selected critical high medium low');
            const cls = (priority || '').toLowerCase().replace(/\s+/g, '');
            $(el).addClass('selected ' + cls);

            $('#priorityInput').val(priority);
            $('#priorityIdInput').val(id || '');
        }

        $('#createForm').on('submit', function (e) {
            const title = $('#titleInput').val().trim();
            const desc = $('#descInput').val().trim();

            if (title.length < 5) {
                e.preventDefault();
                alert('Title must be at least 5 characters');
                return;
            }

            if (desc.length < 10) {
                e.preventDefault();
                alert('Description must be at least 10 characters');
                return;
            }

            if (!$('#typeInput').val()) {
                e.preventDefault();
                alert('Please select ticket type');
                return;
            }

            if (!$('#priorityInput').val()) {
                e.preventDefault();
                alert('Please select priority');
                return;
            }

            $('#submitBtn').prop('disabled', true)
                .html('<i class="bi bi-hourglass-split me-1"></i>Creating...');
        });

        function getTypeIcon(type) {
            if (type.includes('bug')) return 'bi bi-bug-fill text-danger';
            if (type.includes('feature')) return 'bi bi-stars text-warning';
            if (type.includes('task')) return 'bi bi-check2-square text-primary';
            if (type.includes('support')) return 'bi bi-headset text-info';
            if (type.includes('change')) return 'bi bi-arrow-repeat text-warning';
            if (type.includes('improvement')) return 'bi bi-arrow-up-circle text-success';
            return 'bi bi-ticket-detailed text-primary';
        }

        function getPriorityIcon(priority) {
            if (priority.includes('critical')) return 'bi bi-exclamation-triangle text-danger';
            if (priority.includes('high')) return 'bi bi-arrow-up-circle';
            if (priority.includes('medium')) return 'bi bi-dash-circle text-warning';
            if (priority.includes('low')) return 'bi bi-arrow-down-circle text-success';
            return 'bi bi-flag text-secondary';
        }

        function escapeHtml(value) {
            return String(value || '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');
        }

        function escapeJs(value) {
            return String(value || '').replaceAll("\\", "\\\\").replaceAll("'", "\\'");
        }
    </script>
}