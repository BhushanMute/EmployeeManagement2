@{
    ViewData["Title"] = "Ticket Details";
    var userRole = ViewBag.UserRole as string ?? "Employee";
    var userId = ViewBag.UserId as int? ?? 0;
}

<div class="container-fluid py-4">
    <div id="ticketDetails">
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </div>
</div>

<!-- Status Update Modal -->
<div class="modal fade" id="statusModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Update Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="statusForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="statusTicketId" name="ticketId">
                    <div class="mb-3">
                        <label for="newStatus" class="form-label">New Status</label>
                        <select class="form-select" id="newStatus" name="newStatus" required>
                            <option value="New">New</option>
                            <option value="Assigned">Assigned</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Blocked">Blocked</option>
                            <option value="Resolved">Resolved</option>
                            <option value="Closed">Closed</option>
                            <option value="Reopened">Reopened</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="statusRemarks" class="form-label">Remarks</label>
                        <textarea class="form-control" id="statusRemarks" name="remarks" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Status</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Assign Modal -->
<div class="modal fade" id="assignModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Assign Ticket</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="assignForm" method="post" action="@Url.Action("Assign")">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="assignTicketId" name="ticketId">
                    <div class="mb-3">
                        <label for="assignedTo" class="form-label">Assign To</label>
                        <select class="form-select" id="assignedTo" name="assignedTo" required>
                            <option value="">-- Select Developer --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="assignRemarks" class="form-label">Remarks</label>
                        <textarea class="form-control" id="assignRemarks" name="remarks" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Assign</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reopen Modal -->
<div class="modal fade" id="reopenModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Reopen Ticket</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="reopenForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="reopenTicketId" name="id">
                    <div class="mb-3">
                        <label for="reopenRemarks" class="form-label">Reason for Reopening</label>
                        <textarea class="form-control" id="reopenRemarks" name="remarks" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Reopen Ticket</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let ticketData = @Html.Raw(ViewBag.TicketData ?? "null");
        let currentUserId = @userId;
        let currentUserRole = "@userRole";

        if (ticketData && ticketData.success) {
            renderTicketDetails(ticketData.data);
        } else {
            showError();
        }

        function renderTicketDetails(ticket) {
            const html = `
                <!-- Ticket Header -->
                <div class="row mb-4">
                    <div class="col-md-8">
                        <h2 class="mb-2">
                            <span class="badge ${getTypeBadge(ticket.ticketType)} me-2">${ticket.ticketType}</span>
                            ${ticket.ticketNumber}
                        </h2>
                        <h4>${ticket.title}</h4>
                        <div class="d-flex gap-2 mt-2">
                            <span class="badge ${getPriorityBadge(ticket.priority)}">${ticket.priority}</span>
                            <span class="badge ${getStatusBadge(ticket.status)}">${ticket.status}</span>
                            ${ticket.isOverdue ? '<span class="badge bg-danger"><i class="bi bi-exclamation-triangle"></i> Overdue</span>' : ''}
                        </div>
                    </div>
                    <div class="col-md-4 text-end">
                        ${renderActionButtons(ticket)}
                    </div>
                </div>

                <!-- Main Content -->
                <div class="row">
                    <!-- Left Column -->
                    <div class="col-lg-8">
                        <!-- Description Card -->
                        <div class="card shadow-sm mb-3">
                            <div class="card-header bg-light">
                                <h5 class="mb-0"><i class="bi bi-file-text"></i> Description</h5>
                            </div>
                            <div class="card-body">
                                <p class="mb-0">${ticket.description}</p>
                            </div>
                        </div>

                        ${ticket.ticketType === 'Bug' ? renderBugDetails(ticket) : ''}

                        <!-- Comments Section -->
                        <div class="card shadow-sm mb-3">
                            <div class="card-header bg-light">
                                <h5 class="mb-0"><i class="bi bi-chat-dots"></i> Comments (${ticket.comments?.length || 0})</h5>
                            </div>
                            <div class="card-body">
                                ${renderComments(ticket.comments)}

                                <!-- Add Comment Form -->
                                <form method="post" action="@Url.Action("AddComment")" class="mt-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ticketId" value="${ticket.ticketId}">
                                    <div class="mb-2">
                                        <textarea class="form-control" name="comment" rows="3"
                                                  placeholder="Add a comment..." required></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-sm btn-primary">
                                        <i class="bi bi-send"></i> Post Comment
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Attachments Section -->
                        <div class="card shadow-sm mb-3">
                            <div class="card-header bg-light">
                                <h5 class="mb-0"><i class="bi bi-paperclip"></i> Attachments (${ticket.attachments?.length || 0})</h5>
                            </div>
                            <div class="card-body">
                                ${renderAttachments(ticket.attachments, ticket.ticketId)}

                                <!-- Upload Form -->
                                <form method="post" action="@Url.Action("UploadAttachment")"
                                      enctype="multipart/form-data" class="mt-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ticketId" value="${ticket.ticketId}">
                                    <div class="input-group">
                                        <input type="file" class="form-control" name="file" required>
                                        <button type="submit" class="btn btn-primary">
                                            <i class="bi bi-upload"></i> Upload
                                        </button>
                                    </div>
                                    <small class="text-muted">Max 10MB. Allowed: Images, PDF, Documents, Logs, ZIP</small>
                                </form>
                            </div>
                        </div>

                        <!-- History Section -->
                        <div class="card shadow-sm">
                            <div class="card-header bg-light">
                                <h5 class="mb-0"><i class="bi bi-clock-history"></i> History</h5>
                            </div>
                            <div class="card-body">
                                ${renderHistory(ticket.history)}
                            </div>
                        </div>
                    </div>

                    <!-- Right Column (Sidebar) -->
                    <div class="col-lg-4">
                        <!-- Ticket Info Card -->
                        <div class="card shadow-sm mb-3">
                            <div class="card-header bg-light">
                                <h5 class="mb-0"><i class="bi bi-info-circle"></i> Ticket Information</h5>
                            </div>
                            <div class="card-body">
                                <dl class="row mb-0">
                                    <dt class="col-sm-5">Created By:</dt>
                                    <dd class="col-sm-7">${ticket.createdByName}</dd>

                                    <dt class="col-sm-5">Assigned To:</dt>
                                    <dd class="col-sm-7">${ticket.assignedToName || '<span class="text-muted">Unassigned</span>'}</dd>

                                    <dt class="col-sm-5">Created:</dt>
                                    <dd class="col-sm-7">${formatDateTime(ticket.createdDate)}</dd>

                                    <dt class="col-sm-5">Updated:</dt>
                                    <dd class="col-sm-7">${formatDateTime(ticket.updatedDate)}</dd>

                                    ${ticket.dueDate ? `
                                        <dt class="col-sm-5">Due Date:</dt>
                                        <dd class="col-sm-7">${formatDate(ticket.dueDate)}</dd>
                                    ` : ''}

                                    ${ticket.resolvedDate ? `
                                        <dt class="col-sm-5">Resolved:</dt>
                                        <dd class="col-sm-7">${formatDateTime(ticket.resolvedDate)}</dd>
                                    ` : ''}

                                    ${ticket.closedDate ? `
                                        <dt class="col-sm-5">Closed:</dt>
                                        <dd class="col-sm-7">${formatDateTime(ticket.closedDate)}</dd>
                                    ` : ''}
                                </dl>
                            </div>
                        </div>

                        <!-- Quick Actions Card -->
                        <div class="card shadow-sm">
                            <div class="card-header bg-light">
                                <h5 class="mb-0"><i class="bi bi-lightning"></i> Quick Actions</h5>
                            </div>
                            <div class="card-body">
                                <div class="d-grid gap-2">
                                    ${renderQuickActions(ticket)}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            document.getElementById('ticketDetails').innerHTML = html;
            loadDevelopers();
        }

        function renderActionButtons(ticket) {
            let buttons = `<a href="@Url.Action("MyTickets")" class="btn btn-outline-secondary mb-2">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>`;

            // Edit button (only for ticket creator or admin)
            if (currentUserRole === 'Admin' || ticket.createdBy === currentUserId) {
                buttons += ` <a href="@Url.Action("Edit")/${ticket.ticketId}" class="btn btn-outline-primary mb-2">
                    <i class="bi bi-pencil"></i> Edit
                </a>`;
            }

            // Delete button (admin only)
            if (currentUserRole === 'Admin') {
                buttons += ` <button class="btn btn-outline-danger mb-2" onclick="deleteTicket(${ticket.ticketId})">
                    <i class="bi bi-trash"></i> Delete
                </button>`;
            }

            return buttons;
        }

        function renderQuickActions(ticket) {
            let actions = '';

            // Assign button
            if (currentUserRole === 'Admin' || currentUserRole === 'Lead') {
                actions += `<button class="btn btn-info" onclick="showAssignModal(${ticket.ticketId})">
                    <i class="bi bi-person-plus"></i> Assign
                </button>`;
            }

            // Status-specific actions
            if (ticket.status === 'Assigned' && ticket.assignedTo === currentUserId) {
                actions += `<form method="post" action="@Url.Action("InProgress")/${ticket.ticketId}">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-play-circle"></i> Start Work
                    </button>
                </form>`;
            }

            if (ticket.status === 'In Progress' && ticket.assignedTo === currentUserId) {
                actions += `<button class="btn btn-success" onclick="resolveTicket(${ticket.ticketId})">
                    <i class="bi bi-check-circle"></i> Resolve
                </button>`;
                actions += `<button class="btn btn-danger" onclick="blockTicket(${ticket.ticketId})">
                    <i class="bi bi-stop-circle"></i> Block
                </button>`;
            }

            if (ticket.status === 'Resolved' && currentUserRole === 'QA') {
                actions += `<button class="btn btn-success" onclick="closeTicket(${ticket.ticketId})">
                    <i class="bi bi-check-circle"></i> Close
                </button>`;
                actions += `<button class="btn btn-warning" onclick="showReopenModal(${ticket.ticketId})">
                    <i class="bi bi-arrow-repeat"></i> Reopen
                </button>`;
            }

            if (ticket.status === 'Closed' && currentUserRole === 'QA') {
                actions += `<button class="btn btn-warning" onclick="showReopenModal(${ticket.ticketId})">
                    <i class="bi bi-arrow-repeat"></i> Reopen
                </button>`;
            }

            // Update Status button
            actions += `<button class="btn btn-primary" onclick="showStatusModal(${ticket.ticketId}, '${ticket.status}')">
                <i class="bi bi-arrow-repeat"></i> Update Status
            </button>`;

            return actions || '<p class="text-muted mb-0">No quick actions available</p>';
        }

        function renderBugDetails(ticket) {
            return `
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0"><i class="bi bi-bug"></i> Bug Details</h5>
                    </div>
                    <div class="card-body">
                        ${ticket.stepsToReproduce ? `
                            <h6>Steps to Reproduce:</h6>
                            <p class="text-pre-wrap">${ticket.stepsToReproduce}</p>
                        ` : ''}

                        <div class="row">
                            ${ticket.expectedResult ? `
                                <div class="col-md-6">
                                    <h6>Expected Result:</h6>
                                    <p>${ticket.expectedResult}</p>
                                </div>
                            ` : ''}
                            ${ticket.actualResult ? `
                                <div class="col-md-6">
                                    <h6>Actual Result:</h6>
                                    <p>${ticket.actualResult}</p>
                                </div>
                            ` : ''}
                        </div>

                        ${ticket.environment ? `
                            <h6>Environment:</h6>
                            <span class="badge bg-secondary">${ticket.environment}</span>
                        ` : ''}
                    </div>
                </div>
            `;
        }

        function renderComments(comments) {
            if (!comments || comments.length === 0) {
                return '<p class="text-muted">No comments yet. Be the first to comment!</p>';
            }

            let html = '<div class="list-group list-group-flush">';
            comments.forEach(comment => {
                html += `
                    <div class="list-group-item px-0">
                        <div class="d-flex align-items-start">
                            <div class="flex-shrink-0">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                                     style="width: 40px; height: 40px;">
                                    ${comment.userName.charAt(0).toUpperCase()}
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong>${comment.userName}</strong>
                                    <small class="text-muted">${comment.timeAgo}</small>
                                </div>
                                <p class="mb-0">${comment.comment}</p>
                            </div>
                        </div>
                    </div>
                `;
            });
            html += '</div>';
            return html;
        }

        function renderAttachments(attachments, ticketId) {
            if (!attachments || attachments.length === 0) {
                return '<p class="text-muted">No attachments</p>';
            }

            let html = '<div class="list-group">';
            attachments.forEach(att => {
                html += `
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <i class="${att.fileIcon || 'bi bi-file-earmark'}"></i>
                            <strong>${att.fileName}</strong>
                            <br>
                            <small class="text-muted">${att.fileSizeFormatted} • Uploaded by ${att.uploadedByName}</small>
                        </div>
                        <div>
                            <a href="@Url.Action("DownloadAttachment")/${att.attachmentId}"
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-download"></i>
                            </a>
                            <form method="post" action="@Url.Action("DeleteAttachment")"
                                  style="display:inline;" onsubmit="return confirm('Delete this attachment?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="attachmentId" value="${att.attachmentId}">
                                <input type="hidden" name="ticketId" value="${ticketId}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                `;
            });
            html += '</div>';
            return html;
        }

        function renderHistory(history) {
            if (!history || history.length === 0) {
                return '<p class="text-muted">No history</p>';
            }

            let html = '<div class="timeline">';
            history.forEach(h => {
                html += `
                    <div class="d-flex mb-3">
                        <div class="flex-shrink-0">
                            <i class="${h.changeIcon || 'bi bi-circle'} fs-5"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <div>
                                <strong>${h.changedByName}</strong> ${h.changeDescription}
                                ${h.remarks ? `<br><small class="text-muted">${h.remarks}</small>` : ''}
                            </div>
                            <small class="text-muted">${formatDateTime(h.changeDate)}</small>
                        </div>
                    </div>
                `;
            });
            html += '</div>';
            return html;
        }

        // Modal Functions
        function showStatusModal(ticketId, currentStatus) {
            document.getElementById('statusTicketId').value = ticketId;
            document.getElementById('newStatus').value = currentStatus;
            document.getElementById('statusForm').action = '@Url.Action("UpdateStatus")';
            new bootstrap.Modal(document.getElementById('statusModal')).show();
        }

        function showAssignModal(ticketId) {
            document.getElementById('assignTicketId').value = ticketId;
            new bootstrap.Modal(document.getElementById('assignModal')).show();
        }

        function showReopenModal(ticketId) {
            document.getElementById('reopenTicketId').value = ticketId;
            document.getElementById('reopenForm').action = `@Url.Action("Reopen")/${ticketId}`;
            new bootstrap.Modal(document.getElementById('reopenModal')).show();
        }

        // Action Functions
        function resolveTicket(id) {
            const remarks = prompt('Add resolution remarks (optional):');
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = `@Url.Action("Resolve")/${id}`;

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            form.innerHTML = `
                <input type="hidden" name="__RequestVerificationToken" value="${token}">
                <input type="hidden" name="remarks" value="${remarks || ''}">
            `;
            document.body.appendChild(form);
            form.submit();
        }

        function closeTicket(id) {
            if (confirm('Are you sure you want to close this ticket?')) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `@Url.Action("Close")/${id}`;

                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                form.innerHTML = `<input type="hidden" name="__RequestVerificationToken" value="${token}">`;
                document.body.appendChild(form);
                form.submit();
            }
        }

        function blockTicket(id) {
            const remarks = prompt('Reason for blocking:');
            if (remarks) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `@Url.Action("Block")/${id}`;

                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                form.innerHTML = `
                    <input type="hidden" name="__RequestVerificationToken" value="${token}">
                    <input type="hidden" name="remarks" value="${remarks}">
                `;
                document.body.appendChild(form);
                form.submit();
            }
        }

        function deleteTicket(id) {
            if (confirm('Are you sure you want to delete this ticket? This action cannot be undone.')) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `@Url.Action("Delete")/${id}`;

                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                form.innerHTML = `<input type="hidden" name="__RequestVerificationToken" value="${token}">`;
                document.body.appendChild(form);
                form.submit();
            }
        }

        // Load developers for assign dropdown
        async function loadDevelopers() {
            try {
                const response = await fetch('/api/Ticket/developers', {
                    headers: {
                        'Authorization': 'Bearer ' + sessionStorage.getItem('token')
                    }
                });
                const data = await response.json();

                if (data.success) {
                    const select = document.getElementById('assignedTo');
                    select.innerHTML = '<option value="">-- Select Developer --</option>';
                    data.data.forEach(dev => {
                        select.innerHTML += `<option value="${dev.userId}">${dev.fullName} (${dev.role})</option>`;
                    });
                }
            } catch (error) {
                console.error('Error loading developers:', error);
            }
        }

        // Helper Functions
        function getStatusBadge(status) {
            const badges = {
                'New': 'bg-primary',
                'Assigned': 'bg-info',
                'In Progress': 'bg-warning text-dark',
                'Blocked': 'bg-danger',
                'Resolved': 'bg-success',
                'Closed': 'bg-secondary',
                'Reopened': 'bg-warning'
            };
            return badges[status] || 'bg-secondary';
        }

        function getPriorityBadge(priority) {
            const badges = {
                'Critical': 'bg-danger',
                'High': 'bg-warning text-dark',
                'Medium': 'bg-info',
                'Low': 'bg-secondary'
            };
            return badges[priority] || 'bg-secondary';
        }

        function getTypeBadge(type) {
            const badges = {
                'Bug': 'bg-danger',
                'Feature Request': 'bg-primary',
                'Improvement': 'bg-info',
                'Task': 'bg-secondary'
            };
            return badges[type] || 'bg-secondary';
        }

        function formatDate(dateString) {
            return new Date(dateString).toLocaleDateString('en-US', {
                year: 'numeric', month: 'short', day: 'numeric'
            });
        }

        function formatDateTime(dateString) {
            return new Date(dateString).toLocaleString('en-US', {
                year: 'numeric', month: 'short', day: 'numeric',
                hour: '2-digit', minute: '2-digit'
            });
        }

        function showError() {
            document.getElementById('ticketDetails').innerHTML =
                '<div class="alert alert-danger">Failed to load ticket details</div>';
        }
    </script>

    <style>
        .text-pre-wrap {
            white-space: pre-wrap;
        }

        .timeline {
            position: relative;
        }
    </style>
}