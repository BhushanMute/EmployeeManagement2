@{
    ViewData["Title"] = "Ticket Details";
    var userRole = ViewBag.UserRole as string ?? "Employee";
    var userId = (int)(ViewBag.UserId ?? 0);
    var userName = ViewBag.UserName as string ?? "User";
    var ticketJson = ViewBag.TicketJson as string ?? "{}";
    var dropdownsJson = ViewBag.DropdownsJson as string ?? "{}";
    var isAdmin = userRole == "Admin";
    var isManager = userRole == "Manager" || isAdmin;
    var isQA = userRole == "QA" || isAdmin;
    var isDeveloper = userRole == "Developer" || isAdmin;
}

@section Styles {
    <style>
        body {
            background: #f0f2f5;
        }

        .hero {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 2rem;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(102,126,234,0.3);
            margin-bottom: 1.5rem;
            position: relative;
            overflow: hidden;
        }

            .hero::before {
                content: '';
                position: absolute;
                top: -50%;
                right: -10%;
                width: 400px;
                height: 400px;
                background: rgba(255,255,255,0.08);
                border-radius: 50%;
            }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .ticket-num {
            background: rgba(255,255,255,0.2);
            padding: 0.4rem 0.85rem;
            border-radius: 8px;
            font-family: monospace;
            font-weight: 700;
        }

        .card-section {
            background: white;
            border-radius: 14px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            margin-bottom: 1rem;
            overflow: hidden;
        }

        .card-header-custom {
            background: #f8fafc;
            padding: 1rem 1.25rem;
            border-bottom: 2px solid #e2e8f0;
            font-weight: 700;
            color: #475569;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 1px;
        }

        .card-body-custom {
            padding: 1.25rem;
        }

        .desc-box {
            background: #f8fafc;
            padding: 1.25rem;
            border-radius: 10px;
            border-left: 4px solid #6366f1;
            white-space: pre-wrap;
            line-height: 1.6;
            color: #334155;
        }

        .meta-item {
            background: #f8fafc;
            padding: 0.75rem;
            border-radius: 8px;
            border-left: 3px solid #667eea;
            margin-bottom: 0.5rem;
        }

        .meta-label {
            font-size: 0.7rem;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
        }

        .meta-value {
            color: #1e293b;
            font-weight: 600;
            font-size: 0.95rem;
        }

        .btn-wf {
            border: none;
            border-radius: 10px;
            padding: 0.6rem 1.2rem;
            font-weight: 600;
            color: white;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.9rem;
        }

            .btn-wf:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 15px rgba(0,0,0,0.15);
                color: white;
            }

            .btn-wf.progress {
                background: linear-gradient(135deg, #4facfe, #00f2fe);
            }

            .btn-wf.fixed {
                background: linear-gradient(135deg, #a18cd1, #fbc2eb);
            }

            .btn-wf.qa {
                background: linear-gradient(135deg, #667eea, #764ba2);
            }

            .btn-wf.testing {
                background: linear-gradient(135deg, #2193b0, #6dd5ed);
            }

            .btn-wf.resolve {
                background: linear-gradient(135deg, #11998e, #38ef7d);
            }

            .btn-wf.close-btn {
                background: linear-gradient(135deg, #2c3e50, #4a5568);
            }

            .btn-wf.reopen {
                background: linear-gradient(135deg, #eb3349, #f45c43);
            }

            .btn-wf.hold {
                background: linear-gradient(135deg, #f7971e, #ffd200);
            }

            .btn-wf.edit-btn {
                background: linear-gradient(135deg, #fa709a, #fee140);
            }

        .comment-box {
            background: white;
            padding: 1rem;
            border-radius: 10px;
            margin-bottom: 0.75rem;
            border-left: 4px solid #6366f1;
            box-shadow: 0 2px 5px rgba(0,0,0,0.04);
        }

            .comment-box.internal {
                background: #fef9c3;
                border-left-color: #f59e0b;
            }

            .comment-box.system {
                background: #eef2ff;
                border-left-color: #6366f1;
                font-style: italic;
            }

        .comment-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.9rem;
        }

        .attach-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.6rem;
            background: #f8fafc;
            border-radius: 8px;
            margin-bottom: 0.5rem;
        }

        .attach-icon {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .timeline {
            position: relative;
            padding-left: 2rem;
        }

            .timeline::before {
                content: '';
                position: absolute;
                left: 11px;
                top: 0;
                bottom: 0;
                width: 2px;
                background: linear-gradient(180deg, #6366f1 0%, #e2e8f0 100%);
            }

        .tl-item {
            position: relative;
            padding-bottom: 1rem;
        }

        .tl-dot {
            position: absolute;
            left: -2rem;
            top: 0.2rem;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: white;
            border: 3px solid #6366f1;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.65rem;
            color: #6366f1;
        }

        .tl-content {
            background: #f8fafc;
            padding: 0.75rem;
            border-radius: 8px;
            border-left: 3px solid #6366f1;
        }

        .upload-zone {
            border: 2px dashed #cbd5e0;
            border-radius: 12px;
            padding: 1.5rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s;
        }

            .upload-zone:hover {
                border-color: #667eea;
                background: #eef2ff;
            }

        @@media print {
            .no-print {
                display: none !important;
            }
        }
    </style>
}

<div class="container py-3 pb-5">

    <!-- HERO -->
    <div class="hero">
        <div class="hero-content">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <span class="ticket-num" id="heroNum">Loading...</span>
                    <h3 class="fw-bold mt-2 mb-1" id="heroTitle">Loading...</h3>
                    <div id="heroMeta" class="d-flex gap-2 flex-wrap mt-2"></div>
                </div>
                <div class="d-flex gap-2">
                    <a href="javascript:history.back()" class="btn btn-light btn-sm fw-semibold">
                        <i class="bi bi-arrow-left me-1"></i>Back
                    </a>
                    <button onclick="window.print()" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-printer me-1"></i>Print
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- WORKFLOW BUTTONS -->
    <div class="card-section no-print">
        <div class="card-body-custom">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <strong class="text-muted">⚡ Actions:</strong>
                <div class="d-flex gap-2 flex-wrap" id="workflowBtns"></div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <!-- LEFT -->
        <div class="col-lg-8">
            <!-- Description -->
            <div class="card-section">
                <div class="card-header-custom"><i class="bi bi-file-text me-2"></i>Description</div>
                <div class="card-body-custom">
                    <div class="desc-box" id="descBox">Loading...</div>
                </div>
            </div>

            <!-- Bug Details -->
            <div class="card-section" id="bugSection" style="display:none;">
                <div class="card-header-custom"><i class="bi bi-bug me-2"></i>Bug Details</div>
                <div class="card-body-custom" id="bugBody"></div>
            </div>

            <!-- Comments -->
            <div class="card-section">
                <div class="card-header-custom d-flex justify-content-between">
                    <span><i class="bi bi-chat-dots me-2"></i>Comments</span>
                    <span class="badge bg-primary" id="commentBadge">0</span>
                </div>
                <div class="card-body-custom">
                    <div id="commentList" style="max-height: 500px; overflow-y: auto;"></div>

                    <div class="mt-3 p-3 bg-light rounded no-print">
                        <form id="commentForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" id="commentTicketId" />
                            <textarea name="comment" class="form-control mb-2" rows="3"
                                      placeholder="Write a comment..." required id="commentText"></textarea>
                            <div class="d-flex justify-content-between align-items-center">
                                @if (isDeveloper || isQA || isManager)
                                {
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="internalCheck" />
                                        <label class="form-check-label small" for="internalCheck">
                                            <i class="bi bi-lock me-1"></i>Internal Note
                                        </label>
                                    </div>
                                }
                                else
                                {

                                    <div></div>
                                }
                                <button type="submit" class="btn btn-primary btn-sm" id="commentSubmitBtn">
                                    <i class="bi bi-send me-1"></i>Post
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT SIDEBAR -->
        <div class="col-lg-4">
            <!-- Info -->
            <div class="card-section">
                <div class="card-header-custom"><i class="bi bi-info-circle me-2"></i>Details</div>
                <div class="card-body-custom" id="infoSidebar"></div>
            </div>

            <!-- Assignment -->
            @if (isManager)
            {
                <div class="card-section no-print">
                    <div class="card-header-custom"><i class="bi bi-person-check me-2"></i>Assign</div>
                    <div class="card-body-custom">
                        <form asp-action="Assign" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ticketId" id="assignTicketId" />
                            <select name="assignedTo" class="form-select form-select-sm mb-2" id="assignSelect" required>
                                <option value="">Select Developer...</option>
                            </select>
                            <textarea name="remarks" class="form-control form-control-sm mb-2" rows="2"
                                  placeholder="Notes (optional)"></textarea>
                            <button type="submit" class="btn btn-primary btn-sm w-100">
                                <i class="bi bi-person-check me-1"></i>Assign Ticket
                            </button>
                        </form>
                    </div>
                </div>
            }

            <!-- Attachments -->
            <div class="card-section">
                <div class="card-header-custom d-flex justify-content-between">
                    <span><i class="bi bi-paperclip me-2"></i>Attachments</span>
                    <span class="badge bg-primary" id="attachBadge">0</span>
                </div>
                <div class="card-body-custom">
                    <div id="attachList"></div>

                    <form asp-action="UploadAttachment" method="post" enctype="multipart/form-data"
                          class="mt-3 no-print" id="uploadForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ticketId" id="uploadTicketId" />
                        <label class="upload-zone d-block">
                            <i class="bi bi-cloud-upload display-6 text-primary"></i>
                            <div class="mt-2 fw-semibold small">Click or drag to upload (max 10MB)</div>
                            <input type="file" name="file" class="d-none" id="fileInput" required
                                   onchange="this.form.submit();" />
                        </label>
                    </form>
                </div>
            </div>

            <!-- History -->
            <div class="card-section">
                <div class="card-header-custom"><i class="bi bi-clock-history me-2"></i>Timeline</div>
                <div class="card-body-custom">
                    <div class="timeline" id="historyTimeline" style="max-height: 400px; overflow-y: auto;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- STATUS MODAL -->
<div class="modal fade" id="statusModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px; border: none;">
            <div class="modal-header text-white" id="modalHeader"
                 style="background: linear-gradient(135deg, #667eea, #764ba2); border-radius: 16px 16px 0 0;">
                <h5 class="modal-title fw-bold" id="modalTitle">Change Status</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="statusForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="statusTicketId" />
                <input type="hidden" id="statusNewStatus" />
                <div class="modal-body p-4">
                    <p>Change status to <strong id="statusTargetText"></strong>?</p>
                    <textarea id="statusRemarks" class="form-control" rows="3" placeholder="Remarks (optional)"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="statusSubmitBtn">
                        <i class="bi bi-check-circle me-1"></i>Confirm
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const ticketJson = @Html.Raw(ticketJson);
        const dropdownsJson = @Html.Raw(dropdownsJson);
        const role = '@userRole';
        const uid = @userId;
        const isAdmin = @isAdmin.ToString().ToLower();
        const isManager = @isManager.ToString().ToLower();
        const isQA = @isQA.ToString().ToLower();
        const isDev = @isDeveloper.ToString().ToLower();

        let ticket = null;

        $(document).ready(function() {
            if (ticketJson?.data) {
                ticket = ticketJson.data;
                render(ticket);
                loadDropdowns();
            } else {
                alert('Failed to load ticket');
                history.back();
            }
        });

        function render(t) {
            // Hero
            $('#heroNum').html(`<i class="bi bi-hash"></i>${t.ticketNumber}`);
            $('#heroTitle').text(t.title);
            $('#heroMeta').html(`
                <span class="badge bg-white bg-opacity-25">${t.ticketType}</span>
                <span class="badge bg-white bg-opacity-25">${t.priority}</span>
                <span class="badge bg-white bg-opacity-25">${t.status}</span>
                ${t.isOverdue ? '<span class="badge bg-danger">⚠️ OVERDUE</span>' : ''}
            `);

            // Description
            $('#descBox').text(t.description || 'No description');

            // Bug details
            if (t.ticketType === 'Bug' && (t.stepsToReproduce || t.expectedResult || t.actualResult)) {
                let html = '';
                if (t.stepsToReproduce) html += `<div class="p-3 rounded mb-2" style="background:#fef3c7;border-left:3px solid #f59e0b;"><strong>Steps:</strong><pre class="mb-0 mt-1 small">${esc(t.stepsToReproduce)}</pre></div>`;
                if (t.expectedResult) html += `<div class="p-3 rounded mb-2" style="background:#d1fae5;border-left:3px solid #10b981;"><strong>Expected:</strong><p class="mb-0 mt-1 small">${esc(t.expectedResult)}</p></div>`;
                if (t.actualResult) html += `<div class="p-3 rounded mb-2" style="background:#fee2e2;border-left:3px solid #ef4444;"><strong>Actual:</strong><p class="mb-0 mt-1 small">${esc(t.actualResult)}</p></div>`;
                if (t.environment) html += `<div class="p-3 rounded" style="background:#dbeafe;border-left:3px solid #3b82f6;"><strong>Environment:</strong> ${esc(t.environment)}</div>`;
                $('#bugBody').html(html);
                $('#bugSection').show();
            }

            // Sidebar
            renderSidebar(t);

            // Workflow buttons
            renderButtons(t);

            // Comments
            renderComments(t.comments || []);

            // Attachments
            renderAttachments(t.attachments || []);

            // History
            renderHistory(t.history || []);

            // Set form IDs
            $('#commentTicketId, #assignTicketId, #uploadTicketId').val(t.ticketId);
        }

        function renderSidebar(t) {
            const pColor = { Critical: 'danger', High: 'warning', Medium: 'info', Low: 'success' };
            $('#infoSidebar').html(`
                <div class="meta-item"><div class="meta-label">Status</div><div class="meta-value"><span class="badge bg-primary">${t.status}</span></div></div>
                <div class="meta-item"><div class="meta-label">Priority</div><div class="meta-value"><span class="badge bg-${pColor[t.priority] || 'secondary'}">${t.priority}</span></div></div>
                <div class="meta-item"><div class="meta-label">Created By</div><div class="meta-value">${esc(t.createdByName || 'N/A')}</div><small class="text-muted">${fmtDate(t.createdDate)}</small></div>
                <div class="meta-item"><div class="meta-label">Assigned To</div><div class="meta-value">${t.assignedToName ? '<i class="bi bi-person-circle"></i> ' + esc(t.assignedToName) : '<span class="text-muted">Unassigned</span>'}</div></div>
                ${t.dueDate ? `<div class="meta-item"><div class="meta-label">Due Date</div><div class="meta-value ${t.isOverdue ? 'text-danger' : ''}">${fmtDate(t.dueDate)} ${t.isOverdue ? '<span class="badge bg-danger ms-1">Overdue</span>' : ''}</div></div>` : ''}
                <div class="meta-item"><div class="meta-label">Updated</div><div class="meta-value">${fmtDate(t.updatedDate)}</div></div>
            `);
        }

        function renderButtons(t) {
            const btns = [];
            const s = t.status;
            const myTicket = t.assignedTo === uid;
            const created = t.createdBy === uid;

            // Edit
            if ((isManager || created) && s !== 'Closed' && s !== 'Cancelled')
                btns.push(`<a href="/Ticket/Edit/${t.ticketId}" class="btn-wf edit-btn"><i class="bi bi-pencil"></i>Edit</a>`);

            // Start Work (Developer)
            if ((isDev && myTicket) && ['Assigned', 'OnHold', 'Reopened'].includes(s))
                btns.push(`<button class="btn-wf progress" onclick="openStatusModal(${t.ticketId},'InProgress','Start Working')"><i class="bi bi-play-circle"></i>Start</button>`);

            // Mark Fixed (Developer)
            if ((isDev && myTicket) && s === 'InProgress')
                btns.push(`<button class="btn-wf fixed" onclick="openStatusModal(${t.ticketId},'FixedByDev','Mark Fixed')"><i class="bi bi-check2-square"></i>Fixed</button>`);

            // Send to QA
            if ((isDev || isAdmin) && s === 'FixedByDev')
                btns.push(`<button class="btn-wf qa" onclick="openStatusModal(${t.ticketId},'ReadyForQA','Send to QA')"><i class="bi bi-send"></i>Send to QA</button>`);

            // Start Testing (QA)
            if ((isQA) && s === 'ReadyForQA')
                btns.push(`<button class="btn-wf testing" onclick="openStatusModal(${t.ticketId},'InTesting','Start Testing')"><i class="bi bi-clipboard-check"></i>Test</button>`);

            // Resolve (QA)
            if ((isQA) && ['InTesting', 'ReadyForQA'].includes(s))
                btns.push(`<button class="btn-wf resolve" onclick="openStatusModal(${t.ticketId},'Resolved','Resolve')"><i class="bi bi-check-circle"></i>Resolve</button>`);

            // Close (QA/Manager)
            if ((isQA || isManager) && s === 'Resolved')
                btns.push(`<button class="btn-wf close-btn" onclick="openStatusModal(${t.ticketId},'Closed','Close')"><i class="bi bi-x-circle"></i>Close</button>`);

            // Reopen
            if ((isQA || isManager || created) && ['Closed', 'Resolved'].includes(s))
                btns.push(`<button class="btn-wf reopen" onclick="openStatusModal(${t.ticketId},'Reopened','Reopen')"><i class="bi bi-arrow-counterclockwise"></i>Reopen</button>`);

            // Hold
            if ((myTicket || isManager) && ['InProgress', 'Assigned'].includes(s))
                btns.push(`<button class="btn-wf hold" onclick="openStatusModal(${t.ticketId},'OnHold','Put On Hold')"><i class="bi bi-pause-circle"></i>Hold</button>`);

            $('#workflowBtns').html(btns.length ? btns.join('') : '<small class="text-muted">No actions available</small>');
        }

        function renderComments(comments) {
            $('#commentBadge').text(comments.length);
            if (!comments.length) { $('#commentList').html('<div class="text-center text-muted py-3"><i class="bi bi-chat-square-dots fs-2 d-block opacity-50"></i>No comments</div>'); return; }

            const html = comments.map(c => `
                <div class="comment-box ${c.isInternal ? 'internal' : ''} ${c.isSystemGenerated ? 'system' : ''}">
                    <div class="d-flex gap-2">
                        <div class="comment-avatar">${(c.userName || 'U').charAt(0).toUpperCase()}</div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between">
                                <div><strong class="small">${esc(c.userName || 'User')}</strong>
                                    ${c.isInternal ? '<span class="badge bg-warning text-dark ms-1" style="font-size:0.65rem">Internal</span>' : ''}
                                </div>
                                <small class="text-muted">${fmtDateTime(c.createdDate)}</small>
                            </div>
                            <div class="mt-1 small">${esc(c.comment)}</div>
                        </div>
                    </div>
                </div>
            `).join('');
            $('#commentList').html(html);
        }

        function renderAttachments(attachments) {
            $('#attachBadge').text(attachments.length);
            if (!attachments.length) { $('#attachList').html('<small class="text-muted">No files</small>'); return; }

            const html = attachments.map(a => `
                <div class="attach-item">
                    <div class="attach-icon"><i class="bi bi-file-earmark"></i></div>
                    <div class="flex-grow-1 overflow-hidden">
                        <div class="text-truncate fw-semibold small">${esc(a.fileName)}</div>
                        <small class="text-muted">${fmtSize(a.fileSize)} • ${esc(a.uploadedByName || '')}</small>
                    </div>
                    <a href="/Ticket/DownloadAttachment/${a.attachmentId}" class="btn btn-sm btn-outline-primary"><i class="bi bi-download"></i></a>
                </div>
            `).join('');
            $('#attachList').html(html);
        }

        function renderHistory(history) {
            if (!history.length) { $('#historyTimeline').html('<small class="text-muted">No activity</small>'); return; }

            const html = history.map(h => {
                let change = '';
                if (h.oldValue && h.newValue) change = `<small><span class="badge bg-light text-dark">${esc(h.oldValue)}</span> → <span class="badge bg-primary">${esc(h.newValue)}</span></small>`;

                return `
                    <div class="tl-item">
                        <div class="tl-dot"><i class="bi bi-circle-fill"></i></div>
                        <div class="tl-content">
                            <div class="d-flex justify-content-between"><strong class="small">${esc(h.changedByName || 'System')}</strong><small class="text-muted">${fmtDate(h.changeDate)}</small></div>
                            <small class="text-muted">${h.changeType}${h.fieldName ? ': ' + h.fieldName : ''}</small>
                            ${change}
                            ${h.remarks ? `<div class="small mt-1 text-muted"><i>"${esc(h.remarks)}"</i></div>` : ''}
                        </div>
                    </div>
                `;
            }).join('');
            $('#historyTimeline').html(html);
        }

        // STATUS MODAL
        function openStatusModal(ticketId, status, title) {
            $('#statusTicketId').val(ticketId);
            $('#statusNewStatus').val(status);
            $('#statusTargetText').text(status);
            $('#modalTitle').text(title);
            $('#statusRemarks').val('');
            new bootstrap.Modal(document.getElementById('statusModal')).show();
        }

        $('#statusForm').on('submit', async function(e) {
            e.preventDefault();
            const btn = $('#statusSubmitBtn');
            btn.prop('disabled', true).html('<i class="bi bi-hourglass-split me-1"></i>...');

            const token = $('input[name="__RequestVerificationToken"]').first().val();
            const fd = new FormData();
            fd.append('ticketId', $('#statusTicketId').val());
            fd.append('newStatus', $('#statusNewStatus').val());
            fd.append('remarks', $('#statusRemarks').val());
            fd.append('__RequestVerificationToken', token);

            try {
                const res = await fetch('/Ticket/ChangeStatus', {
                    method: 'POST', body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const result = await res.json();
                if (result.success) {
                    toast('success', result.message);
                    setTimeout(() => location.reload(), 1000);
                } else {
                    toast('error', result.message || 'Failed');
                    btn.prop('disabled', false).html('<i class="bi bi-check-circle me-1"></i>Confirm');
                }
            } catch (err) {
                toast('error', 'Error occurred');
                btn.prop('disabled', false);
            }
        });

        // COMMENT FORM
        $('#commentForm').on('submit', async function(e) {
            e.preventDefault();
            const btn = $('#commentSubmitBtn');
            btn.prop('disabled', true);

            const token = $('input[name="__RequestVerificationToken"]').first().val();
            const fd = new FormData();
            fd.append('ticketId', ticket.ticketId);
            fd.append('comment', $('#commentText').val());
            fd.append('isInternal', $('#internalCheck').is(':checked'));
            fd.append('__RequestVerificationToken', token);

            try {
                const res = await fetch('/Ticket/AddComment', {
                    method: 'POST', body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (res.ok) location.reload();
                else { toast('error', 'Failed'); btn.prop('disabled', false); }
            } catch {
                toast('error', 'Error');
                btn.prop('disabled', false);
            }
        });

        // DROPDOWNS
        function loadDropdowns() {
            if (dropdownsJson?.data?.developers) {
                const sel = $('#assignSelect');
                dropdownsJson.data.developers.forEach(d => {
                    sel.append(`<option value="${d.userId}">${d.fullName} (${d.role || ''})</option>`);
                });
            }
        }

        // HELPERS
        function esc(t) { if (!t) return ''; const d = document.createElement('div'); d.textContent = t; return d.innerHTML; }
        function fmtDate(d) { if (!d) return ''; return new Date(d).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }); }
        function fmtDateTime(d) { if (!d) return ''; return new Date(d).toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }); }
        function fmtSize(b) { if (!b) return '0 B'; if (b < 1024) return b + ' B'; if (b < 1048576) return (b/1024).toFixed(1) + ' KB'; return (b/1048576).toFixed(1) + ' MB'; }

        function toast(type, msg) {
            const bg = type === 'success' ? 'bg-success' : 'bg-danger';
            const t = $(`<div class="toast align-items-center text-white ${bg} border-0 position-fixed top-0 end-0 m-3 show" style="z-index:10000"><div class="d-flex"><div class="toast-body"><i class="bi bi-${type === 'success' ? 'check-circle' : 'x-circle'} me-2"></i>${msg}</div><button class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>`);
            $('body').append(t);
            setTimeout(() => t.fadeOut(() => t.remove()), 3500);
        }
    </script>
}