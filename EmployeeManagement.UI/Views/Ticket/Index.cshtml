@{
    ViewData["Title"] = "Ticket Dashboard";
    var userRole = ViewBag.UserRole as string ?? "Employee";
    var userName = ViewBag.UserName as string ?? "User";
    var dashboardJson = ViewBag.DashboardJson as string ?? "{}";
}

@section Styles {
    <style>
        body {
            background: #f0f2f5;
        }

        .hero-banner {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 2.5rem;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
            margin-bottom: 1.5rem;
            position: relative;
            overflow: hidden;
        }

            .hero-banner::before {
                content: '';
                position: absolute;
                top: -50%;
                right: -10%;
                width: 400px;
                height: 400px;
                background: rgba(255,255,255,0.1);
                border-radius: 50%;
            }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .role-badge {
            background: rgba(255,255,255,0.25);
            padding: 0.3rem 0.85rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.3);
        }

        .stat-card {
            background: white;
            border-radius: 14px;
            padding: 1.5rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            transition: all 0.3s;
            border: none;
            position: relative;
            overflow: hidden;
            height: 100%;
        }

            .stat-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 12px 25px rgba(0,0,0,0.12);
            }

            .stat-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 5px;
                height: 100%;
            }

            .stat-card.blue::before {
                background: linear-gradient(180deg, #4facfe, #00f2fe);
            }

            .stat-card.orange::before {
                background: linear-gradient(180deg, #f7971e, #ffd200);
            }

            .stat-card.purple::before {
                background: linear-gradient(180deg, #a18cd1, #fbc2eb);
            }

            .stat-card.green::before {
                background: linear-gradient(180deg, #11998e, #38ef7d);
            }

            .stat-card.red::before {
                background: linear-gradient(180deg, #eb3349, #f45c43);
            }

            .stat-card.teal::before {
                background: linear-gradient(180deg, #2193b0, #6dd5ed);
            }

            .stat-card.darkc::before {
                background: linear-gradient(180deg, #111827, #4b5563);
            }

            .stat-card.pink::before {
                background: linear-gradient(180deg, #ec4899, #f9a8d4);
            }

        .stat-icon {
            width: 56px;
            height: 56px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            color: white;
            flex-shrink: 0;
        }

        .stat-value {
            font-size: 2.2rem;
            font-weight: 800;
            color: #1e293b;
            line-height: 1;
            margin: 0;
        }

        .stat-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #64748b;
            font-weight: 600;
            margin-top: 0.5rem;
        }

        .quick-action {
            background: white;
            border-radius: 14px;
            padding: 1.5rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            text-align: center;
            text-decoration: none;
            color: inherit;
            transition: all 0.3s;
            border: 2px solid transparent;
            display: block;
            height: 100%;
        }

            .quick-action:hover {
                transform: translateY(-3px);
                border-color: #667eea;
                color: inherit;
                text-decoration: none;
            }

        .quick-action-icon {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1rem;
            font-size: 1.8rem;
            color: white;
        }

        .chart-card {
            background: white;
            border-radius: 14px;
            padding: 1.5rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            height: 100%;
            min-height: 360px;
        }

        .activity-feed {
            background: white;
            border-radius: 14px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            overflow: hidden;
            height: 100%;
            min-height: 360px;
        }

        .activity-item {
            padding: 1rem 1.25rem;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            align-items: center;
            gap: 0.85rem;
            transition: background 0.2s;
            text-decoration: none;
            color: inherit;
        }

            .activity-item:hover {
                background: linear-gradient(90deg, #f8fafc 0%, transparent 100%);
                color: inherit;
                text-decoration: none;
            }

            .activity-item:last-child {
                border-bottom: none;
            }

        .activity-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 0.95rem;
            flex-shrink: 0;
        }

        .priority-dot {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            margin-right: 0.5rem;
        }

        .priority-critical {
            background: #dc3545;
        }

        .priority-high {
            background: #fd7e14;
        }

        .priority-medium {
            background: #ffc107;
        }

        .priority-low {
            background: #28a745;
        }

        .dynamic-status-card {
            background: white;
            border-radius: 14px;
            padding: 1rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            border-left: 5px solid #667eea;
            height: 100%;
            text-decoration: none;
            display: block;
            color: inherit;
            transition: all .25s;
        }

            .dynamic-status-card:hover {
                transform: translateY(-3px);
                color: inherit;
                text-decoration: none;
            }

        .dynamic-count {
            font-size: 1.6rem;
            font-weight: 800;
            color: #1e293b;
        }

        .empty-box {
            text-align: center;
            color: #94a3b8;
            padding: 2rem 1rem;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-in {
            animation: fadeInUp 0.5s ease forwards;
        }
    </style>
}

<div class="container-fluid py-3 pb-5">

    <div class="hero-banner fade-in">
        <div class="row align-items-center position-relative hero-content">
            <div class="col-md-8">
                <h2 class="fw-bold mb-1">
                    <i class="bi bi-ticket-detailed me-2"></i>Ticket Dashboard
                </h2>
                <p class="opacity-90 mb-3">
                    Welcome back, <strong>@userName</strong>!
                    <span class="role-badge ms-2">
                        <i class="bi bi-shield-check me-1"></i>@userRole
                    </span>
                </p>

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-action="Create" class="btn btn-light fw-bold">
                        <i class="bi bi-plus-circle me-1"></i>Create Ticket
                    </a>
                    <a asp-action="MyTickets" class="btn btn-outline-light fw-semibold">
                        <i class="bi bi-person-badge me-1"></i>My Tickets
                    </a>
                    <a asp-action="List" class="btn btn-outline-light fw-semibold">
                        <i class="bi bi-list-ul me-1"></i>All Tickets
                    </a>
                </div>
            </div>

            <div class="col-md-4 text-end d-none d-md-block">
                <i class="bi bi-clipboard-data" style="font-size: 6rem; opacity: 0.15;"></i>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-2 col-sm-4 col-6">
            <a href="@Url.Action("List")" class="text-decoration-none">
                <div class="stat-card blue fade-in">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="stat-value" id="totalCount">0</h3>
                            <div class="stat-label">Total</div>
                        </div>
                        <div class="stat-icon" style="background: linear-gradient(135deg, #4facfe, #00f2fe);">
                            <i class="bi bi-ticket"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-2 col-sm-4 col-6">
            <a href="@Url.Action("List", new { status = "New" })" class="text-decoration-none">
                <div class="stat-card orange fade-in">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="stat-value" id="newCount">0</h3>
                            <div class="stat-label">New</div>
                        </div>
                        <div class="stat-icon" style="background: linear-gradient(135deg, #f7971e, #ffd200);">
                            <i class="bi bi-plus-circle"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-2 col-sm-4 col-6">
            <a href="@Url.Action("List", new { status = "InProgress" })" class="text-decoration-none">
                <div class="stat-card purple fade-in">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="stat-value" id="progressCount">0</h3>
                            <div class="stat-label">In Progress</div>
                        </div>
                        <div class="stat-icon" style="background: linear-gradient(135deg, #a18cd1, #fbc2eb);">
                            <i class="bi bi-arrow-repeat"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-2 col-sm-4 col-6">
            <a href="@Url.Action("List", new { status = "Resolved" })" class="text-decoration-none">
                <div class="stat-card green fade-in">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="stat-value" id="resolvedCount">0</h3>
                            <div class="stat-label">Resolved</div>
                        </div>
                        <div class="stat-icon" style="background: linear-gradient(135deg, #11998e, #38ef7d);">
                            <i class="bi bi-check-circle"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-2 col-sm-4 col-6">
            <a href="@Url.Action("List", new { priority = "Critical" })" class="text-decoration-none">
                <div class="stat-card red fade-in">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="stat-value" id="criticalCount">0</h3>
                            <div class="stat-label">Critical</div>
                        </div>
                        <div class="stat-icon" style="background: linear-gradient(135deg, #eb3349, #f45c43);">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-2 col-sm-4 col-6">
            <a href="@Url.Action("List")" class="text-decoration-none">
                <div class="stat-card teal fade-in">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="stat-value" id="overdueCount">0</h3>
                            <div class="stat-label">Overdue</div>
                        </div>
                        <div class="stat-icon" style="background: linear-gradient(135deg, #2193b0, #6dd5ed);">
                            <i class="bi bi-clock-history"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4" id="dynamicStatusCards"></div>

    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <a asp-action="Create" class="quick-action">
                <div class="quick-action-icon" style="background: linear-gradient(135deg, #11998e, #38ef7d);">
                    <i class="bi bi-plus-lg"></i>
                </div>
                <h6 class="fw-bold mb-0">Create Ticket</h6>
                <small class="text-muted">Report a new issue</small>
            </a>
        </div>

        <div class="col-md-3 col-sm-6">
            <a asp-action="MyTickets" class="quick-action">
                <div class="quick-action-icon" style="background: linear-gradient(135deg, #4facfe, #00f2fe);">
                    <i class="bi bi-person-badge"></i>
                </div>
                <h6 class="fw-bold mb-0">My Tickets</h6>
                <small class="text-muted">Tickets I created or assigned</small>
            </a>
        </div>

        @if (userRole != "Employee")
        {
            <div class="col-md-3 col-sm-6">
                <a asp-action="List" asp-route-status="New" class="quick-action">
                    <div class="quick-action-icon" style="background: linear-gradient(135deg, #f7971e, #ffd200);">
                        <i class="bi bi-inbox"></i>
                    </div>
                    <h6 class="fw-bold mb-0">Pending Queue</h6>
                    <small class="text-muted">Awaiting action</small>
                </a>
            </div>
        }

        <div class="col-md-3 col-sm-6">
            <a asp-action="List" class="quick-action">
                <div class="quick-action-icon" style="background: linear-gradient(135deg, #a18cd1, #fbc2eb);">
                    <i class="bi bi-list-ul"></i>
                </div>
                <h6 class="fw-bold mb-0">All Tickets</h6>
                <small class="text-muted">Browse everything</small>
            </a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-4">
            <div class="chart-card">
                <h6 class="fw-bold mb-3">
                    <i class="bi bi-pie-chart-fill text-primary me-2"></i>
                    Priority Distribution
                </h6>
                <canvas id="priorityChart" style="max-height: 280px;"></canvas>
                <div id="priorityEmpty" class="empty-box d-none">
                    <i class="bi bi-pie-chart fs-1 d-block opacity-50"></i>
                    No priority data
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="chart-card">
                <h6 class="fw-bold mb-3">
                    <i class="bi bi-bar-chart-fill text-success me-2"></i>
                    Ticket Types
                </h6>
                <canvas id="typeChart" style="max-height: 280px;"></canvas>
                <div id="typeEmpty" class="empty-box d-none">
                    <i class="bi bi-bar-chart fs-1 d-block opacity-50"></i>
                    No type data
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="activity-feed">
                <div class="p-3 border-bottom">
                    <h6 class="fw-bold mb-0">
                        <i class="bi bi-activity text-info me-2"></i>
                        Recent Activity
                    </h6>
                </div>
                <div id="recentActivities" style="max-height: 320px; overflow-y: auto;">
                    <div class="text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm"></div>
                        <p class="small mt-2 mb-0">Loading...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        let dashboardData = {};

        try {
            dashboardData = @Html.Raw(dashboardJson);
        } catch (e) {
            dashboardData = {};
            console.error('Failed to parse dashboard json', e);
        }

        let priorityChartInstance = null;
        let typeChartInstance = null;

        $(document).ready(function () {
            try {
                if (dashboardData && dashboardData.data) {
                    renderDashboard(dashboardData.data);
                } else if (dashboardData && dashboardData.status === false) {
                    showEmptyState(dashboardData.message || 'No data available');
                } else {
                    showEmptyState('No data available');
                }
            } catch (err) {
                console.error('Dashboard render error:', err);
                showEmptyState('Failed to render dashboard');
            }
        });

        function renderDashboard(data) {
            const stats = data.stats || data || {};

            animate('#totalCount', stats.totalTickets || 0);
            animate('#newCount', stats.newTickets || 0);
            animate('#progressCount', stats.inProgressTickets || 0);
            animate('#resolvedCount', stats.resolvedTickets || 0);
            animate('#criticalCount', stats.criticalTickets || 0);
            animate('#overdueCount', stats.overdueTickets || 0);

            renderDynamicStatusCards(data);
            renderPriorityChart(data.priorityDistribution || []);
            renderTypeChart(data.typeDistribution || []);
            renderActivities(data.recentActivities || []);
        }

        function renderDynamicStatusCards(data) {
            const container = $('#dynamicStatusCards');
            container.empty();

            const possible = [
                { label: 'Assigned', count: data.assignedTickets, status: 'Assigned', color: '#6366f1', icon: 'bi-person-check' },
                { label: 'Blocked', count: data.blockedTickets, status: 'Blocked', color: '#ef4444', icon: 'bi-slash-circle' },
                { label: 'Reopened', count: data.reopenedTickets, status: 'Reopened', color: '#f97316', icon: 'bi-arrow-counterclockwise' },
                { label: 'Closed', count: data.closedTickets, status: 'Closed', color: '#111827', icon: 'bi-x-circle' },
                { label: 'High Priority', count: data.highPriorityTickets, priority: 'High', color: '#f97316', icon: 'bi-arrow-up-circle' }
            ];

            possible
                .filter(x => Number(x.count || 0) > 0)
                .forEach(x => {
                    const url = x.priority
                        ? `/Ticket/List?priority=${encodeURIComponent(x.priority)}`
                        : `/Ticket/List?status=${encodeURIComponent(x.status)}`;

                    container.append(`
                        <div class="col-md-2 col-sm-4 col-6">
                            <a href="${url}" class="dynamic-status-card" style="border-left-color:${x.color}">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="dynamic-count">${x.count || 0}</div>
                                        <div class="stat-label">${escapeHtml(x.label)}</div>
                                    </div>
                                    <i class="bi ${x.icon}" style="font-size:1.8rem;color:${x.color}"></i>
                                </div>
                            </a>
                        </div>
                    `);
                });
        }

        function showEmptyState(message) {
            $('.stat-value').text('0');
            $('#priorityChart, #typeChart').hide();
            $('#priorityEmpty, #typeEmpty').removeClass('d-none');

            $('#recentActivities').html(`
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-inbox d-block fs-2 mb-2 opacity-50"></i>
                    <small>${escapeHtml(message)}</small>
                    <br>
                    <a href="/Ticket/Create" class="btn btn-sm btn-primary mt-2">
                        <i class="bi bi-plus-circle"></i> Create First Ticket
                    </a>
                </div>
            `);
        }

        function animate(selector, target) {
            const $el = $(selector);
            if (!$el.length) return;

            target = Number(target || 0);

            $({ value: 0 }).animate({ value: target }, {
                duration: 800,
                step: function () {
                    $el.text(Math.round(this.value));
                },
                complete: function () {
                    $el.text(target);
                }
            });
        }

        function renderPriorityChart(data) {
            const ctx = document.getElementById('priorityChart');

            if (!ctx || !Array.isArray(data) || data.length === 0) {
                $('#priorityChart').hide();
                $('#priorityEmpty').removeClass('d-none');
                return;
            }

            $('#priorityChart').show();
            $('#priorityEmpty').addClass('d-none');

            if (priorityChartInstance) priorityChartInstance.destroy();

            priorityChartInstance = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: data.map(d => d.priority || d.name || 'Unknown'),
                    datasets: [{
                        data: data.map(d => d.count || d.total || 0),
                        backgroundColor: data.map(d => getPriorityColor(d.priority || d.name)),
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '62%',
                    plugins: {
                        legend: {
                            position: 'bottom'
                        }
                    }
                }
            });
        }

        function renderTypeChart(data) {
            const ctx = document.getElementById('typeChart');

            if (!ctx || !Array.isArray(data) || data.length === 0) {
                $('#typeChart').hide();
                $('#typeEmpty').removeClass('d-none');
                return;
            }

            $('#typeChart').show();
            $('#typeEmpty').addClass('d-none');

            if (typeChartInstance) typeChartInstance.destroy();

            typeChartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: data.map(d => d.ticketType || d.type || d.name || 'Unknown'),
                    datasets: [{
                        label: 'Count',
                        data: data.map(d => d.count || d.total || 0),
                        backgroundColor: 'rgba(102, 126, 234, 0.8)',
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1 }
                        }
                    }
                }
            });
        }

        function renderActivities(activities) {
            const container = $('#recentActivities');
            container.empty();

            if (!Array.isArray(activities) || activities.length === 0) {
                container.html(`
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-inbox d-block fs-2 mb-2 opacity-50"></i>
                        <small>No recent activity</small>
                    </div>
                `);
                return;
            }

            const colors = ['#667eea', '#f5576c', '#11998e', '#fa709a', '#a18cd1'];

            activities.forEach((a, i) => {
                const initials = (a.createdByName || a.assignedToName || 'U').charAt(0).toUpperCase();
                const color = colors[i % colors.length];
                const priorityClass = `priority-${normalizeKey(a.priority || 'low')}`;

                container.append(`
                    <a href="/Ticket/Details/${a.ticketId}" class="activity-item">
                        <div class="activity-avatar" style="background:${color};">${escapeHtml(initials)}</div>
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="d-flex justify-content-between gap-2">
                                <strong class="small text-truncate">${escapeHtml(a.title || 'Untitled')}</strong>
                                <span class="badge ${getStatusBadgeClass(a.status)} small flex-shrink-0">${escapeHtml(displayStatus(a.status || ''))}</span>
                            </div>
                            <small class="text-muted">
                                <span class="priority-dot ${priorityClass}"></span>
                                ${escapeHtml(a.ticketNumber || '')} • ${formatRelative(a.updatedDate || a.createdDate)}
                            </small>
                        </div>
                    </a>
                `);
            });
        }

        function getPriorityColor(priority) {
            const p = normalizeKey(priority);
            if (p.includes('critical')) return '#dc3545';
            if (p.includes('high')) return '#fd7e14';
            if (p.includes('medium')) return '#ffc107';
            if (p.includes('low')) return '#28a745';
            return '#667eea';
        }

        function getStatusBadgeClass(status) {
            const s = normalizeKey(status);
            if (s.includes('new')) return 'bg-info';
            if (s.includes('assigned')) return 'bg-primary';
            if (s.includes('progress')) return 'bg-warning text-dark';
            if (s.includes('testing') || s.includes('qa')) return 'bg-secondary';
            if (s.includes('resolved')) return 'bg-success';
            if (s.includes('closed')) return 'bg-dark';
            if (s.includes('reopen')) return 'bg-danger';
            if (s.includes('hold')) return 'bg-light text-dark';
            if (s.includes('cancel')) return 'bg-danger';
            return 'bg-primary';
        }

        function displayStatus(status) {
            return (status || '')
                .toString()
                .replaceAll('_', ' ')
                .replace('InProgress', 'In Progress')
                .replace('OnHold', 'On Hold')
                .replace('FixedByDev', 'Fixed By Dev')
                .replace('ReadyForQA', 'Ready For QA')
                .replace('InTesting', 'In Testing');
        }

        function normalizeKey(value) {
            return (value || '').toString().toLowerCase().replaceAll(' ', '').replaceAll('_', '');
        }

        function formatRelative(d) {
            if (!d || d === '0001-01-01T00:00:00') return '';

            const date = new Date(d);
            if (isNaN(date)) return '';

            const diff = (new Date() - date) / 1000;

            if (diff >= 0 && diff < 60) return 'just now';
            if (diff >= 0 && diff < 3600) return Math.floor(diff / 60) + 'm ago';
            if (diff >= 0 && diff < 86400) return Math.floor(diff / 3600) + 'h ago';

            return date.toLocaleDateString('en-IN', { day: 'numeric', month: 'short' });
        }

        function escapeHtml(text) {
            if (text === null || text === undefined) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    </script>
}