@{
    ViewData["Title"] = "All Tickets";
    var userRole = ViewBag.UserRole as string ?? "Employee";
    var ticketsJson = ViewBag.TicketsJson as string ?? "{}";
    var canBulk = userRole == "Admin" || userRole == "Manager";
}

@section Styles {
    <style>
        body {
            background: #f0f2f5;
        }

        .list-hero {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 1.75rem 2rem;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
            margin-bottom: 1.5rem;
        }

        .filter-card {
            background: white;
            border-radius: 14px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            padding: 1.25rem;
            margin-bottom: 1.25rem;
        }

        .data-card {
            background: white;
            border-radius: 14px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            overflow: hidden;
        }

        .ticket-row:hover {
            background: linear-gradient(90deg, #f8fafc 0%, transparent 100%);
        }

        .ticket-row.selected {
            background: #eef2ff;
        }

        .ticket-num {
            font-family: monospace;
            background: #f1f5f9;
            padding: 0.25rem 0.5rem;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 600;
            color: #475569;
        }

        .status-badge {
            padding: 0.35rem 0.75rem;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .status-new {
            background: #dbeafe;
            color: #1e40af;
        }

        .status-assigned {
            background: #e0e7ff;
            color: #4338ca;
        }

        .status-inprogress {
            background: #fef3c7;
            color: #92400e;
        }

        .status-onhold {
            background: #f1f5f9;
            color: #475569;
        }

        .status-fixedbydev {
            background: #ede9fe;
            color: #6d28d9;
        }

        .status-readyforqa {
            background: #dbeafe;
            color: #1e3a8a;
        }

        .status-intesting {
            background: #ccfbf1;
            color: #115e59;
        }

        .status-resolved {
            background: #d1fae5;
            color: #065f46;
        }

        .status-reopened {
            background: #fee2e2;
            color: #991b1b;
        }

        .status-closed {
            background: #f3f4f6;
            color: #1f2937;
        }

        .priority-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            padding: 0.25rem 0.6rem;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 700;
        }

        .priority-critical {
            background: #fee2e2;
            color: #991b1b;
        }

        .priority-high {
            background: #fed7aa;
            color: #9a3412;
        }

        .priority-medium {
            background: #fef3c7;
            color: #92400e;
        }

        .priority-low {
            background: #d1fae5;
            color: #065f46;
        }

        .bulk-bar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 12px;
            padding: 0.75rem 1.25rem;
            margin-bottom: 1rem;
            display: none;
            animation: slideDown 0.3s ease;
        }

            .bulk-bar.show {
                display: flex;
            }

        @@keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .overdue-tag {
            background: #ef4444;
            color: white;
            font-size: 0.65rem;
            padding: 0.15rem 0.4rem;
            border-radius: 4px;
            margin-left: 0.5rem;
            font-weight: 700;
        }
    </style>
}

<div class="container-fluid py-3 pb-5">

    <!-- HERO -->
    <div class="list-hero">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h3 class="fw-bold mb-1">
                    <i class="bi bi-list-ul me-2"></i>All Tickets
                </h3>
                <p class="mb-0 opacity-90">Manage and track all tickets</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Create" class="btn btn-light fw-bold">
                    <i class="bi bi-plus-circle me-1"></i>New Ticket
                </a>
                <a asp-action="Index" class="btn btn-outline-light">
                    <i class="bi bi-grid me-1"></i>Dashboard
                </a>
            </div>
        </div>
    </div>

    <!-- FILTERS -->
    <div class="filter-card">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-bold">Search</label>
                <input type="text" name="searchTerm" value="@ViewBag.FilterSearch"
                       class="form-control" placeholder="Title, ticket #..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">Status</label>
                <select name="status" class="form-select">
                    <option value="">All Status</option>
                    @foreach (var s in new[] { "New", "Assigned", "InProgress", "OnHold", "ReadyForQA", "InTesting", "Resolved", "Closed" })
                    {
                        <option value="@s" selected="@(ViewBag.FilterStatus == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">Priority</label>
                <select name="priority" class="form-select">
                    <option value="">All Priority</option>
                    @foreach (var p in new[] { "Critical", "High", "Medium", "Low" })
                    {
                        <option value="@p" selected="@(ViewBag.FilterPriority == p)">@p</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">Type</label>
                <select name="ticketType" class="form-select">
                    <option value="">All Types</option>
                    @foreach (var t in new[] { "Bug", "Feature", "Task", "Improvement", "Support" })
                    {
                        <option value="@t" selected="@(ViewBag.FilterType == t)">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bi bi-search me-1"></i>Filter
                </button>
                <a asp-action="List" class="btn btn-outline-secondary" title="Reset">
                    <i class="bi bi-arrow-clockwise"></i>
                </a>
            </div>
        </form>
    </div>

    @if (canBulk)
    {
        <div class="bulk-bar" id="bulkBar">
            <div class="d-flex align-items-center gap-2 w-100">
                <i class="bi bi-check-square fs-4"></i>
                <strong><span id="selectedCount">0</span> selected</strong>
                <div class="ms-auto d-flex gap-2 flex-wrap">
                    <button class="btn btn-light btn-sm" onclick="clearSelection()">Clear</button>
                    <button class="btn btn-warning btn-sm" onclick="bulkAssign()">
                        <i class="bi bi-person-check me-1"></i>Assign
                    </button>
                    <button class="btn btn-success btn-sm" onclick="bulkStatusChange()">
                        <i class="bi bi-arrow-repeat me-1"></i>Change Status
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- TABLE -->
    <div class="data-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background: #f8fafc;">
                        <tr>
                            @if (canBulk)
                            {
                                <th style="width:40px;"><input type="checkbox" class="form-check-input" onchange="toggleAll(this)" /></th>
                            }
                            <th>Ticket #</th>
                            <th>Title</th>
                            <th>Type</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Assigned To</th>
                            <th>Created</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <tr>
                            <td colspan="9" class="text-center py-5">
                                <div class="spinner-border text-primary"></div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
            <small class="text-muted">Showing <strong id="totalCount">0</strong> tickets</small>
            <nav id="pagination"></nav>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const ticketsData = @Html.Raw(ticketsJson);
        const canBulk = @canBulk.ToString().ToLower();
        let selected = new Set();

        $(document).ready(function() {
            if (ticketsData?.data?.tickets) {
                renderTickets(ticketsData.data.tickets);
                $('#totalCount').text(ticketsData.data.totalRecords || 0);
                renderPagination(ticketsData.data);
            } else {
                showEmpty();
            }
        });

        function renderTickets(tickets) {
            const tbody = $('#tableBody');
            tbody.empty();

            if (!tickets.length) { showEmpty(); return; }

            tickets.forEach(t => {
                const cb = canBulk ?
                    `<td><input type="checkbox" class="form-check-input cb" value="${t.ticketId}" onchange="toggle(${t.ticketId})" /></td>` : '';

                const overdue = t.isOverdue ? '<span class="overdue-tag">OVERDUE</span>' : '';
                const statusClass = `status-${t.status.toLowerCase().replace(/\s/g, '')}`;
                const priorityClass = `priority-${t.priority.toLowerCase()}`;

                tbody.append(`
                    <tr class="ticket-row" data-id="${t.ticketId}">
                        ${cb}
                        <td><span class="ticket-num">${t.ticketNumber}</span></td>
                        <td>
                            <a href="/Ticket/Details/${t.ticketId}" class="text-decoration-none fw-semibold text-dark">
                                ${escapeHtml(t.title)}
                            </a>
                            ${overdue}
                            <div class="small text-muted">
                                ${t.commentCount > 0 ? `<i class="bi bi-chat"></i> ${t.commentCount} ` : ''}
                                ${t.attachmentCount > 0 ? `<i class="bi bi-paperclip"></i> ${t.attachmentCount}` : ''}
                            </div>
                        </td>
                        <td><span class="badge bg-light text-dark">${t.ticketType}</span></td>
                        <td><span class="priority-pill ${priorityClass}">
                            <i class="bi bi-circle-fill"></i>${t.priority}
                        </span></td>
                        <td><span class="status-badge ${statusClass}">${t.status}</span></td>
                        <td>${t.assignedToName ? `<small><i class="bi bi-person-circle"></i> ${escapeHtml(t.assignedToName)}</small>` : '<small class="text-muted">Unassigned</small>'}</td>
                        <td><small class="text-muted">${formatDate(t.createdDate)}</small></td>
                        <td class="text-center">
                            <a href="/Ticket/Details/${t.ticketId}" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                `);
            });
        }

        function showEmpty() {
            $('#tableBody').html(`
                <tr><td colspan="9" class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted opacity-50"></i>
                    <h5 class="mt-3 text-muted">No tickets found</h5>
                </td></tr>
            `);
        }

        function toggleAll(cb) {
            $('.cb').prop('checked', cb.checked).trigger('change');
        }

        function toggle(id) {
            if (selected.has(id)) selected.delete(id);
            else selected.add(id);
            updateBulkBar();
        }

        function updateBulkBar() {
            const count = selected.size;
            $('#selectedCount').text(count);
            $('#bulkBar').toggleClass('show', count > 0);
        }

        function clearSelection() {
            selected.clear();
            $('.cb').prop('checked', false);
            updateBulkBar();
        }

        async function bulkStatusChange() {
            const status = prompt('Enter new status:');
            if (!status) return;
            const remarks = prompt('Remarks:') || '';
            const token = $('input[name="__RequestVerificationToken"]').val();

            const fd = new FormData();
            Array.from(selected).forEach(id => fd.append('ticketIds', id));
            fd.append('newStatus', status);
            fd.append('remarks', remarks);
            fd.append('__RequestVerificationToken', token);

            const res = await fetch('/Ticket/BulkStatusChange', {
                method: 'POST', body: fd,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            const result = await res.json();
            alert(result.message);
            if (result.success) location.reload();
        }

        async function bulkAssign() {
            const userId = prompt('User ID to assign:');
            if (!userId) return;
            const token = $('input[name="__RequestVerificationToken"]').val();

            const fd = new FormData();
            Array.from(selected).forEach(id => fd.append('ticketIds', id));
            fd.append('assignedTo', userId);
            fd.append('__RequestVerificationToken', token);

            const res = await fetch('/Ticket/BulkAssign', {
                method: 'POST', body: fd,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            const result = await res.json();
            alert(result.message);
            if (result.success) location.reload();
        }

        function renderPagination(data) {
            const total = data.totalRecords || 0;
            const size = data.pageSize || 20;
            const current = data.pageNumber || 1;
            const pages = Math.ceil(total / size);
            if (pages <= 1) return;

            let html = '<ul class="pagination pagination-sm mb-0">';
            for (let i = 1; i <= Math.min(pages, 10); i++) {
                html += `<li class="page-item ${i === current ? 'active' : ''}">
                    <a class="page-link" href="?pageNumber=${i}">${i}</a>
                </li>`;
            }
            html += '</ul>';
            $('#pagination').html(html);
        }

        function formatDate(d) {
            if (!d) return '';
            return new Date(d).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
        }

        function escapeHtml(t) {
            if (!t) return '';
            const div = document.createElement('div');
            div.textContent = t;
            return div.innerHTML;
        }
    </script>
}