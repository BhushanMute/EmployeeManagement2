@model EmployeeManagement.UI.ViewModels.StudentViewModel

@{
    ViewData["Title"] = "Student Details";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">

            <!-- Header Section -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-1">Student Profile</h2>
                    <p class="text-muted mb-0">Complete student information and details</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Back to List
                </a>
            </div>

            <!-- Main Card -->
            <div class="card border-0 shadow-lg">

                <!-- Profile Header -->
                <div class="card-header bg-gradient-primary text-white border-0 py-4">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            @if (!string.IsNullOrEmpty(Model.PassportPhotoPath))
                            {
                                <img src="@Model.PassportPhotoPath"
                                     class="rounded-circle border border-4 border-white shadow"
                                     style="width:120px;height:120px;object-fit:cover;"
                                     alt="@Model.FullName" />
                            }
                            else
                            {
                                <div class="rounded-circle border border-4 border-white shadow d-flex align-items-center justify-content-center bg-white text-primary fw-bold"
                                     style="width:120px;height:120px;font-size:48px;">
                                    @Model.FullName?.Substring(0, 1).ToUpper()
                                </div>
                            }
                        </div>
                        <div class="col">
                            <h3 class="mb-1 fw-bold">@Model.FullName</h3>
                            <p class="mb-2 opacity-90">
                                <i class="bi bi-mortarboard-fill me-2"></i>@Model.Class
                            </p>
                            <span class="badge bg-light text-primary px-3 py-2">
                                ID: @Model.StudentId
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Profile Body -->
                <div class="card-body p-4">

                    <!-- Academic Information -->
                    <div class="mb-4">
                        <h5 class="text-primary mb-3 pb-2 border-bottom">
                            <i class="bi bi-book me-2"></i>Academic Information
                        </h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="info-card p-3 rounded bg-light">
                                    <small class="text-muted d-block mb-1">Class</small>
                                    <strong class="fs-6">@Model.Class</strong>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-card p-3 rounded bg-light">
                                    <small class="text-muted d-block mb-1">Batch Time</small>
                                    <strong class="fs-6">
                                        <i class="bi bi-clock text-primary me-1"></i>@Model.BatchTime
                                    </strong>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="info-card p-3 rounded bg-light">
                                    <small class="text-muted d-block mb-2">Subjects</small>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var subject in Model.Subjects?.Split(',') ?? Array.Empty<string>())
                                        {
                                            <span class="badge bg-primary-subtle text-primary px-3 py-2">
                                                @subject.Trim()
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Personal Information -->
                    <div class="mb-4">
                        <h5 class="text-primary mb-3 pb-2 border-bottom">
                            <i class="bi bi-person me-2"></i>Personal Information
                        </h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="d-flex align-items-center p-3 rounded bg-light">
                                    <div class="icon-box bg-primary bg-opacity-10 text-primary rounded p-2 me-3">
                                        <i class="bi bi-calendar3"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Age</small>
                                        <strong>@Model.Age years</strong>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-center p-3 rounded bg-light">
                                    <div class="icon-box bg-success bg-opacity-10 text-success rounded p-2 me-3">
                                        <i class="bi bi-calendar-check"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Joining Date</small>
                                        <strong>@Model.JoiningDate.ToString("MMM dd, yyyy")</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Contact Information -->
                    <div>
                        <h5 class="text-primary mb-3 pb-2 border-bottom">
                            <i class="bi bi-telephone me-2"></i>Contact Information
                        </h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="d-flex align-items-center p-3 rounded bg-light">
                                    <div class="icon-box bg-info bg-opacity-10 text-info rounded p-2 me-3">
                                        <i class="bi bi-envelope-fill"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <small class="text-muted d-block">Email Address</small>
                                        <strong class="text-break">@Model.Email</strong>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-center p-3 rounded bg-light">
                                    <div class="icon-box bg-warning bg-opacity-10 text-warning rounded p-2 me-3">
                                        <i class="bi bi-phone-fill"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Phone Number</small>
                                        <strong>@Model.PhoneNumber</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Card Footer -->
                <div class="card-footer bg-light border-0 py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-arrow-left me-2"></i>Back to List
                        </a>
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.StudentId" class="btn btn-primary px-4 me-2">
                                <i class="bi bi-pencil-square me-2"></i>Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.StudentId" class="btn btn-danger px-4">
                                <i class="bi bi-trash me-2"></i>Delete
                            </a>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .info-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .info-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

    .icon-box {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .card {
        border-radius: 15px;
        overflow: hidden;
    }

    .badge {
        font-weight: 500;
        font-size: 0.85rem;
    }

    .shadow-lg {
        box-shadow: 0 10px 30px rgba(0,0,0,0.1) !important;
    }
</style>