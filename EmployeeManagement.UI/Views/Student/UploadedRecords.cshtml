@model List<EmployeeManagement.UI.ViewModels.StudentViewModel>
@{
    ViewData["Title"] = "Upload Results";
    var successCount = ViewBag.SuccessCount ?? 0;
    var failedCount = ViewBag.FailedCount ?? 0;
    var totalRecords = ViewBag.TotalRecords ?? 0;
    var errors = ViewBag.Errors as List<string> ?? new List<string>();
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <!-- Summary -->
            <div class="card shadow mb-4">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0"><i class="fas fa-check-circle"></i> Excel Upload Results</h4>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h5 class="card-title">Total Records</h5>
                                    <h2 class="text-primary">@totalRecords</h2>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h5 class="card-title">Successfully Imported</h5>
                                    <h2 class="text-success">@successCount</h2>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h5 class="card-title">Failed</h5>
                                    <h2 class="text-danger">@failedCount</h2>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (errors.Any())
                    {
                        <div class="alert alert-warning mt-3">
                            <h5><i class="fas fa-exclamation-triangle"></i> Errors/Warnings:</h5>
                            <ul>
                                @foreach (var error in errors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="mt-3 text-center">
                        <a asp-action="Index" class="btn btn-primary">
                            <i class="fas fa-list"></i> View All Students
                        </a>
                       
                            <a class="nav-link" href="/Student/UploadExcel">
                                <i class="fas fa-file-excel me-1"></i>Upload Excel
                            </a>
                         
                    </div>
                </div>
            </div>

            <!-- Inserted Records -->
            @if (Model != null && Model.Any())
            {
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0"><i class="fas fa-users"></i> Successfully Inserted Students (@successCount)</h4>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>#</th>
                                        <th>Photo</th>
                                        <th>Student ID</th>
                                        <th>Full Name</th>
                                        <th>Class</th>
                                        <th>Subjects</th>
                                        <th>Age</th>
                                        <th>Joining Date</th>
                                        <th>Batch Time</th>
                                        <th>Phone</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var index = 1;
                                    }
                                    @foreach (var student in Model)
                                    {
                                        <tr>
                                            <td>@index</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(student.PassportPhotoPath))
                                                {
                                                    <img src="@student.PassportPhotoPath" alt="Photo"
                                                         class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <div class="rounded-circle bg-secondary d-inline-flex justify-content-center align-items-center"
                                                         style="width: 40px; height: 40px;">
                                                        <i class="fas fa-user text-white"></i>
                                                    </div>
                                                }
                                            </td>
                                            <td><strong class="text-primary">@student.StudentId</strong></td>
                                            <td>@student.FullName</td>
                                            <td><span class="badge bg-primary">@student.Class</span></td>
                                            <td><small>@student.Subjects</small></td>
                                            <td>@student.Age</td>
                                            <td>@student.JoiningDate.ToString("yyyy-MM-dd")</td>
                                            <td>@student.BatchTime</td>
                                            <td>@student.PhoneNumber</td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-info" title="View">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-warning" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                        index++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-scroll to errors if they exist
        @if (errors.Any())
        {
                <text>
                window.addEventListener('load', function() {
                    document.querySelector('.alert-warning')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                });
                </text>
        }
    </script>
}